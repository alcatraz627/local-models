#!/usr/bin/env bash
# gemini — the gemini lane of the model-tier harness, behind one stable wrapper.
#
# Claude (and you) never call the `gemini` binary directly — always this wrapper
# (rules/model-tier-routing.md). That isolation is the point: the backend today is
# the deprecated Homebrew gemini-cli (EOL 2026-12-18); swapping to Antigravity/ACP
# later changes this file only, no caller anywhere. Front door: `lm gemini …`.
#
# Auth is a paid API key (~/.gemini/.env), NOT consumer OAuth — load-bearing:
# Google shut down the hosted consumer-OAuth CLI service on 2026-06-18; the
# open-source CLI on an API key is the surviving path (switched here 2026-07-07).
# Do not "simplify" auth back to OAuth.
#
#   lm gemini "prompt"                one-shot (stdin becomes context: cat doc | lm gemini "sum it")
#   lm gemini ingest <files...>       feed a corpus into this project's session
#   lm gemini ask "question"          query the session (project-scoped by default)
#   lm gemini digest <dir|files...>   one-shot corpus digest → JSON claims, each grep-verified
#   lm gemini research "question"     web-shaped lookup → JSON, null-when-unsure, long timeout
#   lm gemini history [N] · show N    past calls (gem-history.jsonl, q-style numbering)
#
# Contract: default model is the newest Flash, gemini-4-argon is the opt-in pick (user
# decision; Pro models excluded); read-only posture (--approval-mode plan: gemini can generate text,
# never edit/execute here); auth/tier failures are a STRUCTURED gemini_unavailable
# error the calling agent must FLAG to the user before falling back to claude/lm.
set -eo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$DIR/config.sh" 2>/dev/null || true
# shellcheck source=/dev/null
source "$DIR/bin/_lib.sh"
wants_all "$@" && HELP_ALL=true
lm_identify

GEMINI_MODEL="${GEMINI_MODEL:-gemini-3.8-flash}"
GEMINI_MODELS="${GEMINI_MODELS:-gemini-3.8-flash gemini-4-argon}"
GEMINI_DEFAULT="$GEMINI_MODEL"   # the config/env default, before any -m override — shown in the bad-model error
LOG="$DIR/logs/gem-history.jsonl"
SESS_DIR="$DIR/logs/gemini-sessions"
# Timeout is workload-aware and set AFTER the verb is known (agentic web lookups
# and corpus digests run minutes; the old flat 180s killed 8 of the first 13
# real-workload calls). --timeout still wins over everything.
MODE=text; TIMEOUT=""; SESSION=""; FILE_ARG=""; FALLBACK_LOCAL=false; GLOW=false; QUIET=false; SERVED=""
TRANSPORT_PICK=auto; TRANSPORT=cli
GEMINI_DIRECT_BYTES="${GEMINI_DIRECT_BYTES:-200000}"

# The API key lives OUT of the global shell env: ~/.gemini/.env (chmod 600),
# loaded here per-call so only this wrapper's process tree ever sees it. A key
# already in the environment wins (one-off overrides stay possible).
if [ -z "${GEMINI_API_KEY:-}" ] && [ -f "$HOME/.gemini/.env" ]; then
  set -a; # shellcheck source=/dev/null
  source "$HOME/.gemini/.env"; set +a
fi

show_help() {
  printf '%s%slm gemini%s %s— the cloud lane (Google): huge context and web research. Your text leaves this Mac%s\n' "$Bd" "$C" "$Rs" "$Dm" "$Rs"
  _sec USAGE
  _cmd 'lm gemini "prompt"'          'one-shot; piped stdin becomes context'
  _cmd 'lm gemini --file doc "prompt"' 'same, with a file as the context (no cat needed)'
  _cmd 'lm gemini research "question"'   'web-shaped lookup, JSON with null-when-unsure; long default timeout'
  _cmd 'lm gemini ingest-repo [dir]' 'pack a whole repo (gitignore-aware) and load it into this project'"'"'s session'
  _cmd 'lm gemini ask "question"'    'ask the loaded session (other projects: --session NAME)'
  _cmd 'lm gemini history, show N'   'past calls, numbered (-1 = latest)'
  _more
  _cmd 'lm gemini "... @img.png"'    'vision: @path attaches an image (relative to CWD)'
  _cmd 'lm gemini ingest <files...>' "feed files into this project's persistent session"
  _cmd 'lm gemini digest <dir|files...>' 'one-shot corpus digest -> JSON {claims[],summary}, each claim grep-verified against the corpus'
  _cmd 'lm gemini models'            'list the model pick-list and which is the default'
  _cmd 'lm gemini watch [N]'         'follow a call running in another terminal: tools it uses, the answer as it arrives (N = older calls)'
  _sec OPTIONS
  _opt '--file FILE'    'one-shot only: use this file as the context, like cat FILE | lm gemini'
  _opt '-m, --model M'  'gemini model for this call (default: $GEMINI_MODEL; run `lm gemini models` to list, set the default in config.sh)'
  _opt '--json'         'machine mode: {ok, text, model, ms, session} on stdout'
  _opt '--session NAME' 'explicit session (default: the project dir name; sessions are per-project)'
  _opt '--timeout N'    'wall-clock cap in seconds (defaults: oneshot/ask 300 · ingest/digest/research 420; one auto-retry at 1.5x on timeout)'
  _opt '--fallback-local' 'if gemini is unavailable, answer via the local big tier (q -m big) instead of failing; reply is marked local'
  _opt '--glow'         'render the answer as markdown through glow (also works on show N)'
  _opt '--quiet'        'hide the live step lines a terminal shows on stderr while the call runs'
  _opt '--direct | --cli' "force the transport: the API directly, or gemini-cli (default: direct when piped context is over $GEMINI_DIRECT_BYTES bytes, one-shot/digest only; the direct route has no tools or @image)"
  _sec NOTES
  _note "model $GEMINI_MODEL (override -m, list: lm gemini models) · read-only (--approval-mode plan) · never call the gemini binary directly. If unavailable (auth/tier): a structured gemini_unavailable error, so flag it and fall back to claude or lm."
  _help_end 'lm gemini -h'
}

# Millisecond clock (bash 3.2 has no EPOCHREALTIME; date +%s is whole seconds).
now_ms() { python3 -c 'import time; print(int(time.time()*1000))'; }
T0_MS=""   # set when the backend call starts, so an error row can carry its real duration

emit_error() { # CODE MESSAGE EXIT
  if [ "$MODE" = json ]; then lm_err_json "$1" "$2"
  else echo "lm gemini: $2" >&2; lm_fix_line "$1"; fi
  # Keep the reason, not just the code, and how long the (possibly paid) call ran.
  # Usage mistakes (exit 2) never reached the backend, so they stay out of history.
  [ "$3" = 2 ] || log_line "error" "$1: $2" "$([ -n "$T0_MS" ] && echo $(( $(now_ms) - T0_MS )) || echo 0)" || true
  exit "$3"
}

# History is the API (mirrors q): successes AND failures, one JSONL line each.
# bytes_in/bytes_out make quota burn derivable from the history alone (tokens
# are roughly bytes/4 for this workload) — the routing rule's budget question
# was previously unanswerable without Google's console.
log_line() { # KIND TEXT_OR_CODE MS
  mkdir -p "$DIR/logs"
  jq -cn --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg kind "$1" --arg sess "${SESSION:-}" \
    --arg model "$GEMINI_MODEL" --arg prompt "${PROMPT:-}" --arg r "$2" --argjson ms "${3:-0}" \
    --argjson bin "$(( ${#PROMPT} + ${#CTX} ))" --argjson bout "${#2}" \
    --arg tty "$LM_TTY" --arg sess "$LM_SESSION" \
    '{ts:$ts, kind:$kind, session:(if $sess == "" then null else $sess end),
      model:$model, prompt:$prompt, response:$r, ms:$ms, bytes_in:$bin, bytes_out:$bout}
     + (if $served != "" then {served:$served} else {} end)
     + (if $stream != "" then {stream:$stream} else {} end)
     + {transport:$transport} + '"$JQ_WHO" --arg served "${SERVED:-}" --arg stream "${STREAM:-}" --arg transport "${TRANSPORT:-cli}" >> "$LOG" 2>/dev/null
}

# Run the backend with a hard wall-clock cap (kills the whole process group —
# gemini-cli can hang on interactive prompts it wasn't told to skip).
run_gemini() { # extra args...; PROMPT in $PROMPT; stdin passes through
  if [ "$TRANSPORT" = direct ]; then
    timeout -k 5 "$TIMEOUT" python3 "$DIR/lib/gemini-direct.py" "$GEMINI_MODEL" "$PROMPT"
    return
  fi
  perl -e '
    my $t = shift @ARGV;
    my $p = fork;
    if ($p == 0) { setpgrp(0,0); exec(@ARGV) or exit 127 }
    local $SIG{ALRM} = sub { kill "KILL", -$p; exit 124 };
    alarm $t; waitpid($p, 0); exit($? >> 8);
  ' "$TIMEOUT" gemini -m "$GEMINI_MODEL" --skip-trust --approval-mode plan -o stream-json "$@" -p "$PROMPT"
}

# Every call writes its event stream to logs/gemini-live/<time>-<pid>.jsonl as it
# runs, so `lm gemini watch` can follow it from another terminal, and the answer
# and stats are read back from it afterwards. The newest 30 are kept.
STREAM_DIR="$DIR/logs/gemini-live"
STREAM_PY="$DIR/lib/gemini-stream.py"
new_stream_file() {
  mkdir -p "$STREAM_DIR"
  STREAM="$STREAM_DIR/$(date -u +%Y%m%dT%H%M%SZ)-$$.jsonl"
  : > "$STREAM"
  ls -t "$STREAM_DIR"/*.jsonl 2>/dev/null | tail -n +31 | while IFS= read -r old; do rm -f "$old"; done
}

# ── Parse ──
positionals=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help|help) show_help; exit 0 ;;
    --json)      MODE=json; shift ;;
    --)          shift; positionals+=("$@"); break ;;
    --session)   need_arg "lm gemini" "$1" "${2:-}"; SESSION="$2"; shift 2 ;;
    --timeout)   need_arg "lm gemini" "$1" "${2:-}"; TIMEOUT="$2"; shift 2 ;;
    --file)      need_arg "lm gemini" "$1" "${2:-}"; FILE_ARG="$(expand_tilde "$2")"; shift 2 ;;
    --all)       LM_ENTRY_SCOPE=all; shift ;;
    --fallback-local) FALLBACK_LOCAL=true; shift ;;
    --glow)      GLOW=true; shift ;;
    --quiet)     QUIET=true; shift ;;
    --direct)    TRANSPORT_PICK=direct; shift ;;
    --cli)       TRANSPORT_PICK=cli; shift ;;
    -m|--model)  need_arg "lm gemini" "$1" "${2:-}"; GEMINI_MODEL="$2"; shift 2 ;;
    *)           reject_unknown_flag "lm gemini" "$1"; positionals+=("$1"); shift ;;
  esac
done
[ -z "$TIMEOUT" ] || [[ "$TIMEOUT" =~ ^[0-9]+$ ]] || emit_error invalid_args "--timeout must be seconds, got '$TIMEOUT'" 2

CMD="${positionals[0]:-}"
case "$CMD" in
  history) if [ "$MODE" = json ]; then jsonl_history_json "$LOG" "${positionals[1]:-15}"; exit 0; fi
           jsonl_history "$LOG" "${positionals[1]:-15}" \
             "$JQ_LOCAL_TS"'"\(.ts | lts)  \(.kind)  \(.ms)ms  \((.prompt // "") | gsub("\\s+"; " ") | .[0:50])"'; exit 0 ;;
  show)    SHOWN="$(jsonl_entry "$LOG" "${positionals[1]:-}" \
             '"# lm gemini \(.kind)  ·  \(.ts)  ·  \(.model)\(if .served and .served != .model then " (served by " + .served + ")" else "" end)\(if .session then "  ·  session: " + .session else "" end)\n\n\(.response)\(if .stream then "\n\nsteps: lm gemini watch, or python3 '"$DIR"'/lib/gemini-stream.py render " + .stream else "" end)"')" || exit $?
           if $GLOW && [ -t 1 ] && command -v glow >/dev/null 2>&1; then printf '%s\n' "$SHOWN" | glow -; else printf '%s\n' "$SHOWN"; fi
           exit 0 ;;
  watch)   # newest call by default; `watch 2` = the one before it
           [[ "${positionals[1]:-1}" =~ ^[0-9]+$ ]] || emit_error invalid_args "watch N: N is a number (1 = newest)" 2
           W="$(ls -t "$STREAM_DIR"/*.jsonl 2>/dev/null | sed -n "${positionals[1]:-1}p")"
           [ -n "$W" ] || { echo "lm gemini: no calls recorded yet in $STREAM_DIR (calls started before this feature are not watchable)" >&2; exit 12; }
           WPID="$(basename "$W" .jsonl)"; WPID="${WPID##*-}"
           if use_color_fd 2; then _dm=$'\033[2m'; _rs=$'\033[0m'; else _dm=""; _rs=""; fi
           printf '%s· following %s%s\n' "$_dm" "$(basename "$W")" "$_rs" >&2
           exec python3 "$STREAM_PY" follow "$W" "$WPID" ;;
  models)  if [ "$MODE" = json ]; then
             jq -cn --arg d "$GEMINI_DEFAULT" --arg l "$GEMINI_MODELS" '{ok:true, default:$d, models:($l|split(" "))}'
           else
             printf 'gemini models (* = default):\n'
             for _gm in $GEMINI_MODELS; do
               [ "$_gm" = "$GEMINI_DEFAULT" ] && printf '  %s* %s%s\n' "$C" "$_gm" "$Rs" || printf '    %s\n' "$_gm"
             done
             printf '%spick per call: lm gemini -m <model> · set the default: GEMINI_MODEL in config.sh · extend the list: GEMINI_MODELS%s\n' "$Dm" "$Rs"
           fi
           exit 0 ;;
  "")      [ "$MODE" = json ] && emit_error invalid_args "give a prompt, or a subcommand such as ask or models (lm gemini -h)" 2
           show_help; exit 0 ;;
esac

# Validate the model against the pick-list EARLY — a typo errors here instead of
# burning a gemini call. Extend GEMINI_MODELS in config.sh for a model your install has.
case " $GEMINI_MODELS " in
  *" $GEMINI_MODEL "*) : ;;
  *) emit_error bad_model "unknown gemini model '$GEMINI_MODEL' — pick one of: $GEMINI_MODELS (default: $GEMINI_DEFAULT). Add it to GEMINI_MODELS in config.sh if your gemini-cli supports it." 2 ;;
esac

command -v gemini >/dev/null 2>&1 \
  || emit_error gemini_unavailable "gemini CLI not installed (brew install gemini-cli) — FLAG this to the user; fall back to claude/lm" 11

# Sessions are per-project by default (user decision); cross-project reference is
# manual — pass --session NAME to point at another project's session. gemini-cli
# semantics (probed 2026-07-07): --session-id CREATES (errors if it exists),
# -r <uuid> RESUMES — so we keep one UUID per session name and pick the verb.
[ -n "$SESSION" ] || SESSION="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
mkdir -p "$SESS_DIR"
ID_FILE="$SESS_DIR/$SESSION.id"

case "$CMD" in
  ingest)
    files=("${positionals[@]:1}")
    [ "${#files[@]}" -gt 0 ] || emit_error invalid_args "ingest needs files: lm gemini ingest <files...>" 2
    for f in "${files[@]}"; do [ -f "$f" ] || emit_error item_missing "no such file: $f" 12; done
    PROMPT="Ingest the following files as project context for later questions. The full content is provided inline — do NOT read files or use any tools; paths/URLs mentioned in the content are references, not files to open. Do not quote or repeat the provided content. Reply ONLY with a numbered digest (max 8 lines) of what you now know."
    CTX="$(for f in "${files[@]}"; do printf '=== %s ===\n' "$f"; cat "$f"; printf '\n'; done)"
    KIND=ingest
    ;;
  ingest-repo)
    # Repo-scale ingestion: repomix packs the tree (gitignore-aware, tree-sitter
    # --compress ≈ -70% tokens) so "load this repo, ask it questions" is one verb
    # instead of a hand-rolled cat loop. The pack is temp — the session keeps it.
    command -v repomix >/dev/null 2>&1 || emit_error repomix_missing "repomix not installed — npm install -g repomix" 12
    REPO_DIR="${positionals[1]:-.}"
    [ -d "$REPO_DIR" ] || emit_error item_missing "no such directory: $REPO_DIR" 12
    PACK="$(mktemp "${TMPDIR:-/tmp}/gem-repo.XXXXXX.md")"
    # Generated artifacts (styled HTML reports, images, archived outputs) bloat
    # the pack and made flash echo instead of digest — code + docs only.
    repomix --output "$PACK" --style markdown --compress --quiet \
      --ignore ".claude/output/**,outputs/**,**/*.html,**/*.png,**/*.jpg,**/*.svg,repomix-output.*" \
      "$REPO_DIR" >/dev/null 2>&1 \
      || emit_error repomix_failed "repomix could not pack $REPO_DIR" 10
    [ -s "$PACK" ] || emit_error repomix_failed "repomix produced an empty pack for $REPO_DIR" 10
    PROMPT="Ingest this packed repository (repomix format: file tree + per-file contents, comments/whitespace compressed) as project context for later questions. The full pack is provided inline — do NOT read files or use any tools; paths/URLs inside the pack are references, not files to open. Do not quote or repeat the pack content. Reply ONLY with a numbered digest (max 10 lines): what the repo is, its main components, and anything unusual."
    CTX="$(cat "$PACK")"
    rm -f "$PACK" 2>/dev/null || true
    KIND=ingest
    ;;
  ask)
    PROMPT="${positionals[*]:1}"
    [ -n "$PROMPT" ] || emit_error invalid_args 'ask needs a question: lm gemini ask "..."' 2
    CTX=""; KIND=ask
    ;;
  digest)
    # One-shot corpus digest with a machine contract: JSON claims, each carrying
    # a short verbatim quote. The quotes are what make the output checkable —
    # after the reply, every quote is grepped back against the corpus and the
    # verdict ships WITH the digest ("the wrapper guarantees structure, not
    # truth" gets a mechanism instead of a comment).
    targets=("${positionals[@]:1}")
    [ "${#targets[@]}" -gt 0 ] || emit_error invalid_args "digest needs a dir or files: lm gemini digest <dir|files...>" 2
    DIGEST_CORPUS="$(mktemp "${TMPDIR:-/tmp}/gem-digest.XXXXXX.md")"
    if [ -d "${targets[0]}" ] && [ "${#targets[@]}" -eq 1 ]; then
      command -v repomix >/dev/null 2>&1 || emit_error repomix_missing "repomix not installed — npm install -g repomix" 12
      repomix --output "$DIGEST_CORPUS" --style markdown --compress --quiet \
        --ignore ".claude/output/**,outputs/**,**/*.html,**/*.png,**/*.jpg,**/*.svg,repomix-output.*" \
        "${targets[0]}" >/dev/null 2>&1 || emit_error repomix_failed "repomix could not pack ${targets[0]}" 10
    else
      for f in "${targets[@]}"; do [ -f "$f" ] || emit_error item_missing "no such file: $f" 12; done
      for f in "${targets[@]}"; do printf '=== %s ===\n' "$f"; cat "$f"; printf '\n'; done > "$DIGEST_CORPUS"
    fi
    [ -s "$DIGEST_CORPUS" ] || emit_error item_missing "corpus is empty" 12
    PROMPT='Digest the corpus provided inline. Do NOT read files or use tools. Reply ONLY with JSON, no prose, no code fence: {"claims":[{"claim":"one factual statement about the corpus","quote":"a SHORT verbatim quote (5-15 words) from the corpus that supports it"}],"summary":"3 sentences max"}. At most 12 claims. Every quote must be copied exactly from the corpus.'
    CTX="$(cat "$DIGEST_CORPUS")"
    KIND=digest; SESS_ARGS=()
    ;;
  research)
    # Web-shaped lookup: inherently slow and variable (agentic browsing), so it
    # gets the long default timeout, and the null-when-unsure contract that the
    # studio-search prompts used to carry by hand.
    PROMPT_Q="${positionals[*]:1}"
    [ -n "$PROMPT_Q" ] || emit_error invalid_args 'research needs a question: lm gemini research "..."' 2
    PROMPT="Research this question, using web search where available: $PROMPT_Q
Reply ONLY with JSON, no prose, no code fence: {\"answers\":[{\"item\":\"...\",\"value\":\"... or null\",\"source\":\"URL or null\"}],\"unsure\":\"anything you could not establish\"}. Use null for anything not verified — never guess."
    CTX=""; KIND=research; SESS_ARGS=()
    ;;
  *)
    PROMPT="${positionals[*]}"
    CTX=""
    if [ -n "$FILE_ARG" ]; then
      [ -f "$FILE_ARG" ] || emit_error item_missing "no such file: $FILE_ARG" 12
      CTX="$(cat "$FILE_ARG")"
    elif [ ! -t 0 ]; then CTX="$(cat)"; fi
    KIND=oneshot; SESS_ARGS=()
    ;;
esac
[ -z "$FILE_ARG" ] || [ "$KIND" = oneshot ] || emit_error invalid_args "--file works with a one-shot prompt (lm gemini --file doc \"question\"); $KIND already takes its own files" 2
# Workload-aware default caps (explicit --timeout always wins).
if [ -z "$TIMEOUT" ]; then
  case "$KIND" in ingest|digest|research) TIMEOUT=420 ;; *) TIMEOUT=300 ;; esac
fi
case "$KIND" in oneshot|digest|research) SESSIONLESS=true ;; *) SESSIONLESS=false ;; esac
# Transport: the direct API has no session and no tools, so only one-shot and
# digest calls can use it; research needs gemini-cli's web search.
case "$KIND" in
  oneshot|digest)
    if [ "$TRANSPORT_PICK" = direct ] || { [ "$TRANSPORT_PICK" = auto ] && [ "${#CTX}" -ge "$GEMINI_DIRECT_BYTES" ]; }; then
      TRANSPORT=direct
    fi ;;
  *) [ "$TRANSPORT_PICK" = direct ] && emit_error invalid_args "--direct works for one-shot and digest calls only ($KIND needs gemini-cli)" 2 ;;
esac
if [ "$SESSIONLESS" = false ]; then
  if [ -f "$ID_FILE" ]; then
    SESS_ARGS=(-r "$(cat "$ID_FILE")")
  else
    NEW_ID="$(uuidgen | tr 'A-Z' 'a-z')"
    printf '%s\n' "$NEW_ID" > "$ID_FILE"
    SESS_ARGS=(--session-id "$NEW_ID")
  fi
fi

# Live step lines go to stderr when a person is watching this terminal; agents and
# --json callers get the same quiet output as before.
LIVE=false
[ "$MODE" = text ] && ! $QUIET && [ -t 2 ] && LIVE=true

run_once() { # one backend attempt with the current SESS_ARGS; sets STREAM, OUT + rc
  new_stream_file
  set +e
  if $LIVE; then
    python3 "$STREAM_PY" follow "$STREAM" "$$" >&2 &
    RENDER_PID=$!
  fi
  if [ -n "$CTX" ]; then
    printf '%s' "$CTX" | run_gemini "${SESS_ARGS[@]}" > "$STREAM" 2>&1
  else
    run_gemini "${SESS_ARGS[@]}" </dev/null > "$STREAM" 2>&1
  fi
  rc=$?
  if $LIVE; then
    # The renderer stops on the result event; give it a moment to print it.
    for _ in 1 2 3 4 5 6 7 8; do kill -0 "$RENDER_PID" 2>/dev/null || break; sleep 0.25; done
    kill "$RENDER_PID" 2>/dev/null || true
    wait "$RENDER_PID" 2>/dev/null || true
  fi
  set -e
  OUT="$(cat "$STREAM")"
}

T0_MS=$(now_ms)
run_once
# Self-heal a vanished session. gemini-cli keeps its chat store under
# ~/.gemini/tmp/<project>/chats and cleans it on its own schedule, so our cached
# UUID can point at nothing — resume then errors instead of creating. Mint a
# fresh session and retry once. Continuity is lost (ingested context is gone),
# so the reset is surfaced, never silent.
SESSION_RESET=false
if [ "$rc" -ne 0 ] && [ "$SESSIONLESS" = false ] \
   && printf '%s' "$OUT" | grep -qi 'Searched for sessions\|--list-sessions'; then
  NEW_ID="$(uuidgen | tr 'A-Z' 'a-z')"
  printf '%s\n' "$NEW_ID" > "$ID_FILE"
  SESS_ARGS=(--session-id "$NEW_ID")
  SESSION_RESET=true
  run_once
fi
# One retry with headroom on a wall-clock kill. The recorded timeout clusters
# were all transient (the same prompt succeeded on a plain re-run minutes
# later), so the wrapper does the re-run instead of the human.
RETRIED=false
if [ "$rc" -eq 124 ]; then
  RETRIED=true
  sleep 5
  TIMEOUT=$(( TIMEOUT * 3 / 2 ))
  # The killed attempt may already have created its new session, and gemini-cli
  # refuses --session-id for one that exists; mint another (nothing finished, so
  # nothing ingested is lost).
  if [ "${SESS_ARGS[0]:-}" = --session-id ]; then
    NEW_ID="$(uuidgen | tr 'A-Z' 'a-z')"
    printf '%s\n' "$NEW_ID" > "$ID_FILE"
    SESS_ARGS=(--session-id "$NEW_ID")
  fi
  run_once
fi
ms=$(( $(now_ms) - T0_MS ))

if [ "$rc" -ne 0 ]; then
  # Auth/tier/login failures are the "unavailable" class the routing rule names;
  # everything else (incl. the 124 timeout kill) is a plain structured error.
  if printf '%s' "$OUT" | grep -qiE 'IneligibleTier|not eligible|auth|login|credential|quota|permission denied'; then
    # Opt-in degrade: answer on the local big tier rather than failing, for
    # callers that prefer a $0 offline answer over an error. The reply is
    # MARKED local — a silent swap would launder the trust posture.
    if [ "$FALLBACK_LOCAL" = true ] && [ -x "$DIR/bin/q" ]; then
      LTEXT="$( { [ -n "$CTX" ] && printf '%s' "$CTX"; } | "$DIR/bin/q" -m big --raw "$PROMPT" 2>/dev/null || true)"
      if [ -n "$LTEXT" ]; then
        log_line "fallback-local" "$LTEXT" "$ms"
        if [ "$MODE" = json ]; then
          jq -cn --arg t "$LTEXT" --arg lm "$(resolve_tier big)" '{ok:true, text:$t, model:$lm, fallback:"local", note:"gemini unavailable — answered by the local big tier; treat as a weaker seat"}'
        else
          printf 'lm gemini: note — gemini unavailable; answered by the LOCAL big tier (weaker seat)\n' >&2
          printf '%s\n' "$LTEXT"
        fi
        exit 0
      fi
    fi
    emit_error gemini_unavailable "gemini backend unavailable ($(printf '%s' "$OUT" | rg -io 'IneligibleTierError|not eligible[^.]*' | head -1 | cut -c1-80)) — FLAG this to the user; fall back to claude/lm (or re-run with --fallback-local). Fix: re-auth (gemini → /auth) or set GEMINI_API_KEY." 11
  fi
  [ "$rc" -eq 124 ] && emit_error timeout "exceeded ${TIMEOUT}s wall clock (after one auto-retry at 1.5x)" 13
  emit_error gemini_error "$(printf '%s' "$OUT" | tail -2 | tr '\n' ' ' | cut -c1-200)" 10
fi

# A call can exit 0 and still fail: gemini-cli ends some broken turns with an
# "[ERROR] Invalid stream" line and no answer. The stream's result event and the
# answer text decide, not the exit code.
META="$(python3 "$STREAM_PY" meta "$STREAM" 2>/dev/null || echo '{}')"
SERVED="$(printf '%s' "$META" | jq -r '(.served_by // []) | join(",")' 2>/dev/null || true)"
STATUS="$(printf '%s' "$META" | jq -r '.status // empty' 2>/dev/null || true)"
STREAM_TEXT="$(python3 "$STREAM_PY" text "$STREAM" 2>/dev/null || true)"
if [ "$(printf '%s' "$META" | jq -r '.events // 0' 2>/dev/null)" -gt 0 ]; then
  if [ -z "$STREAM_TEXT" ] || { [ -n "$STATUS" ] && [ "$STATUS" != success ]; }; then
    ERRLINE="$(rg -m1 -o '\[ERROR\].*|Error executing tool.*' "$STREAM" 2>/dev/null || true)"
    emit_error gemini_error "gemini ended without an answer (${STATUS:-no result}${ERRLINE:+: $ERRLINE}); the steps it took: python3 $STREAM_PY render $STREAM" 10
  fi
  OUT="$STREAM_TEXT"
fi

# gemini-cli leaks housekeeping lines onto stdout ("Ripgrep is not available…",
# "[STARTUP] Cannot measure phase…", node deprecation warnings, and "Error
# stating path …" when plan-mode gemini tries to read a file mentioned in the
# provided content — the read fails, the tool error leaks). Strip the known
# noise, keep the content as-is; consumers treat gemini content as untrusted
# input anyway (the wrapper guarantees structure, not truth).
TEXT="$(printf '%s' "$OUT" | sed -E '/^Ripgrep is not available/d; /^\[STARTUP\]/d; /^Error stating path /d; /^\(node:[0-9]+\) \[DEP[0-9]+\]/d; /^\(Use `node --trace-deprecation/d')"
# Ingest replies are contract-bound to a numbered digest, but on huge inline
# corpora flash sometimes echoes content before complying — keep from the LAST
# "1. " line onward (the digest), or everything if the model behaved.
if [ "$KIND" = ingest ]; then
  TEXT="$(printf '%s' "$TEXT" | awk '/^1\. /{n=NR} {l[NR]=$0} END{if(!n)n=1; for(i=n;i<=NR;i++) print l[i]}')"
fi
# Digest verification: grep every claimed quote back against the corpus. The
# verdict rides with the output; a digest where NO quote is findable is refused
# outright (fail closed, findings-gate style) — structure without truth.
if [ "$KIND" = digest ]; then
  JSONTEXT="$(printf '%s' "$TEXT" | sed -E 's/^```(json)?//; s/```$//' | jq -c . 2>/dev/null || true)"
  [ -n "$JSONTEXT" ] || { rm -f "$DIGEST_CORPUS"; emit_error digest_malformed "digest reply was not parseable JSON (lm gemini show -1 for the raw text)" 10; }
  hits=0; misses=0
  while IFS= read -r quote; do
    probe="$(printf '%s' "$quote" | tr -s '[:space:]' ' ' | cut -c1-60)"
    [ -n "$probe" ] || continue
    if tr -s '[:space:]' ' ' < "$DIGEST_CORPUS" | rg -qF "$probe"; then hits=$((hits+1)); else misses=$((misses+1)); fi
  done < <(printf '%s' "$JSONTEXT" | jq -r '.claims[].quote // empty')
  rm -f "$DIGEST_CORPUS" 2>/dev/null || true
  if [ "$hits" -eq 0 ] && [ "$misses" -gt 0 ]; then
    emit_error digest_unverified "none of the $misses claimed quotes exist in the corpus — digest refused" 10
  fi
  TEXT="$(printf '%s' "$JSONTEXT" | jq -c --argjson h "$hits" --argjson m "$misses" '. + {verified:{quotes_found:$h, quotes_missing:$m}}')"
fi
KSUF=""; [ "$SESSION_RESET" = true ] && KSUF="+reset"; [ "$RETRIED" = true ] && KSUF="$KSUF+retry"
log_line "$KIND$KSUF" "$TEXT" "$ms"
if [ "$MODE" = json ]; then
  jq -cn --arg t "$TEXT" --arg m "$GEMINI_MODEL" --argjson ms "$ms" \
    --arg s "$([ "$SESSIONLESS" = true ] && echo "" || echo "$SESSION")" \
    --argjson reset "$SESSION_RESET" \
    --arg served "$SERVED" --arg transport "$TRANSPORT" \
    '{ok:true, text:$t, model:$m, ms:$ms, session:(if $s == "" then null else $s end), transport:$transport}
     + (if $served != "" then {served:$served} else {} end)
     + (if $reset then {session_reset:true, note:"session store was cleaned externally — a fresh session was created; previously ingested context is gone (re-run ingest)"} else {} end)'
else
  [ "$SESSION_RESET" = true ] && printf 'lm gemini: note — the session store was cleaned externally; started a fresh session (ingested context is gone, re-run ingest)\n' >&2
  if $GLOW && [ -t 1 ] && command -v glow >/dev/null 2>&1; then
    printf '%s\n' "$TEXT" | glow - || printf '%s\n' "$TEXT"
  else
    printf '%s\n' "$TEXT"
  fi
  # Stats are TTY-only; the guard must not become the script's exit code — a
  # machine caller in text mode would see exit 1 on every success.
  if use_color_fd 2; then _dm=$'\033[2m'; _rs=$'\033[0m'; else _dm=""; _rs=""; fi
  [ -t 2 ] && printf '%s· %s%s · %dms%s · lm gemini show -1%s\n' "$_dm" "$GEMINI_MODEL" "$( [ -n "$SERVED" ] && [ "$SERVED" != "$GEMINI_MODEL" ] && printf ' (served by %s)' "$SERVED")" "$ms" "$( [ "$TRANSPORT" = direct ] && printf ' · direct API')" "$_rs" >&2
fi
exit 0
