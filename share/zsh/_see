#compdef see
# generated by scripts/gen-verbs.sh from lib/verbs.toml; do not edit

_lm_shots() {
  local dir="${SEE_SCREENSHOT_DIR:-$(defaults read com.apple.screencapture location 2>/dev/null)}"
  [[ -n $dir ]] || dir="$HOME/Desktop"
  dir="${~dir}"
  local -a shots
  shots=( ${dir}/Screen*.png(N.om[1,8]) )
  _alternative \
    'special:shortcut:((paste\:"the image on your clipboard" latest\:"your newest screenshot"))' \
    'shots:recent screenshot:{compadd -- "${shots[@]}"}' \
    'files:image file:_files -g "*.(png|jpg|jpeg|webp|gif|heic)"'
}

_see() {
  local -a subs
  subs=( 'paste:the image on your clipboard' 'latest:your newest screenshot' 'count:count objects by measuring pixels' 'odd:find the one item that differs' 'diff:what changed between two images' 'more:follow up on the last image' 'history:past reads' 'show:one full read' 'open:the artifact folder of a read' 'note:add a note to a read' 'reshoot:replay a loop recipe' )
  local -a opts
  opts=(
    '--ocr[EXACT text via Apple Vision (no model, ~instant); composes with --crop]'
    '--ui[UI-inventory read for screenshots/mocks]'
    '--no-measure[skip the exact-first step\: go straight to the model read]'
    '--menubar[screencapture the main-display top strip and --ui]'
    '--crop[read only this pixel window of the image (crop-then-read lifts recall)]:value:'
    '--region[named crop\: top|bottom (third) · left|right (half) · center (middle quarter)]:value:'
    '--only[diff only\: re-run just these extractors (E3/E4/E5/E6), return the delta]:value:'
    '--grid[diff only\: grid resolution 4-64 for E5/E6 (default 8 icons / 16 UIs)]:value:'
    '--no-read[diff only\: evidence pack and plain summary, no model read]'
    '--color[count only\: objects of this colour]:value:'
    '--filled-only[count only\: drop hollow outlines, keep solid shapes]'
    '--min-area[count/odd\: ignore blobs smaller than N pixels (default scales with image size)]:value:'
    '--json[one JSON object on stdout, no ANSI; with --ui adds parsed .data]'
    '--glow[render the read through glow (TTY-only, no-op without glow)]'
    '-m[vision model]:model:'
    '--model[vision model]:model:'
    '--mlx[route to the mlx-vlm backend outside ollama]'
    '--all[with more, open -1 or show -1\: include reads from other terminals]'
  )
  if (( CURRENT == 2 )); then
    _lm_shots
    _describe -t subs 'see subcommand' subs
    return
  fi
  _arguments -s $opts '*:image:_files -g "*.(png|jpg|jpeg|webp|gif|heic)"'
}
_see "$@"
