#compdef warm
# generated by scripts/gen-verbs.sh from lib/verbs.toml; do not edit

_warm() {
  local -a subs tiers
  subs=( 'on:load a model for a while' 'off:unload and free the memory' 'status:what is loaded' 'restart:off, then on' )
  tiers=( small big code sweep all forever 30m 1h 2h 4h )
  if (( CURRENT == 2 )); then
    _describe -t subs 'warm subcommand' subs
    return
  fi
  case $words[2] in
    on|off) _values 'tier or time' $tiers ;;
    status) _values 'option' '--json[machine view]' ;;
  esac
}
_warm "$@"
