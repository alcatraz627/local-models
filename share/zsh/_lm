#compdef lm
# generated by scripts/gen-verbs.sh from lib/verbs.toml; do not edit

_lm_shots() {
  local dir="${SEE_SCREENSHOT_DIR:-$(defaults read com.apple.screencapture location 2>/dev/null)}"
  [[ -n $dir ]] || dir="$HOME/Desktop"
  dir="${~dir}"
  local -a shots
  shots=( ${dir}/Screen*.png(N.om[1,8]) )
  _alternative \
    'special:shortcut:((paste\:"the image on your clipboard" latest\:"your newest screenshot"))' \
    'shots:recent screenshot:(${shots})' \
    'files:image file:_files -g "*.(png|jpg|jpeg|webp|gif|heic)"'
}

_lm() {
  local -a verbs
  verbs=( 'ask:a quick answer from the small local model' 'cmd:one shell command, checked before you run it' 'read:text or an answer out of an image' 'diff:what changed between two images' 'doc:ask about, or summarize, a file' 'again:the answer was wrong; ask the same thing on a stronger model' 'find:search the answers you got before' 'review:review code, a PR or your uncommitted changes' 'status:what is loaded and what is free' 'fast:keep answers instant' 'help:the steps for one job' 'more:every command, including the rarely used ones' 'how:find the command for what you want, without running it' 'gemini:the cloud lane\: huge documents and web research' 'fleet:ask one question of many independent files' 'rag:search exact text first, then by meaning' 'index:repo symbol map\: build once, ask where a name is defined' 'imagine:draw an image locally' 'probe:judge whether a local model is trustworthy' 'bench:run a fixed behavior and latency fixture set' 'ui-verify:check claims about a screenshot against a UI inventory' 'opencode:opencode on the local code model, leased for the session' 'timeline:your recent calls, newest last' 'last:your latest call, in full' 'models:installed models and which tier each is' 'doctor:health check of the whole toolkit' 'examples:a showcase of everything, grouped by job' 'q:quick local LLM companion\: answers, shell commands, commit messages, file Q&A' 'see:read an image into text with a local vision model (the image never leaves this Mac)' 'warm:keep a model loaded so q answers instantly, and say when it unloads' )
  if (( CURRENT == 2 )); then
    _describe -t verbs 'lm verb' verbs
    return
  fi
  case $words[2] in
    read) _lm_shots ;;
    diff) _arguments '*:image:_files -g "*.(png|jpg|jpeg|webp|gif|heic)"' ;;
    doc) _arguments '1:file:_files' ;;
    help) local -a topics; topics=( 'ask:a quick answer from the small local model' 'cmd:one shell command, checked before you run it' 'read:text or an answer out of an image' 'diff:what changed between two images' 'doc:ask about, or summarize, a file' 'again:the answer was wrong; ask the same thing on a stronger model' 'find:search the answers you got before' 'review:review code, a PR or your uncommitted changes' 'status:what is loaded and what is free' 'fast:keep answers instant' 'help:the steps for one job' 'more:every command, including the rarely used ones' 'how:find the command for what you want, without running it' 'count:count things in an image by measuring pixels' 'web:something current\: versions, news, docs' 'failed:work out why a call failed' 'json:an answer a script can read' 'table:exact rows, missing values, and numeric ranges' 'gemini:the cloud lane\: huge documents and web research' 'fleet:ask one question of many independent files' 'rag:search exact text first, then by meaning' 'index:repo symbol map\: build once, ask where a name is defined' 'imagine:draw an image locally' 'probe:judge whether a local model is trustworthy' 'bench:run a fixed behavior and latency fixture set' 'ui-verify:check claims about a screenshot against a UI inventory' 'opencode:opencode on the local code model, leased for the session' 'timeline:your recent calls, newest last' 'last:your latest call, in full' 'models:installed models and which tier each is' 'doctor:health check of the whole toolkit' 'examples:a showcase of everything, grouped by job' 'q:quick local LLM companion\: answers, shell commands, commit messages, file Q&A' 'see:read an image into text with a local vision model (the image never leaves this Mac)' 'warm:keep a model loaded so q answers instantly, and say when it unloads' ); _describe -t topics 'lm help topic' topics ;;
    again) _values 'lane' '--big[the bigger reasoning model]' '--code[the coding model]' '--web[search the web first (leaves this Mac)]' ;;
    fast) _values 'duration' off 30m 1h 2h 4h ;;
    status|models|doctor) _values 'option' '--json[machine-readable]' ;;
    timeline) _arguments '--errors[only failed calls]' '--all[include agents and hooks]' '--json[as JSON]' '--tool[one tool]:tool:(q see imagine fleet gemini)' ;;
    last) _values 'tool' q see imagine fleet gemini --all ;;
    q) words=( q "${(@)words[3,-1]}" ); (( CURRENT-=1 )); _q ;;
    see) words=( see "${(@)words[3,-1]}" ); (( CURRENT-=1 )); _see ;;
    warm) words=( warm "${(@)words[3,-1]}" ); (( CURRENT-=1 )); _warm ;;
    how) _arguments '--go[run the command it finds]' '--json[as JSON]' '--no-model[match by words only]' '*:what you want:' ;;
    *) _files ;;
  esac
}
_lm "$@"
