#!/usr/bin/env bash
# warm — keep a model loaded so q answers instantly, and say when it will unload.
#
#   warm on 1h              keep the small model (what q uses) loaded for an hour
#   warm on                 same, for the default 2 hours
#   warm on code [2h]       keep a bigger tier or any model loaded (default 60m)
#   warm off [code|all]     unload it now / a tier / everything
#   warm status             show what is loaded and when it unloads
#   warm restart            off, then on
#
# Nothing stays loaded by default: every pin is a lease that unloads itself.
# Say 'forever' (`warm on small forever`) to keep one until `warm off`.
# Residency is tracked by Ollama itself (ollama ps), not a state file here.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$DIR/config.sh"
# shellcheck source=/dev/null
source "$DIR/bin/_lib.sh"   # resolve_tier, OLLAMA_HOST
wants_all "$@" && HELP_ALL=true

DEFAULT_LEASE="60m"

# Load (or re-pin) MODEL with KEEP_ALIVE via an empty-prompt generate — a pure
# load, no tokens produced. keep_alive is last-writer-wins per request.
pin() { # MODEL KEEP_ALIVE(number or "duration")
  local ka="$2" out secs
  secs="$(ka_seconds "$ka" 2>/dev/null)" && [ -n "$secs" ] && ka="$secs"   # one form Ollama always reads (it has no 'd')
  [[ "$ka" =~ ^-?[0-9]+$ ]] || ka="\"$ka\""
  out="$(curl -s "$OLLAMA_HOST/api/generate" -d "{\"model\":\"$1\",\"keep_alive\":$ka}")" \
    || { echo "failed to reach Ollama at $OLLAMA_HOST" >&2; exit 10; }
  # Ollama answers a refusal (model not pulled, bad name) with HTTP 404 and an
  # error body, which curl -s still counts as success; read the body instead.
  if [[ "$out" == *'"error"'* ]]; then
    # A load the memory guard killed looks the same as a missing model from here,
    # so check its log before guessing.
    local guard="$DIR/logs/mem-guard.jsonl" since
    since="$(date -v-90S +%Y-%m-%dT%H:%M:%S)"
    if [ -f "$guard" ] && tail -n 20 "$guard" | jq -e --arg s "$since" 'select(.action=="kill" and .ts >= $s)' >/dev/null 2>&1; then
      echo "failed to load '$1': the memory guard killed it under memory pressure (see $guard). Free memory or stop the guard: touch /tmp/mem-guard.stop" >&2
    else
      echo "failed to load '$1': $out (is it pulled? ollama list)" >&2
    fi
    exit 11
  fi
}

# Seconds in a keep_alive like 90s, 45m, 2h, 1h30m, 1d (bare number = seconds). Prints nothing for
# forever/-1. Returns 1 (and prints nothing) for anything it cannot read.
ka_seconds() {
  local s="$1" total=0
  case "$s" in forever|-1) return 0 ;; esac
  if [[ "$s" =~ ^[0-9]+$ ]]; then echo "$((10#$s))"; return 0; fi
  [[ "$s" =~ ^([0-9]+[dhms])+$ ]] || return 1
  while [[ "$s" =~ ^([0-9]+)([dhms])(.*)$ ]]; do
    case "${BASH_REMATCH[2]}" in
      d) total=$(( total + 10#${BASH_REMATCH[1]} * 86400 )) ;;
      h) total=$(( total + 10#${BASH_REMATCH[1]} * 3600 )) ;;
      m) total=$(( total + 10#${BASH_REMATCH[1]} * 60 )) ;;
      s) total=$(( total + 10#${BASH_REMATCH[1]} )) ;;
    esac
    s="${BASH_REMATCH[3]}"
  done
  echo "$total"
}
# Stop with exit 2 and a plain message, before anything loads, if TTL is not a time we can read.
require_ttl() { # TTL
  ka_seconds "$1" >/dev/null && return 0
  echo "warm: '$1' is not a time. Use a number with units like 90m, 2h, 1h30m or 45s, or 'forever'." >&2
  exit 2
}
# "q stays fast until 12:15 (warm off to free 6.0 GB)" for MODEL held for KEEP_ALIVE.
fast_until_line() { # MODEL KEEP_ALIVE LABEL
  local secs size when
  secs="$(ka_seconds "$2")" || secs=""
  size="$(ollama_cli ps 2>/dev/null | awk -v m="$1" 'NR>1 && ($1 == m || index($1, m ":") == 1) {print $3 " " $4; exit}')"
  if [ -z "$secs" ]; then
    case "$2" in forever|-1) when="until you run warm off" ;; *) when="for an unknown time" ;; esac
  else when="until $(date -v+"${secs}"S +%H:%M)"; fi
  printf '%s stays fast %s%s\n' "$3" "$when" "${size:+ (warm off to free $size)}"
}

# "1h", "30m", "forever": a first slot that is a time, not a model.
is_duration() { [[ "$1" =~ ^([0-9]+[dhms])+$ ]] || [ "$1" = forever ]; }

cmd="${1:-status}"
# bare `warm --json` means the status view, like bare `warm`
[ "$cmd" = --json ] && set -- status --json && cmd=status
case "$cmd" in
  on)
    target="${2:-}"
    # Read the time before the server is touched: a value we cannot read loads nothing.
    if [ -z "$target" ]; then require_ttl "$WARM_KEEP_ALIVE"
    elif is_duration "$target"; then :
    elif [[ "$target" =~ ^[0-9] ]]; then
      echo "warm: '$target' is not a time. Use a number with units like 90m, 2h, 1h30m or 45s, or 'forever'." >&2
      exit 2
    else require_ttl "${3:-$DEFAULT_LEASE}"; fi
    ollama_ensure || { server_down_msg; exit 10; }
    if [ -z "$target" ]; then
      echo "loading $WARM_MODEL for $WARM_KEEP_ALIVE ..."
      pin "$WARM_MODEL" "$WARM_KEEP_ALIVE"
      fast_until_line "$WARM_MODEL" "$WARM_KEEP_ALIVE" q
    elif is_duration "$target"; then
      # `warm on 1h` means the small model (what q uses) for an hour
      [ "$target" = forever ] && ttl=-1 || ttl="$target"
      echo "loading $WARM_MODEL for $target ..."
      pin "$WARM_MODEL" "$ttl"
      fast_until_line "$WARM_MODEL" "$target" q
    else
      model="$(resolve_tier "$target")"
      ttl="${3:-$DEFAULT_LEASE}"
      [ "$ttl" = forever ] && ttl=-1
      echo "loading $model for $ttl ..."
      pin "$model" "$ttl"
      fast_until_line "$model" "$ttl" "$target"
    fi
    ollama_cli ps
    ;;
  off)
    target="${2:-}"
    ollama_up || { echo "server is down, nothing resident"; exit 0; }
    if [ "$target" = all ]; then
      # Stop everything resident — one sweep back to zero-idle.
      ollama_cli ps 2>/dev/null | awk 'NR>1 {print $1}' | while read -r m; do
        echo "shutting down $m ..."
        ollama_cli stop "$m" 2>/dev/null || true
      done
    else
      model="$(resolve_tier "${target:-$WARM_MODEL}")"
      echo "shutting down $model ..."
      ollama_cli stop "$model" 2>/dev/null || true
    fi
    ollama_cli ps || true
    ;;
  status)
    if [ "${2:-}" = "--json" ]; then
      # Machine view: what is loaded and when each model expires (far-future = pinned).
      if ps_json="$(curl -s -m 3 "$OLLAMA_HOST/api/ps")" && printf '%s' "$ps_json" | jq -e . >/dev/null 2>&1; then
        printf '%s' "$ps_json" | jq -c '{server: "up", resident: [.models[]? | {name, size, expires_at}]}'
      else
        echo '{"server":"down","resident":[]}'
      fi
      exit 0
    fi
    if ps_out="$(ollama_cli ps)"; then
      # Header only means nothing is loaded; say so like `lm status` does.
      if [ "$(printf '%s\n' "$ps_out" | wc -l | tr -d ' ')" -le 1 ]; then echo "nothing resident (idle, ~0 RAM)"; else printf '%s\n' "$ps_out"; fi
    else
      echo "server is down, nothing resident (it starts on demand)"
    fi
    ;;
  restart)
    "$0" off
    "$0" on
    ;;
  -h|--help|help)
    set +u
    printf '%s%swarm%s %s— keep a model loaded so q answers instantly, and say when it unloads%s\n' "$Bd" "$C" "$Rs" "$Dm" "$Rs"
    _sec USAGE
    _cmd 'warm on 1h'            "keep the small model (what q uses) loaded for an hour; default is $WARM_KEEP_ALIVE"
    _cmd 'warm off'              'unload it now and give the memory back'
    _cmd 'warm status'           'what is loaded, how much memory it holds, when it unloads'
    _sec EXAMPLES
    _ex 'warm on 1h'             '# q stays fast until the time it prints'
    _ex 'warm on code 4h'        '# keep the big coding model loaded for a long session'
    _more
    _cmd 'warm on [tier|model] [time]' "load a tier (small, big, code) or any model for a time (default $DEFAULT_LEASE; 'forever' keeps it until warm off)"
    _cmd 'warm off [tier|model|all]'   'unload the small model, one tier, or everything loaded'
    _cmd 'warm status --json'    'machine view: what is loaded and when each model expires'
    _cmd 'warm restart'          'off, then on'
    _ex 'warm off all'           '# back to zero memory'
    _sec NOTES
    _note "Loaded models are your choice: GUI hosts only read the state ('lm status --json') and must not toggle it. 'lm fast 1h' is the same as 'warm on 1h'."
    _help_end 'warm -h'
    set -u
    ;;
  *)
    echo "warm: unknown verb '$cmd'" >&2
    echo "usage: warm {on [tier|model] [ttl] | off [tier|model|all] | status | restart}   (try: warm -h)" >&2
    exit 2
    ;;
esac
