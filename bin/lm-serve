#!/usr/bin/env bash
# The local-models Ollama server, run with our resource policy baked in.
#
# Self-hosted on purpose: Ollama.app does NOT inherit `launchctl setenv` vars, so
# server-launch-only settings (notably OLLAMA_MAX_LOADED_MODELS) never took effect
# when the app owned the server. Running serve ourselves makes the policy
# deterministic and version-controlled. Owns 127.0.0.1:11434.
#
# Started on demand by the LaunchAgent com.alcatraz.local-models-ollama (callers
# use ollama_ensure in bin/_lib.sh), never at login. The server exits by itself
# once it has been idle for LM_IDLE_EXIT_SECS: no model resident and no
# generate/chat/embed request in that window. None of these vars are credentials.

# Unload models immediately by default; Tier W overrides per-request (`warm on`).
export OLLAMA_KEEP_ALIVE=0
# Warm companion coexists with one on-demand big model without eviction.
export OLLAMA_MAX_LOADED_MODELS=2
# Flash attention unlocks the quantized KV cache below.
export OLLAMA_FLASH_ATTENTION=1
# q8 KV cache ~halves KV-cache RAM vs f16 (verified: log shows K (q8_0), flash_attn enabled).
export OLLAMA_KV_CACHE_TYPE=q8_0

# NOTE (resolved 2026-07-07; was "OLLAMA_USE_MLX inert on 0.30.6, revisit later"):
# MLX shipped natively in Ollama and is FORMAT-routed, not an env toggle — safetensors
# library tags (-nvfp4/-mxfp8) run the in-process MLX runner, GGUF always uses
# llama-server. OLLAMA_USE_MLX never existed. Measured verdict (kept Q4_K_M on the
# code tier — prefill + judgment beat MLX's faster load): docs/05 §1.

IDLE_EXIT_SECS="${LM_IDLE_EXIT_SECS:-300}"
POLL_SECS=30
HOST="http://127.0.0.1:11434"
# launchd sends the server's stderr here; request lines ([GIN] ... POST) are how
# we see a call that loaded and unloaded a model between two polls.
LOG="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/logs/ollama-serve.err.log"

/opt/homebrew/bin/ollama serve &
srv=$!
trap 'kill "$srv" 2>/dev/null; wait "$srv"; exit 0' TERM INT

offset=$(wc -c <"$LOG" 2>/dev/null || echo 0)
idle=0
while kill -0 "$srv" 2>/dev/null; do
  sleep "$POLL_SECS"
  size=$(wc -c <"$LOG" 2>/dev/null || echo 0)
  # A rotated or truncated log restarts the read from the top.
  [ "$size" -lt "$offset" ] && offset=0
  # Status polls (GET /api/ps, /api/version) from Switchboard and friends do not
  # count as use, or the server would never go idle.
  if tail -c +"$((offset + 1))" "$LOG" 2>/dev/null | /usr/bin/grep -q '| POST '; then
    used=1
  else
    used=0
  fi
  offset=$size
  ps=$(curl -s -m 3 "$HOST/api/ps") || continue
  if [ "$used" = 1 ] || [[ "$ps" != *'"models":[]'* ]]; then
    idle=0
  else
    idle=$((idle + POLL_SECS))
  fi
  if [ "$idle" -ge "$IDLE_EXIT_SECS" ]; then
    echo "lm-serve: idle ${idle}s, shutting the server down" >&2
    kill "$srv" 2>/dev/null
    wait "$srv"
    exit 0
  fi
done
wait "$srv"
