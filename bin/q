#!/usr/bin/env bash
# q — the quick local companion. Direct, usable, fast answers from the warm model.
#
#   q on | off | status            toggle / inspect Tier W (delegates to `warm`)
#   q "how do I ..."               quick answer (default intent: ask, ≤2 sentences)
#   q cmd "find procs on 8001"     a single macOS shell command, nothing else
#   q ask "what is a mutex"        short prose answer
#   q title "<text>"               a 2-5 word title (tab titles, fire-and-forget)
#   git diff | q commit            a commit message from the piped diff
#   cmd | q "summarize"            piped stdin becomes input context
#
# Machine modes (for GUI hosts / scripts — see docs/q-spec.md §API):
#   q --json --ctx - --intent summarize     one JSON object on stdout
#   q --stream-json ...                     NDJSON chunk/done/error lines
#
# Why this exists: raw `ollama run` returns essays + thinking traces + every OS. The value
# is the wrapper — a terse macOS system prompt and think:false the model can't talk its way
# out of (proven: "no thinking" in the prompt does NOT disable it; the API flag does).
set -eo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$DIR/config.sh"
# shellcheck source=/dev/null
source "$DIR/bin/_lib.sh"

# `q intents` — list the registry (the live source of truth for intents). Defined
# early because the subcommand dispatch runs before the per-call intent helpers.
list_intents() {
  local d="$DIR/intents" f n s
  _sec INTENTS
  for f in "$d"/*.toml; do
    [ -f "$f" ] || continue
    n=$(yq -p toml -r '.name // ""' "$f" 2>/dev/null)
    s=$(yq -p toml -r '.summary // ""' "$f" 2>/dev/null)
    [ "$(yq -p toml -r '.needs_ctx // false' "$f" 2>/dev/null)" = true ] && n="$n *"
    _opt "$n" "$s"
  done
  printf '  %s* needs a document (--ctx/--file/stdin); add one by dropping a .toml in intents/%s\n' "$Dm" "$Rs"
}

show_help() {
  printf '%s%sq%s %s— quick local LLM companion (macOS / Apple Silicon)%s\n' "$Bd" "$C" "$Rs" "$Dm" "$Rs"
  _sec USAGE
  _cmd 'q "<prompt>"'           'ask a question (default intent)'
  _cmd 'q <intent> "<prompt>"'  'intent = cmd | ask | title | commit | summarize | explain-code | describe-data | qa'
  _cmd 'q -c [N] "<prompt>"'    'continue the last exchange (or entry N) — multi-turn'
  _cmd 'q on | off | status'    'Tier W warm toggle (= warm)'
  _cmd 'q history [N|--json]'   'recent queries, numbered (default 15)'
  _cmd 'q show N'               'full prompt + response of entry N'
  _cmd 'q intents'              'list available intents (the registry)'
  _cmd 'q models'               'usable models + tiers (= lm models; ★ default · ● resident)'
  _sec EXAMPLES
  _ex 'q "how do I check disk usage"'        '# terse answer'
  _ex 'q -c "and sorted by size?"'           '# follow-up with context'
  _ex 'q cmd "kill everything on port 3001"' '# one macOS command'
  _ex 'q title "<conversation text>"'        '# 2-5 word title'
  _ex 'git diff | q commit'                  '# commit message from the diff'
  _ex 'q summarize --file report.pdf'        '# PDF/Word/etc extracted locally'
  _ex 'q describe-data --file data.csv'      '# schema + observations'
  _ex 'q --json --ctx - qa "who signs off?" < doc.md'  '# machine mode'
  _ex 'q --think "harder reasoning task"'    '# show the thinking trace'
  _ex 'q -m qwen2.5-coder:3b cmd "..."'      '# swap model per call'
  _ex 'q show 14'                            '# full prompt + response of entry 14'
  _sec OPTIONS
  _opt '--think'        'show the reasoning trace (dimmed, on stderr; off by default)'
  _opt '--web'          'search the web first (DDG, no key) and answer from the results, cited'
  _opt '--diy'          'let q route itself: a planner pass picks intent/web/file/tier, narrated in gray'
  _opt '--no-stats'     'hide the gray token line (text mode; machine modes always carry the counts)'
  _opt '-c, --continue [N]' 'continue last exchange / entry N'
  _opt '--big / --code' 'use the big (reasoning) / code tier for this call'
  _opt '-m, --model M'  "model or tier alias: small | big | code | <name> (default: small)"
  _opt '--raw'          'no system prompt (bare model)'
  _opt '--json'         'machine mode: one JSON object on stdout, no ANSI'
  _opt '--stream-json'  'machine mode: NDJSON chunk/done/error lines'
  _opt '--format FILE'  'constrain output to a JSON schema (with --json: adds parsed .data)'
  _opt '--glow'         'render the reply through glow (buffers output; TTY-only, no-op without glow)'
  _opt '--ctx, --file FILE | -' 'context document from a file or stdin (- = stdin)'
  _opt '--ctx-name S'   "the document's display name (framing hint)"
  _opt '--max-ctx N'    'truncate context to N chars (default 16000)'
  _opt '--timeout S'    'wall-clock cap; structured timeout error after'
  _opt '--intent X'     'intent as a flag (same set as the positional token)'
  _opt '-h, --help'     'show this help'
  list_intents   # the live registry — same source as `q intents`, never drifts
  _sec DEFAULTS
  printf '  %smacOS/Apple-Silicon assumed; Linux only if you say "linux server/container".%s\n' "$Dm" "$Rs"
  printf '  %sthinking off · deterministic (temp 0) · never asks · logged to logs/q-history.jsonl%s\n' "$Dm" "$Rs"
  printf '  %s--ctx/--file extracts text locally: PDF (poppler), Word/RTF/HTML (textutil),%s\n' "$Dm" "$Rs"
  printf '  %stext/csv/json/code as-is; binaries refused. Truncated at --max-ctx chars.%s\n' "$Dm" "$Rs"
  _sec CONFIGURATION
  printf '  %s%s/config.sh%s %s(WARM_MODEL, keep-alive)%s\n' "$C" "$DIR" "$Rs" "$Dm" "$Rs"
}

LOG="$DIR/logs/q-history.jsonl"
show_history() {
  # gsub flattens multiline prompts (piped diffs) to ONE display line each, so
  # displayed numbers stay equal to JSONL line numbers — the show/-c contract.
  jsonl_history "$LOG" "${1:-15}" '"\(.ts[11:19])  \(.intent)  \(.ms)ms  \((.prompt | gsub("\\s+"; " "))[0:50])"'
  echo "  → q show N   for the full prompt + response of entry N"
}
show_entry() {
  jsonl_entry "$LOG" "${1:-}" \
    '"#\($i)  \(.ts)  [\(.intent)]  \(.ms)ms  \(.model)\n\nPROMPT:\n\(.prompt)\n\nRESPONSE:\n\(.response)"'
}

# Subcommands: help, history, show, and the warm toggle.
case "${1:-}" in
  -h|--help|help)        show_help; exit 0 ;;
  history)               shift
                         if [ "${1:-}" = "--json" ]; then
                           shift; if [ -f "$LOG" ]; then tail -n "${1:-15}" "$LOG"; fi; exit 0
                         fi
                         show_history "${1:-15}"; exit 0 ;;
  show)                  shift; show_entry "${1:-}"; exit 0 ;;
  intents)               list_intents; exit 0 ;;
  models)                exec "$DIR/bin/lm" models "${@:2}" ;;
  on|off|status|restart) exec "$DIR/bin/warm" "$@" ;;
esac

# resolve_tier (small/big/code → real names) lives in _lib.sh — shared with lib/fleet.

# Intents are data: intents/<name>.toml = {name, summary, needs_ctx, system_prompt}.
# Adding an intent is dropping a file — bin/q reads the registry, nothing is hardcoded.
INTENT_DIR="$DIR/intents"
intent_exists()    { [ -f "$INTENT_DIR/$1.toml" ]; }
intent_sys()       { yq -p toml -r '.system_prompt // ""' "$INTENT_DIR/$1.toml" 2>/dev/null; }
intent_needs_ctx() { [ "$(yq -p toml -r '.needs_ctx // false' "$INTENT_DIR/$1.toml" 2>/dev/null)" = true ]; }

MODEL="$WARM_MODEL"
THINK=false
INTENT=ask
RAW=false
MODE=text          # text (human) | json (one object) | stream (NDJSON)
CTX_FILE=""; CTX_NAME=""; MAX_CTX=16000; TIMEOUT=0; FORMAT_FILE=""; GLOW=false
CONT=false; CONT_N=""; USER_MODEL=false; USER_INTENT=false
STATS=true         # gray token line at the end (text mode); --no-stats mutes
WEB=false          # --web: search + feed results as context (conductor fetches)
WEB_QUERY=""       # focused query (set by --diy's plan; --web defaults to the prompt)
DIY=false          # --diy: a planner pass picks intent/web/file/tier from the prompt

# Pull leading flags; everything else is positional.
positionals=()
while [ $# -gt 0 ]; do
  case "$1" in
    --think) THINK=true; shift ;;
    --raw)   RAW=true; shift ;;
    --web)   WEB=true; shift ;;
    --diy)   DIY=true; shift ;;
    --no-stats) STATS=false; shift ;;
    --json)        MODE=json; shift ;;
    --stream-json) MODE=stream; shift ;;
    --big)   MODEL="$(resolve_tier big)";  USER_MODEL=true; shift ;;
    --code)  MODEL="$(resolve_tier code)"; USER_MODEL=true; shift ;;
    --format)   FORMAT_FILE="$2"; shift 2 ;;
    --glow)     GLOW=true; shift ;;
    --ctx|--file) CTX_FILE="$2"; shift 2 ;;
    --ctx-name) CTX_NAME="$2"; shift 2 ;;
    --max-ctx)  MAX_CTX="$2"; shift 2 ;;
    --timeout)  TIMEOUT="$2"; shift 2 ;;
    --intent)   INTENT="$2"; USER_INTENT=true; shift 2 ;;
    -c|--continue)
      CONT=true
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then CONT_N="$2"; shift 2; else shift; fi ;;
    -m|--model) MODEL="$(resolve_tier "$2")"; USER_MODEL=true; shift 2 ;;
    -h|--help) show_help; exit 0 ;;
    *) positionals+=("$1"); shift ;;
  esac
done

# A leading intent token selects the intent (if it's a registered intent); rest is the query.
if [ "${#positionals[@]}" -gt 0 ] && intent_exists "${positionals[0]}"; then
  INTENT="${positionals[0]}"; USER_INTENT=true; positionals=("${positionals[@]:1}")
fi
QUERY="${positionals[*]}"

# Structured failure for machine modes; plain stderr for humans. The error CODES
# and exit codes are the extension contract (q-spec §API) — never branch on text.
emit_error() { # CODE MESSAGE EXIT
  case "$MODE" in
    stream) jq -cn --arg c "$1" --arg m "$2" '{t:"error", code:$c, message:$m}' ;;
    json)   jq -cn --arg c "$1" --arg m "$2" '{ok:false, code:$c, message:$m}' ;;
    *)      echo "q: $2" >&2 ;;
  esac
  exit "$3"
}

# Cancellation must hold during the bash phase too (ctx reads, preflight curl);
# python replaces this with its own handlers the moment it execs.
trap 'emit_error cancelled "cancelled by client" 130' TERM INT

# Numeric flags are part of the machine contract — garbage must be a structured
# error, not a bash arithmetic stderr leak or an uncaught python ValueError.
[[ "$MAX_CTX" =~ ^[0-9]+$ ]] || emit_error invalid_args "--max-ctx must be a non-negative integer, got '$MAX_CTX'" 2
[[ "$TIMEOUT" =~ ^[0-9]+([.][0-9]+)?$ ]] || emit_error invalid_args "--timeout must be seconds (number), got '$TIMEOUT'" 2

# ── --diy: plan, then execute ──
# The warm model reads the prompt and emits a PLAN as schema-constrained data
# (intents/diy-plan.toml + .schema.json); THIS script validates and executes it.
# Capability selection belongs to the model, execution stays with the conductor
# (docs/03) — and every step is narrated on the gray stderr channel, so nothing
# needs permission and nothing happens silently. Explicit flags always win:
# a user-chosen intent/model/ctx is never overridden by the plan.
if $DIY && [ "${#positionals[@]}" -gt 0 ]; then
  _dim=""; _rs=""; [ -t 2 ] && { _dim=$'\033[2m'; _rs=$'\033[0m'; }
  PLAN_ENV="$("$0" --json --no-stats --timeout 25 --intent diy-plan \
    --format "$INTENT_DIR/diy-plan.schema.json" "$QUERY" 2>/dev/null)" || PLAN_ENV=""
  PLAN="$(printf '%s' "$PLAN_ENV" | jq -c '.data // empty' 2>/dev/null)"
  if [ -n "$PLAN" ]; then
    p_intent=$(printf '%s' "$PLAN" | jq -r '.intent // "ask"')
    p_web=$(printf '%s' "$PLAN" | jq -r '.needs_web // false')
    p_wq=$(printf '%s' "$PLAN" | jq -r '.web_query // ""')
    p_file=$(printf '%s' "$PLAN" | jq -r '.file_path // ""')
    p_img=$(printf '%s' "$PLAN" | jq -r '.image_path // ""')
    p_probe=$(printf '%s' "$PLAN" | jq -r '.local_probe // ""')
    p_tier=$(printf '%s' "$PLAN" | jq -r '.tier // "small"')
    p_why=$(printf '%s' "$PLAN" | jq -r '.reason // ""')
    trace="· diy: ${p_why:-routed} → intent=$p_intent · tier=$p_tier"
    # An image prompt is a job for `see`, not q — hand the whole call over.
    if [ -n "$p_img" ]; then
      p_img_x="${p_img/#\~/$HOME}"
      if [ -f "$p_img_x" ]; then
        [ "$MODE" = text ] && printf '%s%s · image → see%s\n' "$_dim" "$trace" "$_rs" >&2
        exec "$DIR/bin/see" "$p_img_x" "$QUERY"
      fi
    fi
    $USER_INTENT || { intent_exists "$p_intent" && INTENT="$p_intent"; }
    $USER_MODEL  || MODEL="$(resolve_tier "$p_tier")"
    if [ "$p_web" = true ]; then
      # A shell-command answer is composed offline; search results only
      # contaminate it (observed: a stray repo from the results got cloned
      # into the command). Honor web for cmd only with a focused query.
      if [ "$p_intent" = cmd ] && [ -z "$p_wq" ]; then
        trace="$trace · web dropped (cmd composes offline)"
      else
        WEB=true; WEB_QUERY="$p_wq"
        wq_disp="${p_wq:-(the prompt)}"; trace="$trace · web=\"${wq_disp:0:48}\""
      fi
    fi
    if [ -n "$p_file" ] && [ -z "$CTX_FILE" ]; then
      p_file_x="${p_file/#\~/$HOME}"
      if [ -f "$p_file_x" ]; then CTX_FILE="$p_file_x"; trace="$trace · file=$(basename "$p_file_x")"
      else trace="$trace · file=$p_file (not found, skipped)"; fi
    fi
    # Probe scan: like the file scan, extraction beats model recall — when the
    # prompt asks about a version and names a word that IS an installed command,
    # that's the probe, whether or not the planner said so.
    RAW_PROMPT="${positionals[*]}"   # scans read the user's words, never the assembled query
    if [ -z "$p_probe" ] && [[ "$RAW_PROMPT" == *ersion* ]]; then
      set -f
      for w in $RAW_PROMPT; do
        w_c="${w%%[,.;:!?\"\')]}"
        case "$w_c" in
          ''|?|??|the|and|check|latest|local|online|tell|have|one|version|not|now|are|was|what|which|with|from|test|time|man|cat|find|open) continue ;;
        esac
        if command -v "$w_c" >/dev/null 2>&1; then p_probe="$w_c --version"; break; fi
      done
      set +f
    fi
    # OS-version asks have no command word to scan for — a fixed two-entry map
    # covers the macOS case ("what macOS do I have") with the bare-but-safe
    # sw_vers, which the strict shape below would otherwise refuse.
    if [ -z "$p_probe" ]; then
      case "$(printf '%s' "$RAW_PROMPT" | tr 'A-Z' 'a-z')" in
        *"mac os"*|*macos*|*"os x"*|*osx*) [[ "$RAW_PROMPT" == *ersion* ]] && p_probe="sw_vers" ;;
      esac
    fi
    # Local probe: version/status of an installed tool, model-suggested but
    # conductor-VALIDATED — strict shape (one bare command + one version verb)
    # or an exact entry in the tiny bare-probe whitelist; command must exist,
    # 5s cap. Output rides into the prompt as ground truth. Anything outside
    # is refused with a trace, never run.
    if [ -n "$p_probe" ]; then
      case "$p_probe" in
        sw_vers|"uname -r") : ;;   # whitelisted bare probes (no version verb exists)
        *) if ! [[ "$p_probe" =~ ^([A-Za-z0-9_.-]+)\ (--version|-V|version)$ ]]; then p_probe="__rejected__:$p_probe"; fi ;;
      esac
    fi
    if [ -n "$p_probe" ] && [ "${p_probe#__rejected__:}" = "$p_probe" ]; then
      probe_cmd="${p_probe%% *}"; probe_arg="${p_probe#* }"; [ "$probe_arg" = "$p_probe" ] && probe_arg=""
      if command -v "$probe_cmd" >/dev/null 2>&1; then
        # shellcheck disable=SC2086 — probe_arg is one validated verb, not user input
        PROBE_OUT="$(perl -e 'my $p=fork; if($p==0){setpgrp(0,0); exec(@ARGV) or exit 127} local $SIG{ALRM}=sub{kill "KILL",-$p}; alarm 5; waitpid($p,0)' \
                     "$probe_cmd" $probe_arg 2>&1 | head -3)" || PROBE_OUT=""
        if [ -n "$PROBE_OUT" ]; then
          QUERY="$QUERY

<input name=\"local-probe\" cmd=\"$p_probe\">
$PROBE_OUT
</input>"
          trace="$trace · probe=\`$p_probe\`"
          # A version-compare needs a focused search, and the probe names the
          # subject better than the user's sentence ever will.
          if $WEB && [ -z "$WEB_QUERY" ]; then
            WEB_QUERY="$probe_cmd latest version release"
            trace="$trace · web→\"$WEB_QUERY\""
          fi
        else
          trace="$trace · probe=\`$p_probe\` (no output, skipped)"
        fi
      else
        trace="$trace · probe skipped ('$probe_cmd' not installed)"
      fi
    elif [ -n "$p_probe" ]; then
      trace="$trace · probe rejected (\"${p_probe#__rejected__:}\" outside the safe shape)"
    fi
    # Deterministic assist: the planner sometimes misses a path the prompt
    # plainly names — the conductor greps the prompt words for a real file
    # (tolerating trailing punctuation). Images hand the whole call to `see`;
    # readable text loads as context; a named path that does NOT exist gets an
    # honest note so the answer says "no such file", not "I cannot access files".
    # Models suggest, the script verifies (and beats them at exact).
    if [ -z "$CTX_FILE" ]; then
      missing_note=""
      set -f
      for w in $RAW_PROMPT; do
        w_clean="${w%%[,.;:!?\"\')]}"
        w_x="${w_clean/#\~/$HOME}"
        if [ ! -f "$w_x" ]; then
          # Path-shaped but absent → remember the first one for the honesty note.
          case "$w_clean" in
            */*|*.png|*.jpg|*.jpeg|*.webp|*.pdf|*.md|*.txt|*.csv|*.json)
              [ -n "$missing_note" ] || { [ -e "$w_x" ] || missing_note="$w_clean"; } ;;
          esac
          continue
        fi
        case "$(file -b --mime-type "$w_x" 2>/dev/null)" in
          image/*)
            if [ "$MODE" = text ]; then printf '%s%s · image=%s (prompt-scan) → see%s\n' "$_dim" "$trace" "$(basename "$w_x")" "$_rs" >&2; fi
            set +f
            exec "$DIR/bin/see" "$w_x" "$QUERY" ;;
        esac
        if [ "$(file -b --mime-encoding "$w_x" 2>/dev/null)" != binary ]; then
          CTX_FILE="$w_x"; missing_note=""; trace="$trace · file=$(basename "$w_x") (prompt-scan)"; break
        fi
      done
      set +f
      if [ -n "$missing_note" ]; then
        QUERY="$QUERY

(Note from the runtime: no file exists at \"$missing_note\" — say so plainly.)"
        trace="$trace · file=$missing_note NOT FOUND"
      fi
    fi
    if [ "$MODE" = text ]; then printf '%s%s%s\n' "$_dim" "$trace" "$_rs" >&2; fi
  else
    if [ "$MODE" = text ]; then printf '%s· diy: planner unavailable — running plain%s\n' "$_dim" "$_rs" >&2; fi
  fi
fi

# Constrained decoding: --format FILE passes a JSON schema to Ollama's `format`
# field, so the model's output IS schema-valid JSON. In --json mode the envelope
# gains a `data` field with that output pre-parsed.
FORMAT=""
if [ -n "$FORMAT_FILE" ]; then
  [ -f "$FORMAT_FILE" ] || emit_error format_unreadable "no such schema file: $FORMAT_FILE" 12
  FORMAT="$(jq -c . "$FORMAT_FILE" 2>/dev/null)" \
    || emit_error format_invalid "schema is not valid JSON: $FORMAT_FILE" 12
fi

# Context document: --ctx - (stdin) · --ctx/--file FILE · or bare non-TTY stdin.
# Rich formats (PDF, Word, RTF) are extracted to text LOCALLY — no cloud, ever —
# so "summarize this PDF" works instead of feeding the model raw bytes. Each
# emit_error runs in THIS scope (the `||`), so its exit actually stops q; calling
# it inside a `$(...)` would only kill the subshell and swallow the error frame.
CTX=""; TRUNC=false
if [ "$CTX_FILE" = "-" ]; then
  CTX="$(cat)"
elif [ -n "$CTX_FILE" ]; then
  [ -f "$CTX_FILE" ] || emit_error ctx_unreadable "no such file: $CTX_FILE" 12
  # Empty file first — else `file --mime-encoding` reports a 0-byte .txt as
  # "binary" and we'd refuse it with a misleading reason.
  [ -s "$CTX_FILE" ] || emit_error ctx_empty "file is empty: $CTX_FILE" 12
  ext="$(printf '%s' "${CTX_FILE##*.}" | tr 'A-Z' 'a-z')"
  case "$ext" in
    pdf)
      command -v pdftotext >/dev/null \
        || emit_error ctx_unsupported "reading PDF needs poppler — 'brew install poppler'" 12
      CTX="$(pdftotext -q -nopgbrk "$CTX_FILE" - 2>/dev/null)" \
        || emit_error ctx_unsupported "pdftotext failed on $CTX_FILE" 12 ;;
    doc|docx|rtf|odt|html|htm)
      CTX="$(textutil -convert txt -stdout "$CTX_FILE" 2>/dev/null)" \
        || emit_error ctx_unsupported "could not extract text from .$ext file" 12 ;;
    *)
      # Refuse binaries rather than feed garbage. `file --mime-encoding` is the
      # right tool — a NUL-only sniff misses NUL-free binaries (200 random bytes
      # slipped through in testing: ~46% have no NUL in the sample).
      enc=$(file -b --mime-encoding "$CTX_FILE" 2>/dev/null)
      [ "$enc" = binary ] && emit_error ctx_binary "'$CTX_FILE' looks binary ($(file -b "$CTX_FILE" 2>/dev/null)) — extract text first" 12
      CTX="$(cat "$CTX_FILE")" || emit_error ctx_unreadable "could not read $CTX_FILE" 12 ;;
  esac
  # A real file that extracted to nothing (scanned/image-only PDF, empty doc).
  if [ -z "$CTX" ] && [ -s "$CTX_FILE" ]; then
    emit_error ctx_empty "no extractable text in $CTX_FILE (scanned PDF / image-only?)" 12
  fi
  [ -n "$CTX_NAME" ] || CTX_NAME="$(basename "$CTX_FILE")"
elif [ ! -t 0 ]; then
  CTX="$(cat)"
fi
if [ -n "$CTX" ]; then
  # 400k chars (~25x the default window) means a binary or a mistake — refuse
  # rather than silently summarize 4% of it.
  [ "${#CTX}" -gt 400000 ] && emit_error ctx_too_large "document is ${#CTX} chars (hard cap 400000)" 12
  if [ "${#CTX}" -gt "$MAX_CTX" ]; then CTX="${CTX:0:$MAX_CTX}"; TRUNC=true; fi
  CTX_OPEN="<input>"
  [ -n "$CTX_NAME" ] && CTX_OPEN="<input name=\"$CTX_NAME\">"
  if [ -n "$QUERY" ]; then QUERY="$QUERY

$CTX_OPEN
$CTX
</input>"
  else QUERY="$CTX_OPEN
$CTX
</input>"; fi
  if $TRUNC && [ "$MODE" = text ]; then QUERY="$QUERY
[input truncated at $MAX_CTX chars]"; fi
fi
# Document intents are meaningless without a document. The #1 trap (observed):
# naming a file IN THE PROMPT — which is just text the model can't open — and
# getting a confident "I can't access your filesystem" instead of an answer.
# Require real context, and if they named an existing file, point at the fix.
if intent_needs_ctx "$INTENT" && [ -z "$CTX" ]; then
  if $DIY; then
    # --diy never hard-fails on its own routing: a doc intent that ended up
    # docless (planner optimism) degrades to ask; web results, if any, still ride.
    INTENT=ask
    if [ "$MODE" = text ] && [ -t 2 ]; then printf '\033[2m· diy: doc-intent without a doc → ask\033[0m\n' >&2
    elif [ "$MODE" = text ]; then echo "· diy: doc-intent without a doc → ask" >&2; fi
  else
    hint="'$INTENT' needs a document — pass the file with --ctx <path> (or pipe it in)."
    set -f
    for w in $QUERY; do
      [ -f "$w" ] && { hint="$hint You named '$w' in the prompt (that's just text) — try: q $INTENT --ctx '$w'"; break; }
    done
    set +f
    emit_error ctx_required "$hint" 2
  fi
fi

if [ -z "$QUERY" ]; then
  # Bare `q` is a human asking for help; in machine mode an empty query is a
  # caller bug and must be a structured error, never help text on stdout.
  [ "$MODE" = text ] && { show_help; exit 0; }
  emit_error invalid_args "no prompt or context provided" 2
fi

# ── --web: search first, answer from the results ──
# The script fetches (lib/websearch: DDG lite, no key, top page extracted); the
# model only reads. A dead network degrades to answering offline, narrated on
# the gray channel — never a hard failure, never silent.
if $WEB; then
  [ -n "$WEB_QUERY" ] || WEB_QUERY="${positionals[*]}"
  _dim=""; _rs=""; [ -t 2 ] && { _dim=$'\033[2m'; _rs=$'\033[0m'; }
  WEB_OUT="$("$DIR/lib/websearch" "$WEB_QUERY" -n 5 --fetch 2>/dev/null)" || WEB_OUT=""
  if [ -n "$WEB_OUT" ]; then
    if [ "$MODE" = text ]; then
      printf '%s· web: "%s" → %s results (top page fetched)%s\n' \
        "$_dim" "${WEB_QUERY:0:60}" "$(printf '%s\n' "$WEB_OUT" | grep -c '^\[')" "$_rs" >&2
    fi
    QUERY="$QUERY

<input name=\"web-results\" query=\"$WEB_QUERY\">
$WEB_OUT
</input>
(Answer from the web results above; cite result numbers like [2]. If they do not contain the answer, say so.)"
  else
    if [ "$MODE" = text ]; then printf '%s· web: search unreachable — answering offline%s\n' "$_dim" "$_rs" >&2; fi
  fi
fi

# -c: replay the target entry's whole conversation chain (entries sharing a cid)
# as prior messages, and adopt its model/intent unless overridden. Chains are
# keyed by cid; pre-cid entries fall back to their own ts as the chain id.
HIST="[]"; CID=""
if $CONT && [ -f "$LOG" ]; then
  target=$(if [ -n "$CONT_N" ]; then sed -n "${CONT_N}p" "$LOG"; else tail -1 "$LOG"; fi)
  if [ -n "$target" ]; then
    CID=$(printf '%s' "$target" | jq -r '.cid // .ts')
    $USER_MODEL  || MODEL=$(printf '%s' "$target" | jq -r '.model')
    $USER_INTENT || INTENT=$(printf '%s' "$target" | jq -r '.intent')
    # Cap at the last 8 exchanges BEFORE building the argv — long chains of
    # diff-sized exchanges would otherwise blow past ARG_MAX (the finer ~18k
    # char budget is applied again inside python).
    HIST=$(jq -cs --arg cid "$CID" \
      '[ .[] | select((.cid // .ts) == $cid) | {p:.prompt, r:.response} ] | .[-8:]' "$LOG")
  else
    emit_error no_such_entry "no entry ${CONT_N:-} to continue" 2
  fi
fi

# System prompt comes from the registry (intents/<name>.toml). Unknown intent → no
# system prompt (same as the old case fall-through). --raw blanks it regardless.
if intent_exists "$INTENT"; then SYS="$(intent_sys "$INTENT")"; else SYS=""; fi
$RAW && SYS=""

if ! ollama_up; then
  if [ "$MODE" = text ]; then server_down_msg; exit 10; fi
  emit_error server_down "ollama server unreachable at $OLLAMA_HOST" 10
fi

# Don't disturb the warm pin: keep_alive is last-writer-wins per request, so if
# the target model is already resident keep it resident (-1); otherwise load it
# just for this call and let it unload (0).
if ollama_resident "$MODEL"; then KEEP=-1; else KEEP=0; fi

# Lease hint: repeated cold loads of a big model deserve a nudge toward
# `warm on` — suggestion only, residency stays the human's call. Bash decides
# eligibility (cold + not the companion) so the warm hot path never pays for
# it; python counts recent same-model calls and prints the one-liner.
LEASE_HINT=""
if [ "$MODE" = text ] && [ "$KEEP" = 0 ] && [ "$MODEL" != "$WARM_MODEL" ]; then
  case "$MODEL" in
    "${CODE_MODEL:-qwen3.6:35b-a3b}") LEASE_HINT="warm on code" ;;
    "${BIG_MODEL:-gemma4:26b}")       LEASE_HINT="warm on big" ;;
    *)                                LEASE_HINT="warm on $MODEL" ;;
  esac
fi

# --glow renders the finished reply as markdown instead of streaming it. Decided
# here (not in python) so PATH and TTY are probed once; machine modes ignore it.
GLOW_OK=false
if $GLOW && [ "$MODE" = text ] && [ -t 1 ] && command -v glow >/dev/null 2>&1; then GLOW_OK=true; fi

# Deterministic (temperature 0) + history logging. Stream token-by-token for low
# perceived latency (text mode) or as NDJSON frames (stream mode).
# exec so python IS this process: a GUI host's SIGTERM must reach the signal
# handlers (cancelled/130), not kill a bash wrapper around them (143).
mkdir -p "$DIR/logs"
exec python3 - "$MODEL" "$SYS" "$QUERY" "$THINK" "$KEEP" "$INTENT" "$LOG" "$HIST" "$CID" "$MODE" "$TIMEOUT" "$TRUNC" "$OLLAMA_HOST" "$STATS" "$FORMAT" "$GLOW_OK" "$LEASE_HINT" <<'PY'
import sys, json, time, signal, urllib.request, urllib.error
(model, sysp, query, think, keep, intent, logf,
 histjson, cid, mode, timeout, trunc, host, stats, fmt, glow, lease_hint) = sys.argv[1:18]
truncated = trunc == "true"

def emit_err(code, msg, rc):
    if mode == "stream":
        sys.stdout.write(json.dumps({"t": "error", "code": code, "message": msg}) + "\n")
    elif mode == "json":
        sys.stdout.write(json.dumps({"ok": False, "code": code, "message": msg}) + "\n")
    else:
        sys.stderr.write("q: %s\n" % msg)
    sys.stdout.flush()
    try:  # failures are history too — the feedback sink mines these; never block the exit
        ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with open(logf, "a") as f:
            f.write(json.dumps({"ts": ts, "cid": cid or ts, "intent": intent, "model": model,
                                "think": think == "true", "prompt": query,
                                "response": "[error: %s]" % code, "error": code, "ms": 0}) + "\n")
    except Exception:
        pass
    sys.exit(rc)

# Cancellation contract: the GUI host SIGTERMs us when the user closes the
# overlay. Exiting drops the HTTP connection, which makes Ollama stop generating.
signal.signal(signal.SIGTERM, lambda *_: emit_err("cancelled", "cancelled by client", 130))
signal.signal(signal.SIGINT,  lambda *_: emit_err("cancelled", "cancelled by client", 130))
if float(timeout) > 0:
    signal.signal(signal.SIGALRM, lambda *_: emit_err("timeout", "exceeded %ss wall clock" % timeout, 13))
    signal.setitimer(signal.ITIMER_REAL, float(timeout))

# Replay the conversation chain (newest-first whole exchanges) within ~18k chars
# — the warm model's 8k-token window minus headroom for system + new prompt.
hist, budget, picked = json.loads(histjson), 18000, []
for ex in reversed(hist):
    cost = len(ex.get("p", "")) + len(ex.get("r", ""))
    if budget - cost < 0 and picked:
        break
    budget -= cost
    picked.append(ex)
picked.reverse()
prior = [m for ex in picked for m in
         ({"role": "user", "content": ex["p"]}, {"role": "assistant", "content": ex["r"]})]
msgs = ([{"role": "system", "content": sysp}] if sysp else []) + prior + [{"role": "user", "content": query}]
payload = {
    "model": model, "messages": msgs,
    "think": think == "true", "stream": True,
    "keep_alive": int(keep),
    "options": {"temperature": 0},
}
if fmt:
    payload["format"] = json.loads(fmt)
body = json.dumps(payload).encode()
req = urllib.request.Request(host.rstrip("/") + "/api/chat", data=body,
                            headers={"Content-Type": "application/json"})
t0 = time.time(); parts = []
in_thinking = False  # thinking streams in message.thinking, separate from content
tok_in = tok_out = 0  # filled from the final done chunk's eval counts
dim, rs = ("\033[2m", "\033[0m") if sys.stderr.isatty() else ("", "")
try:
    with urllib.request.urlopen(req) as r:
        for line in r:
            line = line.strip()
            if not line:
                continue
            obj = json.loads(line)
            if obj.get("done"):  # final chunk carries the token tallies
                tok_in = obj.get("prompt_eval_count", 0)
                tok_out = obj.get("eval_count", 0)
            msg = obj.get("message", {})
            # The reasoning trace goes to stderr (dimmed) so stdout stays the bare
            # answer; machine modes drop it entirely.
            trace = msg.get("thinking", "")
            if trace and mode == "text":
                if not in_thinking:
                    sys.stderr.write(dim); in_thinking = True
                sys.stderr.write(trace); sys.stderr.flush()
            chunk = msg.get("content", "")
            if chunk:
                if in_thinking:
                    sys.stderr.write(rs + "\n"); sys.stderr.flush(); in_thinking = False
                parts.append(chunk)
                if mode == "text" and glow != "true":  # glow buffers; render after the loop
                    sys.stdout.write(chunk); sys.stdout.flush()
                elif mode == "stream":
                    sys.stdout.write(json.dumps({"t": "chunk", "text": chunk}) + "\n")
                    sys.stdout.flush()
except urllib.error.HTTPError as e:
    if e.code == 404:
        emit_err("model_missing", "model '%s' not available on the server" % model, 11)
    emit_err("server_down", "HTTP %s from ollama" % e.code, 10)
except OSError as e:
    # The pre-flight check covers a dead server; this covers it dying mid-request.
    emit_err("server_down", "lost the ollama server mid-request (%s)" % e, 10)
signal.setitimer(signal.ITIMER_REAL, 0)
if in_thinking:
    sys.stderr.write(rs + "\n"); sys.stderr.flush()
ms = int((time.time() - t0) * 1000)
text = "".join(parts).strip()
try:  # the JSONL line this call will occupy → `q show N` re-pulls it later, no lookup
    n_entry = sum(1 for _ in open(logf)) + 1
except Exception:
    n_entry = 1
if mode == "text":
    if glow == "true":
        import subprocess
        try:  # glow died mid-render → the reply must still reach the user plain
            subprocess.run(["glow", "-"], input=(text + "\n").encode(), check=False)
        except Exception:
            sys.stdout.write(text + "\n")
    else:
        sys.stdout.write("\n")
    # Gray token-spend line on stderr — like the --think trace, TTY-only, muteable.
    if stats == "true" and sys.stderr.isatty():
        tps = (tok_out / (ms / 1000)) if ms else 0
        sys.stderr.write("%s· %s in / %s out · %d tok/s · %.1fs · q show %d%s\n"
                         % (dim, format(tok_in, ","), format(tok_out, ","), tps, ms / 1000, n_entry, rs))
elif mode == "stream":
    sys.stdout.write(json.dumps({"t": "done", "model": model, "ms": ms,
                                 "tokens_in": tok_in, "tokens_out": tok_out, "truncated": truncated}) + "\n")
elif mode == "json":
    envelope = {"ok": True, "text": text, "model": model, "ms": ms,
                "tokens_in": tok_in, "tokens_out": tok_out, "truncated": truncated}
    if fmt:  # constrained output: hand consumers the parsed object, not a string to re-parse
        try:
            envelope["data"] = json.loads(text)
        except ValueError:
            envelope["data"] = None
    sys.stdout.write(json.dumps(envelope) + "\n")
sys.stdout.flush()
try:  # history is best-effort — never break the answer on a log failure
    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    with open(logf, "a") as f:
        f.write(json.dumps({
            "ts": ts, "cid": cid or ts,  # chain id: continued -> inherited, fresh -> own ts
            "intent": intent, "model": model, "think": think == "true",
            "prompt": query, "response": text,
            "ms": ms,
        }) + "\n")
except Exception:
    pass
# The lease nudge: 3+ cold loads of this model inside 5 minutes says the user
# is in a session with it — suggest the bounded lease. Counts the log just
# written (so this call is included); never breaks the answer.
if lease_hint and mode == "text" and stats == "true" and sys.stderr.isatty():
    try:
        import calendar
        cutoff, n = time.time() - 300, 0
        with open(logf) as f:
            for ln in f.readlines()[-50:]:
                try:
                    e = json.loads(ln)
                except ValueError:
                    continue
                if e.get("model") != model:
                    continue
                if calendar.timegm(time.strptime(e["ts"], "%Y-%m-%dT%H:%M:%SZ")) >= cutoff:
                    n += 1
        if n >= 3:
            sys.stderr.write("%s· %d cold loads of %s in 5 min — lease it: %s%s\n"
                             % (dim, n, model, lease_hint, rs))
    except Exception:
        pass
PY
