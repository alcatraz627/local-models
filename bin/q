#!/usr/bin/env bash
# q — the quick local companion. Direct, usable, fast answers from the warm model.
#
#   q on | off | status            toggle / inspect Tier W (delegates to `warm`)
#   q "how do I ..."               quick answer (default intent: ask, ≤2 sentences)
#   q cmd "find procs on 8001"     a single macOS shell command, nothing else
#   q ask "what is a mutex"        short prose answer
#   q title "<text>"               a 2-5 word title (tab titles, fire-and-forget)
#   git diff | q commit            a commit message from the piped diff
#   cmd | q "summarize"            piped stdin becomes input context
#
# Machine modes (for GUI hosts / scripts — see docs/q-spec.md §API):
#   q --json --ctx - --intent summarize     one JSON object on stdout
#   q --stream-json ...                     NDJSON chunk/done/error lines
#
# Why this exists: raw `ollama run` returns essays + thinking traces + every OS. The value
# is the wrapper — a terse macOS system prompt and think:false the model can't talk its way
# out of (proven: "no thinking" in the prompt does NOT disable it; the API flag does).
set -eo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$DIR/config.sh"
# shellcheck source=/dev/null
source "$DIR/bin/_lib.sh"
wants_all "$@" && HELP_ALL=true
lm_identify

# `q intents` — list the registry (the live source of truth for intents). Defined
# early because the subcommand dispatch runs before the per-call intent helpers.
list_intents() {
  local d="$DIR/intents" f n s
  _sec INTENTS
  for f in "$d"/*.toml; do
    [ -f "$f" ] || continue
    n=$(yq -p toml -r '.name // ""' "$f" 2>/dev/null)
    s=$(yq -p toml -r '.summary // ""' "$f" 2>/dev/null)
    [ "$(yq -p toml -r '.needs_ctx // false' "$f" 2>/dev/null)" = true ] && n="$n *"
    _opt "$n" "$s"
  done
  _note '* needs a document (--ctx/--file/stdin); add one by dropping a .toml in intents/'
}

show_help() {
  printf '%s%sq%s %s— quick local LLM companion (macOS / Apple Silicon)%s\n' "$Bd" "$C" "$Rs" "$Dm" "$Rs"
  _sec USAGE
  _cmd 'q "<prompt>"'           'ask a question; an image or file path inside it is routed for you'
  _cmd 'q <intent> "<prompt>"'  'ask | cmd | commit | summarize | qa | title | review ... (q intents lists them all)'
  _cmd 'q again [--big|--code|--web]' 'the last answer was wrong: ask it again on a stronger lane (no flag: one step up; --dry-run shows the plan). q --again always works, even in a pipe'
  _cmd 'q -c [N] "<prompt>"'    'follow up on your last exchange (or entry N)'
  _cmd 'q history, show N'      'your recent queries, numbered; show -1 is your latest call (--all: anyone, not just you)'
  _sec EXAMPLES
  _ex 'q "how do I check disk usage"'        '# terse answer'
  _ex 'q cmd "kill everything on port 3001"' '# one macOS command, checked against its --help'
  _ex 'git diff | q commit'                  '# commit message from the diff'
  _ex 'q summarize --file report.pdf'        '# PDF/Word/etc extracted locally'
  _more
  _cmd 'q on | off | status'    'Tier W warm toggle (= warm)'
  _cmd 'q check "<command>"'    'check a shell command'"'"'s programs and --flags against their own help, without running it (q --check always works)'
  _cmd 'q intents'              'list available intents (the registry)'
  _cmd 'q models'               'usable models + tiers (= lm models; ● resident)'
  _ex 'q -c "and sorted by size?"'           '# follow-up with context'
  _ex 'q title "<conversation text>"'        '# 2-5 word title'
  _ex 'q describe-data --file data.csv'      '# schema + observations'
  _ex 'q --preflight --file data.xlsx --json' '# extracted size and workbook sheets, no model call'
  _ex 'q --json --ctx - qa "who signs off?" < doc.md'  '# machine mode'
  _ex 'q --think "harder reasoning task"'    '# show the thinking trace'
  _ex 'q -m qwen2.5-coder:3b cmd "..."'      '# swap model per call'
  _ex 'q show -1'                            '# your latest call, in full'
  _sec OPTIONS
  _opt '--big / --code'  'use the big (reasoning) / code tier for this call'
  _opt '--web'          'search the web first (DDG, no key) and answer from the results, cited'
  _opt '--route / --no-route' 'force or skip the automatic routing of image paths, file paths and typos'
  _opt '--diy'          'let q route itself with a planner pass: intent, web, file, tier, narrated in gray'
  _opt '-c, --continue [N]' 'continue your last exchange / entry N'
  _opt '-m, --model M'  "model or tier alias: small | big | code | sweep | <name> (default: small)"
  _opt '--think'        'show the reasoning trace (dimmed, on stderr; off by default)'
  _opt '--no-stats'     'hide the gray token line (text mode; machine modes always carry the counts)'
  _opt '--raw'          'no system prompt (bare model)'
  _opt '--json'         'machine mode: one JSON object on stdout, no ANSI'
  _opt '--stream-json'  'machine mode: NDJSON chunk/done/error lines'
  _opt '--format FILE'  'constrain output to a JSON schema (with --json: adds parsed .data)'
  _opt '--glow'         'render the reply through glow (buffers output; TTY-only, no-op without glow)'
  _opt '--ctx, --file FILE | -' 'context document from a file or stdin (- = stdin)'
  _opt '--ctx-name S'   "the document's display name (framing hint)"
  _opt '--sheet NAME|N' 'XLSX sheet to read (1-based number or name; required for multi-sheet describe-data)'
  _opt '--preflight'    'inspect extracted input, context size, and sheet selection without a model call'
  _opt '--prose'        'describe-data only: add optional model interpretation after exact profile'
  _opt '--max-ctx N'    'read at most N chars of the document (default 16000; the cut is printed)'
  _opt '--timeout S'    'wall-clock cap; structured timeout error after'
  _opt '--intent X'     'intent as a flag (same set as the positional token)'
  _opt '--all'          'with show -1, -c or history: include calls from other terminals, agents and hooks'
  list_intents   # the live registry, same source as `q intents`, never drifts
  _sec DEFAULTS
  _note 'macOS/Apple-Silicon assumed; Linux only if you say "linux server/container". Thinking off, deterministic (temp 0), never asks, logged to logs/q-history.jsonl. --ctx/--file extracts text locally: PDF (poppler), Word/RTF/HTML (textutil), xlsx (zconvert to csv), text/csv/json/code as-is; binaries refused. Large tables fail rather than truncate.'
  _sec CONFIGURATION
  _note "$DIR/config.sh (WARM_MODEL, keep-alive)"
  _help_end 'q -h'
}

LOG="$DIR/logs/q-history.jsonl"
HIST_FMT="$JQ_LOCAL_TS"'"\(.ts | lts)  \(.intent)\(if .error then " ✗" else "" end)  \(.model // "?")  \(.ms)ms  \((.prompt | gsub("\\s+"; " "))[0:50])"'
# Your newest N history rows (this terminal and session), numbered by their line in the log so
# `q show N` still works; with --all (or LM_ALL=1) every caller's rows, like `lm timeline`.
mine_history() { # N JSON(true|false)
  local n="$1" json="$2" nums k
  [[ "$n" =~ ^[0-9]+$ ]] || n=15
  [ -f "$LOG" ] || { if $json; then echo '[]'; else echo "no history yet ($LOG)"; fi; return 0; }
  lm_identify
  if [ -z "$LM_TTY$LM_SESSION" ]; then
    echo "q history: this call has no terminal, so none of the history is 'yours'. q history --all shows everything." >&2
    if $json; then echo '[]'; fi
    return 0
  fi
  nums="$(rg -n -e "\"tty\": ?\"$LM_TTY\"" ${LM_SESSION:+-e "\"session\": ?\"$LM_SESSION\""} "$LOG" 2>/dev/null | tail -n "$n" | sed 's/:.*//')" || true
  if [ -z "$nums" ]; then
    echo "q history: none of your calls from this terminal yet. q history --all shows everything." >&2
    if $json; then echo '[]'; fi
    return 0
  fi
  for k in $nums; do
    if $json; then sed -n "${k}p" "$LOG" | jq -c --argjson n "$k" '. + {n: $n}'
    else printf '%4d  ' "$k"; sed -n "${k}p" "$LOG" | jq -rR "(fromjson? | $HIST_FMT) // \"(unreadable history line)\""; fi
  done
}
show_history() {
  # gsub flattens multiline prompts (piped diffs) to ONE display line each, so
  # displayed numbers stay equal to JSONL line numbers — the show/-c contract.
  if [ "$LM_ENTRY_SCOPE" = mine ]; then mine_history "${1:-15}" false
  else jsonl_history "$LOG" "${1:-15}" "$HIST_FMT"; fi
  echo "  → q show N   for the full prompt + response of entry N"
}
show_entry() {
  jsonl_entry "$LOG" "${1:-}" \
    "$JQ_REMEDY"'"#\($i)  \(.ts)  [\(.intent)]  \(.ms)ms  \(.model)\(if .diy then "\nDIY: " + .diy.trace else "" end)\n\nPROMPT:\n\(.prompt)\n\nRESPONSE:\n\(.response)\(if .error and remedy(.error) != "" then "\n\nWHAT TO DO: " + remedy(.error) else "" end)"'
}


# ── q again: redo your last question on a stronger lane ──
# Answers are deterministic (temperature 0), so retyping the same thing gives the same
# answer. The way forward is a different lane: the big model, the code model, or the web.
again_row() { # SCOPE (mine|all) -> the newest user-facing row as JSON, or nothing
  local scope="$1"
  [ -f "$LOG" ] || return 0
  if [ "$scope" = all ]; then tail -n 80 "$LOG"
  else
    [ -n "$LM_TTY$LM_SESSION" ] || return 0
    rg -e "\"tty\": ?\"$LM_TTY\"" ${LM_SESSION:+-e "\"session\": ?\"$LM_SESSION\""} "$LOG" 2>/dev/null | tail -n 40 || true
  fi | jq -cR 'fromjson? | select(.intent != "title" and .intent != "diy-plan" and .error == null)' | tail -n 1
}
again_run() {
  local dry=false lane="" scope="$LM_ENTRY_SCOPE" row plan intent ask name last_model was nice
  local -a passthru=() args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --big|--code|--web) lane="$1"; shift ;;
      --all) scope=all; shift ;;
      --dry-run) dry=true; shift ;;
      -h|--help) show_help; return 0 ;;
      *) passthru+=("$1"); shift ;;
    esac
  done
  row="$(again_row "$scope")"
  if [ -z "$row" ]; then
    echo "q again: none of your calls from this terminal to repeat (q again --all takes the newest from anyone)" >&2; return 2
  fi
  plan="$(printf '%s' "$row" | python3 -c '
import sys, json, re
r = json.load(sys.stdin)
p = r.get("prompt") or ""
ask = "" if p.startswith("<input") else p.split("\n\n<input")[0]
ask = re.sub(r"\n\n\(Note from the runtime:[^\n]*\)$", "", ask)   # rows logged before notes stopped being stored
name = doc = ""
for m in re.finditer(r"<input name=\"([^\"]*)\"[^>]*>\n(.*?)\n</input>", p, re.S):
    if m.group(1) in ("web-results", "local-probe"):
        continue
    name, doc = m.group(1), m.group(2)
    break
if not doc:
    m = re.search(r"<input>\n(.*?)\n</input>", p, re.S)
    if m:
        doc = m.group(1)
print(json.dumps({"ask": ask, "intent": r.get("intent", "ask"), "model": r.get("model", ""),
                  "name": name, "doc": doc, "web": "<input name=\"web-results\"" in p}))')"
  intent="$(printf '%s' "$plan" | jq -r .intent)"; ask="$(printf '%s' "$plan" | jq -r .ask)"
  name="$(printf '%s' "$plan" | jq -r .name)"; last_model="$(printf '%s' "$plan" | jq -r .model)"
  was=small; [ "$last_model" = "$(resolve_tier big)" ] && was=big
  [ "$last_model" = "$(resolve_tier code)" ] && was=code
  [ "$(printf '%s' "$plan" | jq -r .web)" = true ] && was="$was+web"
  if [ -z "$lane" ]; then
    # With no lane named, take one step up the local ladder. Going off this Mac is always asked for by name.
    if [ "$was" = small ]; then lane=--big
    else echo "q again: the last answer already used $was. Name a lane: q again --web (sends the question off this Mac) or --code" >&2; return 2; fi
  fi
  args=(--intent "$intent" "$lane")
  [ -n "$name" ] && args+=(--ctx - --ctx-name "$name")
  nice="${ask:0:50}"; [ -n "$nice" ] || nice="$intent ${name}"
  nice="${nice//$'\n'/ }"; nice="${nice//$'\t'/ }"   # the narration stays one line
  if [ -t 2 ] && use_color_fd 2; then printf '\033[2m· again: "%s" (was %s) → %s\033[0m\n' "$nice" "$was" "${lane#--}" >&2
  else printf '· again: "%s" (was %s) → %s\n' "$nice" "$was" "${lane#--}" >&2; fi
  $dry && return 0   # shows the narration above and runs nothing
  if [ -n "$name" ]; then
    printf '%s' "$plan" | jq -r .doc | Q_AGAIN=1 "$0" "${args[@]}" ${passthru[@]+"${passthru[@]}"} ${ask:+"$ask"}
  else
    Q_AGAIN=1 "$0" "${args[@]}" ${passthru[@]+"${passthru[@]}"} ${ask:+"$ask"} </dev/null
  fi
}

# Subcommands: help, history, show, again, and the warm toggle.
# `again` and `check` are subcommands only when a person is typing (stdin is a terminal). With no
# terminal they are ordinary prompts, as before; --again and --check always dispatch.
case "${1:-}" in
  --again)               shift; again_run "$@"; exit $? ;;
  --check)               shift; exec python3 "$DIR/lib/cmdcheck.py" "$@" ;;
  again)                 if [ -t 0 ]; then shift; again_run "$@"; exit $?; fi ;;
  check)                 if [ -t 0 ]; then shift; exec python3 "$DIR/lib/cmdcheck.py" "$@"; fi ;;
  -h|--help|help)        show_help; exit 0 ;;
  history)               shift
                         HIST_JSON=false; HIST_N=15
                         for harg in "$@"; do case "$harg" in -h|--help) show_help; exit 0 ;; --json) HIST_JSON=true ;; --all) LM_ENTRY_SCOPE=all ;; *) HIST_N="$harg" ;; esac; done
                         if $HIST_JSON; then
                           if [ "$LM_ENTRY_SCOPE" = mine ]; then mine_history "$HIST_N" true; else jsonl_history_json "$LOG" "$HIST_N"; fi
                           exit 0
                         fi
                         show_history "$HIST_N"; exit 0 ;;
  show)                  shift
                         SHOW_N=""
                         for sarg in "$@"; do case "$sarg" in -h|--help) show_help; exit 0 ;; --all) LM_ENTRY_SCOPE=all ;; *) SHOW_N="$sarg" ;; esac; done
                         show_entry "$SHOW_N"; exit $? ;;
  intents)               list_intents; exit 0 ;;
  models)                exec "$DIR/bin/lm" models "${@:2}" ;;
  on|off|status|restart) exec "$DIR/bin/warm" "$@" ;;
esac

# resolve_tier (small/big/code → real names) lives in _lib.sh — shared with lib/fleet.

# Intents are data: intents/<name>.toml = {name, summary, needs_ctx, system_prompt}.
# Adding an intent is dropping a file — bin/q reads the registry, nothing is hardcoded.
INTENT_DIR="$DIR/intents"
intent_exists()    { [ -f "$INTENT_DIR/$1.toml" ]; }
intent_sys()       { yq -p toml -r '.system_prompt // ""' "$INTENT_DIR/$1.toml" 2>/dev/null; }
intent_needs_ctx() { [ "$(yq -p toml -r '.needs_ctx // false' "$INTENT_DIR/$1.toml" 2>/dev/null)" = true ]; }
intent_handler()   { yq -p toml -r '.handler // "model"' "$INTENT_DIR/$1.toml" 2>/dev/null; }

MODEL="$WARM_MODEL"
THINK=false
INTENT=ask
RAW=false
MODE=text          # text (human) | json (one object) | stream (NDJSON)
CTX_FILE=""; CTX_NAME=""; MAX_CTX=16000; TIMEOUT=0; FORMAT_FILE=""; GLOW=false
SHEET=""; PREFLIGHT=false; PROSE=false
CONT=false; CONT_N=""; USER_MODEL=false; USER_INTENT=false
STATS=true         # gray token line at the end (text mode); --no-stats mutes
WEB=false          # --web: search + feed results as context (conductor fetches)
WEB_QUERY=""       # focused query (set by --diy's plan; --web defaults to the prompt)
DIY=false          # --diy: a planner pass picks intent/web/file/tier from the prompt

# Pull leading flags; everything else is positional.
positionals=()
FLAGGED=false      # any flag beyond display ones turns routing off: flags keep their exact meaning
ROUTE_FORCE=false; NO_ROUTE=false
while [ $# -gt 0 ]; do
  case "$1" in --no-stats|--glow|--think|--all|--route|--no-route|--|-h|--help) ;; -*) FLAGGED=true ;; esac
  case "$1" in
    --route) ROUTE_FORCE=true; shift ;;
    --no-route) NO_ROUTE=true; shift ;;
    --) shift; positionals+=("$@"); SAW_DD=true; break ;;
    --think) THINK=true; shift ;;
    --raw)   RAW=true; shift ;;
    --web)   WEB=true; shift ;;
    --diy)   DIY=true; shift ;;
    --no-stats) STATS=false; shift ;;
    --all)   LM_ENTRY_SCOPE=all; shift ;;
    --json)        MODE=json; shift ;;
    --stream-json) MODE=stream; shift ;;
    --big)   MODEL="$(resolve_tier big)";  USER_MODEL=true; shift ;;
    --code)  MODEL="$(resolve_tier code)"; USER_MODEL=true; shift ;;
    --format)   need_arg q "$1" "${2:-}"; FORMAT_FILE="$2"; shift 2 ;;
    --glow)     GLOW=true; shift ;;
    --ctx|--file) need_arg q "$1" "${2:-}"; CTX_FILE="$2"; shift 2 ;;
    --ctx-name) need_arg_present q "$1" "$#"; CTX_NAME="$2"; shift 2 ;;
    --sheet)    need_arg q "$1" "${2:-}"; SHEET="$2"; shift 2 ;;
    --preflight) PREFLIGHT=true; shift ;;
    --prose) PROSE=true; shift ;;
    --max-ctx)  need_arg q "$1" "${2:-}"; MAX_CTX="$2"; shift 2 ;;
    --timeout)  need_arg q "$1" "${2:-}"; TIMEOUT="$2"; shift 2 ;;
    --intent)   need_arg q "$1" "${2:-}"; INTENT="$2"; USER_INTENT=true; shift 2 ;;
    -c|--continue)
      CONT=true
      if [[ "${2:-}" =~ ^[0-9]+$ ]]; then CONT_N="$2"; shift 2; else shift; fi ;;
    -m|--model) need_arg q "$1" "${2:-}"; MODEL="$(resolve_tier "$2")"; USER_MODEL=true; shift 2 ;;
    -h|--help) show_help; exit 0 ;;
    *) reject_unknown_flag q "$1"; positionals+=("$1"); shift ;;
  esac
done

# Routing: for a plain prompt typed by a person (text mode, no flags, a terminal on stdin),
# cheap checks run before any model call. See the ROUTE block below. Machine modes, flags,
# --diy (which has its own planner) and `--` never route; --route forces it, --no-route stops it.
ROUTE=false
if ! $NO_ROUTE && [ -z "${Q_NO_ROUTE:-}" ] && [ -z "${SAW_DD:-}" ] && [ "$MODE" = text ] && ! $DIY; then
  if $ROUTE_FORCE || { ! $FLAGGED && [ -t 0 ]; }; then ROUTE=true; fi
fi

# A leading intent token selects the intent (if it's a registered intent); rest is the query.
if [ "${#positionals[@]}" -gt 0 ] && intent_exists "${positionals[0]}"; then
  INTENT="${positionals[0]}"; USER_INTENT=true; positionals=("${positionals[@]:1}"); ROUTE=false
elif ! $ROUTE && [ "${#positionals[@]}" -eq 1 ] && [ -z "${SAW_DD:-}" ] && [[ "${positionals[0]}" =~ ^[A-Za-z][A-Za-z-]{2,}$ ]]; then
  # A lone word one typo away from an intent is almost surely that intent; sending
  # it as a prompt would cost a model call. `--` or `q ask ...` sends it anyway.
  _names=$(cd "$INTENT_DIR" && ls ./*.toml 2>/dev/null | sed 's|^\./||;s|\.toml$||')
  # shellcheck disable=SC2086
  _guess=$(did_you_mean "${positionals[0]}" $_names)
  if [ -n "$_guess" ]; then
    echo "q: '${positionals[0]}' is not an intent. Did you mean '$_guess'? (q intents lists them; q ask \"${positionals[0]}\" sends it as a prompt)" >&2
    exit 2
  fi
fi
QUERY="${positionals[*]}"

# ── ROUTE: send a plain request to the right place before spending a model call ──
# Everything here is a deterministic check; each hit is narrated in one gray stderr line.
# An image path goes to `see` (which reads text exactly first), a file path becomes
# --ctx, a near-miss intent word is called out (and runs as ask), and a leading
# "gemini"/"web" is pointed at the lanes that really search.
if $ROUTE && [ "${#positionals[@]}" -gt 0 ]; then
  _dim=""; _rs=""; use_color_fd 2 && { _dim=$'\033[2m'; _rs=$'\033[0m'; }
  route_say() { printf '%s· %s%s\n' "$_dim" "$1" "$_rs" >&2; }
  RAW_PROMPT="${positionals[*]}"
  _first="${RAW_PROMPT%%[[:space:]]*}"
  if [[ "$_first" =~ ^[A-Za-z][A-Za-z-]{3,}$ ]]; then
    _names=$(cd "$INTENT_DIR" && ls ./*.toml 2>/dev/null | sed 's|^\./||;s|\.toml$||')
    # shellcheck disable=SC2086
    _guess=$(did_you_mean "$_first" $_names)
    [ -z "$_guess" ] || route_say "'$_first' is not an intent; did you mean 'q $_guess'? Running it as a plain question."
  fi
  case "$(printf '%s' "$_first" | tr 'A-Z' 'a-z')" in
    gemini|web|google|search)
      route_say "'$_first' at the start does not search anything. Answering locally. For the web: q --web \"...\"; for Gemini: lm gemini \"...\" (both send the question off this Mac)" ;;
  esac
  if [ -z "$CTX_FILE" ]; then
    _missing=""
    set -f
    for _w in $RAW_PROMPT; do
      _wc="${_w%[,.;:!?\"\')]}"; _wc="${_wc#[\"\'(]}"
      lm_file_ref "$_wc" || continue
      _wx="${_wc/#\~/$HOME}"
      if [ ! -f "$_wx" ]; then
        case "$_wc" in /*|"~/"*|./*|../*) [ -e "$_wx" ] || [ -n "$_missing" ] || _missing="$_wc" ;; esac
        continue
      fi
      case "$(file -b --mime-type "$_wx" 2>/dev/null)" in
        image/*)
          set +f
          route_say "image in the prompt → see ($(basename "$_wx")); text, IDs and counts are read exactly first"
          exec "$DIR/bin/see" "$_wx" "$RAW_PROMPT" ;;
      esac
      case "$(printf '%s' "${_wx##*.}" | tr 'A-Z' 'a-z')" in
        pdf|doc|docx|rtf|odt|html|htm|xlsx) CTX_FILE="$_wx"; break ;;
      esac
      if [ "$(file -b --mime-encoding "$_wx" 2>/dev/null)" != binary ]; then CTX_FILE="$_wx"; break; fi
    done
    set +f
    if [ -n "$CTX_FILE" ]; then
      route_say "file in the prompt → reading $(basename "$CTX_FILE") as context (the same as --ctx)"
    elif [ -n "$_missing" ]; then
      route_say "no file at \"$_missing\"; telling the model so"
      # The model gets the note; history keeps only what the person typed.
      export Q_RUNTIME_NOTE="(Note from the runtime: no file exists at \"$_missing\"; say so plainly.)"
    fi
  fi
fi

# Structured failure for machine modes; plain stderr for humans. The error CODES
# and exit codes are the extension contract (q-spec §API) — never branch on text.
emit_error() { # CODE MESSAGE EXIT
  case "$MODE" in
    stream) jq -cn --arg c "$1" --arg m "$2" '{t:"error", code:$c, message:$m}' ;;
    json)   lm_err_json "$1" "$2" ;;
    *)      echo "q: $2" >&2; lm_fix_line "$1" ;;
  esac
  exit "$3"
}

# Cancellation must hold during the bash phase too (ctx reads, preflight curl);
# python replaces this with its own handlers the moment it execs.
trap 'emit_error cancelled "cancelled by client" 130' TERM INT

# Numeric flags are part of the machine contract — garbage must be a structured
# error, not a bash arithmetic stderr leak or an uncaught python ValueError.
[[ "$MAX_CTX" =~ ^[0-9]+$ ]] || emit_error invalid_args "--max-ctx must be a non-negative integer, got '$MAX_CTX'" 2
[[ "$TIMEOUT" =~ ^[0-9]+([.][0-9]+)?$ ]] || emit_error invalid_args "--timeout must be seconds (number), got '$TIMEOUT'" 2

# ── --diy: plan, then execute ──
# The warm model reads the prompt and emits a PLAN as schema-constrained data
# (intents/diy-plan.toml + .schema.json); THIS script validates and executes it.
# Capability selection belongs to the model, execution stays with the conductor
# (docs/03) — and every step is narrated on the gray stderr channel, so nothing
# needs permission and nothing happens silently. Explicit flags always win:
# a user-chosen intent/model/ctx is never overridden by the plan.
if $DIY && [ "${#positionals[@]}" -gt 0 ]; then
  _dim=""; _rs=""; use_color_fd 2 && { _dim=$'\033[2m'; _rs=$'\033[0m'; }
  PLAN_ENV="$("$0" --json --no-stats --timeout 25 --intent diy-plan \
    --format "$INTENT_DIR/diy-plan.schema.json" "$QUERY" 2>/dev/null)" || PLAN_ENV=""
  PLAN="$(printf '%s' "$PLAN_ENV" | jq -c '.data // empty' 2>/dev/null)"
  if [ -n "$PLAN" ]; then
    p_intent=$(printf '%s' "$PLAN" | jq -r '.intent // "ask"')
    p_web=$(printf '%s' "$PLAN" | jq -r '.needs_web // false')
    p_wq=$(printf '%s' "$PLAN" | jq -r '.web_query // ""')
    p_file=$(printf '%s' "$PLAN" | jq -r '.file_path // ""')
    p_img=$(printf '%s' "$PLAN" | jq -r '.image_path // ""')
    p_probe=$(printf '%s' "$PLAN" | jq -r '.local_probe // ""')
    p_tier=$(printf '%s' "$PLAN" | jq -r '.tier // "small"')
    p_why=$(printf '%s' "$PLAN" | jq -r '.reason // ""')
    trace="· diy: ${p_why:-routed} → intent=$p_intent · tier=$p_tier"
    # An image prompt is a job for `see`, not q — hand the whole call over.
    if [ -n "$p_img" ]; then
      p_img_x="${p_img/#\~/$HOME}"
      if [ -f "$p_img_x" ]; then
        [ "$MODE" = text ] && printf '%s%s · image → see%s\n' "$_dim" "$trace" "$_rs" >&2
        exec "$DIR/bin/see" "$p_img_x" "$QUERY"
      fi
    fi
    $USER_INTENT || { intent_exists "$p_intent" && INTENT="$p_intent"; }
    $USER_MODEL  || MODEL="$(resolve_tier "$p_tier")"
    if [ "$p_web" = true ]; then
      # A shell-command answer is composed offline; search results only
      # contaminate it (observed: a stray repo from the results got cloned
      # into the command). Honor web for cmd only with a focused query.
      if [ "$p_intent" = cmd ] && [ -z "$p_wq" ]; then
        trace="$trace · web dropped (cmd composes offline)"
      else
        WEB=true; WEB_QUERY="$p_wq"
        wq_disp="${p_wq:-(the prompt)}"; trace="$trace · web=\"${wq_disp:0:48}\""
      fi
    fi
    if [ -n "$p_file" ] && [ -z "$CTX_FILE" ]; then
      p_file_x="${p_file/#\~/$HOME}"
      if [ -f "$p_file_x" ]; then CTX_FILE="$p_file_x"; trace="$trace · file=$(basename "$p_file_x")"
      else trace="$trace · file=$p_file (not found, skipped)"; fi
    fi
    # Probe scan: like the file scan, extraction beats model recall — when the
    # prompt asks about a version and names a word that IS an installed command,
    # that's the probe, whether or not the planner said so.
    RAW_PROMPT="${positionals[*]}"   # scans read the user's words, never the assembled query
    if [ -z "$p_probe" ] && [[ "$RAW_PROMPT" == *ersion* ]]; then
      set -f
      for w in $RAW_PROMPT; do
        w_c="${w%%[,.;:!?\"\')]}"
        w_lc="$(printf '%s' "$w_c" | tr 'A-Z' 'a-z')"
        case "$w_lc" in
          ''|?|??|the|and|check|latest|local|online|tell|have|one|version|not|now|are|was|what|which|with|from|test|time|man|cat|find|open|of|is|installed|on|this|mac) continue ;;
        esac
        if command -v "$w_c" >/dev/null 2>&1; then p_probe="$w_c --version"; break; fi
      done
      set +f
    fi
    # OS-version asks have no command word to scan for — a fixed two-entry map
    # covers the macOS case ("what macOS do I have") with the bare-but-safe
    # sw_vers, which the strict shape below would otherwise refuse.
    if [ -z "$p_probe" ]; then
      case "$(printf '%s' "$RAW_PROMPT" | tr 'A-Z' 'a-z')" in
        *"mac os"*|*macos*|*"os x"*|*osx*) [[ "$RAW_PROMPT" == *ersion* ]] && p_probe="sw_vers" ;;
      esac
    fi
    # Local probe: version/status of an installed tool, model-suggested but
    # conductor-VALIDATED — strict shape (one bare command + one version verb)
    # or an exact entry in the tiny bare-probe whitelist; command must exist,
    # 5s cap. Output rides into the prompt as ground truth. Anything outside
    # is refused with a trace, never run.
    if [ -n "$p_probe" ]; then
      case "$p_probe" in
        sw_vers|"uname -r") : ;;   # whitelisted bare probes (no version verb exists)
        *) if ! [[ "$p_probe" =~ ^([A-Za-z0-9_.-]+)\ (--version|-V|version)$ ]]; then p_probe="__rejected__:$p_probe"; fi ;;
      esac
    fi
    if [ -n "$p_probe" ] && [ "${p_probe#__rejected__:}" = "$p_probe" ]; then
      probe_cmd="${p_probe%% *}"; probe_arg="${p_probe#* }"; [ "$probe_arg" = "$p_probe" ] && probe_arg=""
      if command -v "$probe_cmd" >/dev/null 2>&1; then
        # shellcheck disable=SC2086 — probe_arg is one validated verb, not user input
        PROBE_OUT="$(perl -e 'my $p=fork; if($p==0){setpgrp(0,0); exec(@ARGV) or exit 127} local $SIG{ALRM}=sub{kill "KILL",-$p}; alarm 5; waitpid($p,0); exit(($? & 127) ? 124 : ($? >> 8))' \
                     "$probe_cmd" $probe_arg 2>&1 | head -3)" || PROBE_OUT=""
        if [ -n "$PROBE_OUT" ]; then
          QUERY="$QUERY

<input name=\"local-probe\" cmd=\"$p_probe\">
$PROBE_OUT
</input>"
          trace="$trace · probe=\`$p_probe\`"
          # A version-compare needs a focused search, and the probe names the
          # subject better than the user's sentence ever will.
          if $WEB && [ -z "$WEB_QUERY" ]; then
            WEB_QUERY="$probe_cmd latest version release"
            trace="$trace · web→\"$WEB_QUERY\""
          fi
        else
          trace="$trace · probe=\`$p_probe\` (no output, skipped)"
        fi
      else
        trace="$trace · probe skipped ('$probe_cmd' not installed)"
      fi
    elif [ -n "$p_probe" ]; then
      trace="$trace · probe rejected (\"${p_probe#__rejected__:}\" outside the safe shape)"
    fi
    # Deterministic assist: the planner sometimes misses a path the prompt
    # plainly names — the conductor greps the prompt words for a real file
    # (tolerating trailing punctuation). Images hand the whole call to `see`;
    # readable text loads as context; a named path that does NOT exist gets an
    # honest note so the answer says "no such file", not "I cannot access files".
    # Models suggest, the script verifies (and beats them at exact).
    if [ -z "$CTX_FILE" ]; then
      missing_note=""
      set -f
      for w in $RAW_PROMPT; do
        w_clean="${w%%[,.;:!?\"\')]}"
        w_x="${w_clean/#\~/$HOME}"
        if [ ! -f "$w_x" ]; then
          # Path-shaped but absent → remember the first one for the honesty note.
          case "$w_clean" in
            */*|*.png|*.jpg|*.jpeg|*.webp|*.pdf|*.md|*.txt|*.csv|*.json)
              [ -n "$missing_note" ] || { [ -e "$w_x" ] || missing_note="$w_clean"; } ;;
          esac
          continue
        fi
        case "$(file -b --mime-type "$w_x" 2>/dev/null)" in
          image/*)
            if [ "$MODE" = text ]; then printf '%s%s · image=%s (prompt-scan) → see%s\n' "$_dim" "$trace" "$(basename "$w_x")" "$_rs" >&2; fi
            set +f
            exec "$DIR/bin/see" "$w_x" "$QUERY" ;;
        esac
        if [ "$(file -b --mime-encoding "$w_x" 2>/dev/null)" != binary ]; then
          CTX_FILE="$w_x"; missing_note=""; trace="$trace · file=$(basename "$w_x") (prompt-scan)"; break
        fi
      done
      set +f
      if [ -n "$missing_note" ]; then
        QUERY="$QUERY

(Note from the runtime: no file exists at \"$missing_note\" — say so plainly.)"
        trace="$trace · file=$missing_note NOT FOUND"
      fi
    fi
    # Web questions routed to a document intent with no document resolve to ask
    # HERE, silently — the final trace line shows the real intent, instead of a
    # second "doc-intent w/o doc" line on every web question. The ctx gate stays
    # as the backstop for the rare non-web case (piped docs arrive after this).
    if $WEB && intent_needs_ctx "$INTENT" && [ -z "$CTX_FILE" ]; then INTENT=ask; fi
    trace="${trace/intent=$p_intent/intent=$INTENT}"  # reflect the resolution in the line
    # The routing is history too (histories are the API): q show N explains why
    # a past answer searched, probed, or loaded a file.
    DIY_LOG="$(jq -cn --argjson plan "${PLAN:-null}" --arg trace "$trace" '{plan:$plan, trace:$trace}' 2>/dev/null)" || DIY_LOG=""
    if [ "$MODE" = text ]; then printf '%s%s%s\n' "$_dim" "$trace" "$_rs" >&2; fi
  else
    if [ "$MODE" = text ]; then printf '%s· diy: planner unavailable — running plain%s\n' "$_dim" "$_rs" >&2; fi
  fi
fi

# Numeric table description uses a parser for facts, not a model for arithmetic.
# Run before the generic context cap: a row count from a prefix is a false fact.
if [ "$(intent_handler "$INTENT")" = tabular-profile ] && ! $PREFLIGHT; then
  [ -z "$QUERY" ] || emit_error invalid_args "describe-data is a deterministic table profile; use qa --ctx for a custom question" 2
  [ -z "$FORMAT_FILE" ] || emit_error invalid_args "describe-data returns a fixed .data profile; --format is for model intents" 2
  if [ -z "$CTX_FILE" ]; then
    [ -t 0 ] && emit_error ctx_required "describe-data needs --ctx FILE or piped CSV/TSV/JSON" 2
    CTX_FILE=-
  fi
  profile_args=(--input "$CTX_FILE" --mode "$MODE" --log "$LOG")
  [ -n "$SHEET" ] && profile_args+=(--sheet "$SHEET")
  if $PROSE; then
    [ "$MODE" != stream ] || emit_error invalid_args "--prose does not support --stream-json; use --json" 2
    profile_args=(--input "$CTX_FILE" --mode json --log "$LOG")
    [ -n "$SHEET" ] && profile_args+=(--sheet "$SHEET")
    profile="$(python3 "$DIR/lib/data-profile.py" "${profile_args[@]}")" || exit $?
    [ "$(printf '%s' "$profile" | jq -r '.ok')" = true ] || { printf '%s\n' "$profile"; exit 12; }
    model_reply="$(printf '%s' "$profile" | jq -r .text | "$DIR/bin/q" --json --ctx - -m "$MODEL" qa \
      "Suggest up to three useful patterns or follow-up checks from this exact table profile. Treat its counts and extrema as authoritative. Say when the profile alone cannot support an inference.")" || exit $?
    if [ "$MODE" = json ]; then
      jq -cn --argjson profile "$profile" --argjson reply "$model_reply" \
        '$profile + {prose: $reply.text, prose_model: $reply.model, prose_verified: false}'
    else
      printf '%s\n\nInterpretation (model suggestion; check against source):\n%s\n' \
        "$(printf '%s' "$profile" | jq -r .text)" "$(printf '%s' "$model_reply" | jq -r .text)"
    fi
    exit 0
  fi
  exec python3 "$DIR/lib/data-profile.py" "${profile_args[@]}"
fi
[ "$PROSE" = false ] || emit_error invalid_args "--prose applies only to describe-data" 2

# Constrained decoding: --format FILE passes a JSON schema to Ollama's `format`
# field, so the model's output IS schema-valid JSON. In --json mode the envelope
# gains a `data` field with that output pre-parsed.
FORMAT=""
if [ -n "$FORMAT_FILE" ]; then
  [ -f "$FORMAT_FILE" ] || emit_error format_unreadable "no such schema file: $FORMAT_FILE" 12
  FORMAT="$(jq -c . "$FORMAT_FILE" 2>/dev/null)" \
    || emit_error format_invalid "schema is not valid JSON: $FORMAT_FILE" 12
fi

# Context document: --ctx - (stdin) · --ctx/--file FILE · or bare non-TTY stdin.
# Rich formats (PDF, Word, RTF) are extracted to text LOCALLY — no cloud, ever —
# so "summarize this PDF" works instead of feeding the model raw bytes. Each
# emit_error runs in THIS scope (the `||`), so its exit actually stops q; calling
# it inside a `$(...)` would only kill the subshell and swallow the error frame.
CTX=""; TRUNC=false
if [ "$CTX_FILE" = "-" ]; then
  CTX="$(cat)"
elif [ -n "$CTX_FILE" ]; then
  [ -f "$CTX_FILE" ] || emit_error ctx_unreadable "no such file: $CTX_FILE" 12
  # Empty file first — else `file --mime-encoding` reports a 0-byte .txt as
  # "binary" and we'd refuse it with a misleading reason.
  [ -s "$CTX_FILE" ] || emit_error ctx_empty "file is empty: $CTX_FILE" 12
  ext="$(printf '%s' "${CTX_FILE##*.}" | tr 'A-Z' 'a-z')"
  [ -z "$SHEET" ] || [ "$ext" = xlsx ] || emit_error invalid_args "--sheet applies only to XLSX files" 2
  case "$ext" in
    pdf)
      command -v pdftotext >/dev/null \
        || emit_error ctx_unsupported "reading PDF needs poppler — 'brew install poppler'" 12
      CTX="$(pdftotext -q -nopgbrk "$CTX_FILE" - 2>/dev/null)" \
        || emit_error ctx_unsupported "pdftotext failed on $CTX_FILE" 12 ;;
    doc|docx|rtf|odt|html|htm)
      CTX="$(textutil -convert txt -stdout "$CTX_FILE" 2>/dev/null)" \
        || emit_error ctx_unsupported "could not extract text from .$ext file" 12 ;;
    xlsx)
      # A spreadsheet is a zip, so the raw bytes read as binary and used to be
      # refused. Convert to CSV locally (zconvert) so the model sees real rows.
      if $PREFLIGHT; then
        sheet_info="$(python3 "$DIR/lib/data-profile.py" --input "$CTX_FILE" --sheets-only)" \
          || emit_error ctx_unsupported "could not read XLSX sheet list: $CTX_FILE" 12
        sheets="$(printf '%s' "$sheet_info" | jq -c '.sheets')"
        [ "$(printf '%s' "$sheets" | jq 'length')" -gt 0 ] \
          || emit_error ctx_empty "workbook has no sheets: $CTX_FILE" 12
        if [ -n "$SHEET" ]; then
          selected="$(printf '%s' "$sheets" | jq -c --arg s "$SHEET" 'if ($s | test("^[0-9]+$")) then .[($s | tonumber) - 1] // null else map(select(. == $s))[0] // null end')"
          [ "$selected" != null ] || emit_error sheet_missing "no sheet named or numbered '$SHEET'" 12
          SHEET="$(printf '%s' "$selected" | jq -r '.')"
        elif [ "$(printf '%s' "$sheets" | jq 'length')" -gt 1 ]; then
          if [ "$MODE" = json ] || [ "$MODE" = stream ]; then
            jq -cn --arg name "${CTX_NAME:-$(basename "$CTX_FILE")}" --argjson sheets "$sheets" --argjson max "$MAX_CTX" \
              '{ok:true,format:"xlsx",source:$name,sheets:$sheets,selected_sheet:null,sheet_required:true,extracted_chars:null,estimated_tokens:null,max_ctx_chars:$max,would_truncate:null}' \
              | if [ "$MODE" = stream ]; then jq -c '{t:"done",data:.}'; else cat; fi
          else
            printf '%s: workbook sheets: %s; select one with --sheet NAME or number to measure extracted size\n' \
              "${CTX_NAME:-$(basename "$CTX_FILE")}" "$(printf '%s' "$sheets" | jq -r 'join(", ")')"
          fi
          exit 0
        else
          selected="$(printf '%s' "$sheets" | jq '.[0]')"
        fi
      fi
      command -v zconvert >/dev/null \
        || emit_error ctx_unsupported "reading a spreadsheet needs zconvert (the tabular converter)" 12
      _xdir="$(mktemp -d "${TMPDIR:-/tmp}/q-xlsx-XXXXXX")"
      sheet_args=(); [ -n "$SHEET" ] && sheet_args=(--sheet "$SHEET")
      if zconvert "$CTX_FILE" "$_xdir/sheet.csv" "${sheet_args[@]}" >/dev/null 2>&1; then
        CTX="$(cat "$_xdir/sheet.csv" 2>/dev/null)"
      else
        rm -rf "$_xdir" 2>/dev/null
        emit_error ctx_unsupported "zconvert could not read $CTX_FILE to CSV (a multi-sheet book may need one sheet exported)" 12
      fi
      rm -rf "$_xdir" 2>/dev/null ;;
    xls|xlsm)
      emit_error ctx_unsupported ".$ext spreadsheets are not supported by zconvert; export as .xlsx or .csv first" 12 ;;
    *)
      # Refuse binaries rather than feed garbage. `file --mime-encoding` is the
      # right tool — a NUL-only sniff misses NUL-free binaries (200 random bytes
      # slipped through in testing: ~46% have no NUL in the sample).
      enc=$(file -b --mime-encoding "$CTX_FILE" 2>/dev/null)
      [ "$enc" = binary ] && emit_error ctx_binary "'$CTX_FILE' looks binary ($(file -b "$CTX_FILE" 2>/dev/null)) — extract text first" 12
      CTX="$(cat "$CTX_FILE")" || emit_error ctx_unreadable "could not read $CTX_FILE" 12 ;;
  esac
  # A real file that extracted to nothing (scanned/image-only PDF, empty doc).
  if [ -z "$CTX" ] && [ -s "$CTX_FILE" ]; then
    emit_error ctx_empty "no extractable text in $CTX_FILE (scanned PDF / image-only?)" 12
  fi
  [ -n "$CTX_NAME" ] || CTX_NAME="$(basename "$CTX_FILE")"
elif [ ! -t 0 ]; then
  CTX="$(cat)"
fi
if $PREFLIGHT; then
  [ -n "$CTX" ] || emit_error ctx_required "preflight needs --ctx FILE or piped input" 2
  source_format="$(printf '%s' "${CTX_FILE##*.}" | tr 'A-Z' 'a-z')"
  [ "$CTX_FILE" = - ] && source_format=stdin
  [ -z "$CTX_FILE" ] && source_format=stdin
  sheets="${sheets:-[]}"; selected="${selected:-null}"
  if [ "$source_format" = xlsx ]; then
    : "${selected:?XLSX sheet must be selected before conversion}"
  fi
  chars=${#CTX}; tokens=$(( (chars + 3) / 4 ))
  truncated=false; [ "$chars" -gt "$MAX_CTX" ] && truncated=true
  if [ "$MODE" = json ] || [ "$MODE" = stream ]; then
    jq -cn --arg fmt "$source_format" --arg name "${CTX_NAME:-stdin}" --argjson sheets "$sheets" --argjson selected "$selected" \
      --argjson chars "$chars" --argjson tokens "$tokens" --argjson max "$MAX_CTX" --argjson truncated "$truncated" \
      '{ok:true, format:$fmt, source:$name, sheets:$sheets, selected_sheet:$selected, sheet_required:false, extracted_chars:$chars, estimated_tokens:$tokens, max_ctx_chars:$max, would_truncate:$truncated}' \
      | if [ "$MODE" = stream ]; then jq -c '{t:"done", data:.}'; else cat; fi
  else
    printf '%s: %s extracted chars (~%s tokens); context limit %s chars%s\n' "${CTX_NAME:-stdin}" "$chars" "$tokens" "$MAX_CTX" "$([ "$truncated" = true ] && echo ' (would truncate)' || true)"
    [ "$source_format" = xlsx ] && printf 'sheets: %s; selected: %s\n' "$(printf '%s' "$sheets" | jq -r 'join(", ")')" "$(printf '%s' "$selected" | jq -r '.')"
  fi
  exit 0
fi
if [ -n "$CTX" ]; then
  # 400k chars (~25x the default window) means a binary or a mistake — refuse
  # rather than silently summarize 4% of it.
  [ "${#CTX}" -gt 400000 ] && emit_error ctx_too_large "document is ${#CTX} chars (hard cap 400000)" 12
  if [ "${#CTX}" -gt "$MAX_CTX" ]; then
    [ "$INTENT" = describe-data ] && emit_error ctx_truncated "describe-data needs the whole table to report size and outliers; input has ${#CTX} characters, limit is $MAX_CTX. Narrow the table or raise --max-ctx only if the model can fit it." 12
    _ctx_total=${#CTX}
    CTX="${CTX:0:$MAX_CTX}"; TRUNC=true
    if [ "$MODE" = text ]; then
      # Say it to the person, not only to the model: a summary of 65% of a file reads as the whole thing.
      _fmt() { printf '%s' "$1" | awk '{s=$0; r=""; while (length(s) > 3) {r="," substr(s, length(s)-2) r; s=substr(s, 1, length(s)-3)} print s r}'; }
      _d=""; _r=""; use_color_fd 2 && { _d=$'\033[2m'; _r=$'\033[0m'; }
      if [ "$_ctx_total" -le 28000 ]; then _more_hint="the whole file: --max-ctx $(( (_ctx_total + 999) / 1000 * 1000 ))"
      else _more_hint="too big for the small model in one go; try --big, or cat FILE | lm gemini \"...\" (that leaves this Mac)"; fi
      printf '%s· read %s of %s chars (%s%%); %s%s\n' "$_d" "$(_fmt "$MAX_CTX")" "$(_fmt "$_ctx_total")" "$(( MAX_CTX * 100 / _ctx_total ))" "$_more_hint" "$_r" >&2
    fi
  fi
  CTX_OPEN="<input>"
  [ -n "$CTX_NAME" ] && CTX_OPEN="<input name=\"$CTX_NAME\">"
  if [ -n "$QUERY" ]; then QUERY="$QUERY

$CTX_OPEN
$CTX
</input>"
  else QUERY="$CTX_OPEN
$CTX
</input>"; fi
  if $TRUNC; then QUERY="$QUERY
[input truncated at $MAX_CTX chars; absence beyond this prefix cannot be established]"; fi
fi
# Document intents are meaningless without a document. The #1 trap (observed):
# naming a file IN THE PROMPT — which is just text the model can't open — and
# getting a confident "I can't access your filesystem" instead of an answer.
# Require real context, and if they named an existing file, point at the fix.
if intent_needs_ctx "$INTENT" && [ -z "$CTX" ]; then
  if $DIY; then
    # --diy never hard-fails on its own routing: a doc intent that ended up
    # docless (planner optimism) degrades to ask; web results, if any, still ride.
    INTENT=ask
    if [ "$MODE" = text ] && use_color_fd 2; then printf '\033[2m· diy: doc-intent without a doc → ask\033[0m\n' >&2
    elif [ "$MODE" = text ]; then echo "· diy: doc-intent without a doc → ask" >&2; fi
  else
    hint="'$INTENT' needs a document — pass the file with --ctx <path> (or pipe it in)."
    set -f
    for w in $QUERY; do
      [ -f "$w" ] && { hint="$hint You named '$w' in the prompt (that's just text) — try: q $INTENT --ctx '$w'"; break; }
    done
    set +f
    emit_error ctx_required "$hint" 2
  fi
fi

if [ "$INTENT" = code-dispatch ]; then
  [[ "$CTX" == *'=== JUDGE ==='* ]] \
    || emit_error judge_required "code-dispatch needs a === JUDGE === section with a runnable check in --ctx; use q complete for a test-specified single-file completion" 2
fi

if [ -z "$QUERY" ]; then
  # Bare `q` is a human asking for help; in machine mode an empty query is a
  # caller bug and must be a structured error, never help text on stdout.
  [ "$MODE" = text ] && { show_help; exit 0; }
  emit_error invalid_args "no prompt or context provided" 2
fi

# ── --web: search first, answer from the results ──
# The script fetches (lib/websearch: DDG lite, no key, top page extracted); the
# model only reads. A dead network degrades to answering offline, narrated on
# the gray channel — never a hard failure, never silent.
if $WEB; then
  [ -n "$WEB_QUERY" ] || WEB_QUERY="${positionals[*]}"
  _dim=""; _rs=""; use_color_fd 2 && { _dim=$'\033[2m'; _rs=$'\033[0m'; }
  WEB_OUT="$("$DIR/lib/websearch" "$WEB_QUERY" -n 5 --fetch 2>/dev/null)" || WEB_OUT=""
  if [ -n "$WEB_OUT" ]; then
    if [ "$MODE" = text ]; then
      printf '%s· web: "%s" → %s results (top page fetched)%s\n' \
        "$_dim" "${WEB_QUERY:0:60}" "$(printf '%s\n' "$WEB_OUT" | grep -c '^\[')" "$_rs" >&2
    fi
    QUERY="$QUERY

<input name=\"web-results\" query=\"$WEB_QUERY\">
$WEB_OUT
</input>
(Answer from the web results above; cite result numbers like [2]. If they do not contain the answer, say so.)"
  else
    if [ "$MODE" = text ]; then printf '%s· web: search unreachable — answering offline%s\n' "$_dim" "$_rs" >&2; fi
  fi
fi

# -c: replay the target entry's whole conversation chain (entries sharing a cid)
# as prior messages, and adopt its model/intent unless overridden. Chains are
# keyed by cid; pre-cid entries fall back to their own ts as the chain id.
HIST="[]"; CID=""
if $CONT && [ -f "$LOG" ]; then
  # A bare -c continues YOUR last exchange (this terminal), not whatever a hook ran last.
  if [ -n "$CONT_N" ]; then target=$(sed -n "${CONT_N}p" "$LOG")
  elif [ "$LM_ENTRY_SCOPE" = all ]; then target=$(tail -1 "$LOG")
  else _mine="$(mine_line "$LOG" 1)" || _mine=""
       if [ -n "$_mine" ]; then target=$(sed -n "${_mine}p" "$LOG")
       else emit_error no_such_entry "none of your calls from this terminal to continue; q -c N continues entry N, and q --all -c continues the newest from anyone" 2; fi
  fi
  if [ -n "$target" ]; then
    CID=$(printf '%s' "$target" | jq -r '.cid // .ts')
    $USER_MODEL  || MODEL=$(printf '%s' "$target" | jq -r '.model')
    $USER_INTENT || INTENT=$(printf '%s' "$target" | jq -r '.intent')
    # Cap at the last 8 exchanges BEFORE building the argv — long chains of
    # diff-sized exchanges would otherwise blow past ARG_MAX (the finer ~18k
    # char budget is applied again inside python).
    HIST=$(jq -cs --arg cid "$CID" \
      '[ .[] | select((.cid // .ts) == $cid) | {p:.prompt, r:.response} ] | .[-8:]' "$LOG")
  else
    emit_error no_such_entry "no entry ${CONT_N:-} to continue" 2
  fi
fi

# System prompt comes from the registry (intents/<name>.toml). Unknown intent → no
# system prompt (same as the old case fall-through). --raw blanks it regardless.
if intent_exists "$INTENT"; then SYS="$(intent_sys "$INTENT")"; else SYS=""; fi
$RAW && SYS=""

if ! ollama_ensure; then
  if [ "$MODE" = text ]; then server_down_msg; exit 10; fi
  emit_error server_down "ollama server unreachable at $OLLAMA_HOST" 10
fi

# Don't disturb the warm pin: keep_alive is last-writer-wins per request, so if
# the target model is already resident keep it resident (-1); otherwise load it
# just for this call and let it unload (0).
if ollama_resident "$MODEL"; then KEEP=-1; else KEEP=0; fi

# Lease hint: repeated cold loads of a big model deserve a nudge toward
# `warm on` — suggestion only, residency stays the human's call. Bash decides
# eligibility (cold + not the companion) so the warm hot path never pays for
# it; python counts recent same-model calls and prints the one-liner.
LEASE_HINT=""
if [ "$MODE" = text ] && [ "$KEEP" = 0 ] && [ "$MODEL" != "$WARM_MODEL" ]; then
  case "$MODEL" in
    "${CODE_MODEL:-qwen3.6:35b-a3b}") LEASE_HINT="warm on code" ;;
    "${BIG_MODEL:-gemma4:26b}")       LEASE_HINT="warm on big" ;;
    *)                                LEASE_HINT="warm on $MODEL" ;;
  esac
fi

# --glow renders the finished reply as markdown instead of streaming it. Decided
# here (not in python) so PATH and TTY are probed once; machine modes ignore it.
GLOW_OK=false
if $GLOW && [ "$MODE" = text ] && [ -t 1 ] && command -v glow >/dev/null 2>&1; then GLOW_OK=true; fi

# Deterministic (temperature 0) + history logging. Stream token-by-token for low
# perceived latency (text mode) or as NDJSON frames (stream mode).
# exec so python IS this process: a GUI host's SIGTERM must reach the signal
# handlers (cancelled/130), not kill a bash wrapper around them (143).
mkdir -p "$DIR/logs"
export LM_DIR="$DIR" Q_SMALL_MODEL="$WARM_MODEL"
[ "$KEEP" = "0" ] && lm_step q "$MODEL cold load · intent=$INTENT"
exec python3 - "$MODEL" "$SYS" "$QUERY" "$THINK" "$KEEP" "$INTENT" "$LOG" "$HIST" "$CID" "$MODE" "$TIMEOUT" "$TRUNC" "$OLLAMA_HOST" "$STATS" "$FORMAT" "$GLOW_OK" "$LEASE_HINT" "${DIY_LOG:-}" <<'PY'
import sys, os, json, time, signal, urllib.request, urllib.error
(model, sysp, query, think, keep, intent, logf,
 histjson, cid, mode, timeout, trunc, host, stats, fmt, glow, lease_hint, diyjson) = sys.argv[1:19]
truncated = trunc == "true"

def emit_err(code, msg, rc):
    if mode == "stream":
        sys.stdout.write(json.dumps({"t": "error", "code": code, "message": msg}) + "\n")
    elif mode == "json":
        fix = {"remedy": "see the message; -h lists the flags and examples", "next": None}
        try:
            sys.path.insert(0, os.path.join(os.environ.get("LM_ROOT_DIR", "."), "lib"))
            import verbs
            fix = verbs.remedy_for(verbs.load(), code)
        except Exception:
            pass
        sys.stdout.write(json.dumps({"ok": False, "code": code, "message": msg, **fix}) + "\n")
    else:
        sys.stderr.write("q: %s\n" % msg)
    sys.stdout.flush()
    try:  # failures are history too — the feedback sink mines these; never block the exit
        ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        with open(logf, "a", encoding="utf-8", errors="backslashreplace") as f:
            f.write(json.dumps({"ts": ts, "cid": cid or ts, "intent": intent, "model": model,
                                "think": think == "true", "prompt": query,
                                "response": "[error: %s]" % code, "error": code, "ms": 0,
                                "tty": os.environ.get("LM_TTY") or None,
                                "session": os.environ.get("LM_SESSION") or None}, ensure_ascii=False) + "\n")
    except Exception:
        pass
    sys.exit(rc)

# Cancellation contract: the GUI host SIGTERMs us when the user closes the
# overlay. Exiting drops the HTTP connection, which makes Ollama stop generating.
signal.signal(signal.SIGTERM, lambda *_: emit_err("cancelled", "cancelled by client", 130))
signal.signal(signal.SIGINT,  lambda *_: emit_err("cancelled", "cancelled by client", 130))
if float(timeout) > 0:
    signal.signal(signal.SIGALRM, lambda *_: emit_err("timeout", "exceeded %ss wall clock" % timeout, 13))
    signal.setitimer(signal.ITIMER_REAL, float(timeout))

# Replay the conversation chain (newest-first whole exchanges) within ~18k chars
# — the warm model's 8k-token window minus headroom for system + new prompt.
hist, budget, picked = json.loads(histjson), 18000, []
for ex in reversed(hist):
    cost = len(ex.get("p", "")) + len(ex.get("r", ""))
    if budget - cost < 0 and picked:
        break
    budget -= cost
    picked.append(ex)
picked.reverse()
prior = [m for ex in picked for m in
         ({"role": "user", "content": ex["p"]}, {"role": "assistant", "content": ex["r"]})]
note = os.environ.get("Q_RUNTIME_NOTE", "")   # sent to the model only; the history row keeps `query` as typed
msgs = ([{"role": "system", "content": sysp}] if sysp else []) + prior + [
    {"role": "user", "content": query + ("\n\n" + note if note else "")}]
payload = {
    "model": model, "messages": msgs,
    "think": think == "true", "stream": True,
    "keep_alive": int(keep),
    "options": {"temperature": 0},
}
if fmt:
    payload["format"] = json.loads(fmt)
body = json.dumps(payload).encode()
req = urllib.request.Request(host.rstrip("/") + "/api/chat", data=body,
                            headers={"Content-Type": "application/json"})
t0 = time.time(); parts = []
in_thinking = False  # thinking streams in message.thinking, separate from content
tok_in = tok_out = eval_ns = 0  # filled from the final done chunk's eval counts
dim, rs = (("\033[2m", "\033[0m") if sys.stderr.isatty() and not __import__("os").environ.get("NO_COLOR")
           else ("", ""))
try:
    with urllib.request.urlopen(req) as r:
        for line in r:
            line = line.strip()
            if not line:
                continue
            obj = json.loads(line)
            if obj.get("done"):  # final chunk carries the token tallies
                tok_in = obj.get("prompt_eval_count", 0)
                tok_out = obj.get("eval_count", 0)
                eval_ns = obj.get("eval_duration", 0)
            msg = obj.get("message", {})
            # The reasoning trace goes to stderr (dimmed) so stdout stays the bare
            # answer; machine modes drop it entirely.
            trace = msg.get("thinking", "")
            if trace and mode == "text":
                if not in_thinking:
                    sys.stderr.write(dim); in_thinking = True
                sys.stderr.write(trace); sys.stderr.flush()
            chunk = msg.get("content", "")
            if chunk:
                if in_thinking:
                    sys.stderr.write(rs + "\n"); sys.stderr.flush(); in_thinking = False
                parts.append(chunk)
                if mode == "text" and glow != "true":  # glow buffers; render after the loop
                    sys.stdout.write(chunk); sys.stdout.flush()
                elif mode == "stream":
                    sys.stdout.write(json.dumps({"t": "chunk", "text": chunk}) + "\n")
                    sys.stdout.flush()
except urllib.error.HTTPError as e:
    if e.code == 404:
        emit_err("model_missing", "model '%s' not available on the server" % model, 11)
    emit_err("server_down", "HTTP %s from ollama" % e.code, 10)
except OSError as e:
    # The pre-flight check covers a dead server; this covers it dying mid-request.
    emit_err("server_down", "lost the ollama server mid-request (%s)" % e, 10)
signal.setitimer(signal.ITIMER_REAL, 0)
if in_thinking:
    sys.stderr.write(rs + "\n"); sys.stderr.flush()
ms = int((time.time() - t0) * 1000)
text = "".join(parts).strip()
# A shell-command answer gets checked against the program's own man page / --help (never
# run): an invented flag is the usual failure. Humans see a gray line, --json gets .checked.
checked = None
if intent == "cmd" and text and (mode == "json" or (mode == "text" and sys.stderr.isatty())):
    try:
        sys.path.insert(0, os.path.join(os.environ["LM_DIR"], "lib"))
        import cmdcheck
        checked = cmdcheck.check(text)
    except Exception:
        checked = None
try:  # the JSONL line this call will occupy → `q show N` re-pulls it later, no lookup
    n_entry = sum(1 for _ in open(logf)) + 1
except Exception:
    n_entry = 1
if mode == "text":
    if glow == "true":
        import subprocess
        try:  # glow died mid-render → the reply must still reach the user plain
            subprocess.run(["glow", "-"], input=(text + "\n").encode(), check=False)
        except Exception:
            sys.stdout.write(text + "\n")
    else:
        sys.stdout.write("\n")
    # Gray token-spend line on stderr — like the --think trace, TTY-only, muteable.
    if stats == "true" and sys.stderr.isatty():
        tps = (tok_out / (eval_ns / 1_000_000_000)) if eval_ns else 0
        cold = " · cold" if keep == "0" else ""
        sys.stderr.write("%s· %s%s · %s in / %s out · %d tok/s · %.1fs · q show %d%s\n"
                         % (dim, model, cold, format(tok_in, ","), format(tok_out, ","), tps, ms / 1000, n_entry, rs))
    if checked and checked.get("checked"):
        sys.stderr.write("%s%s%s\n" % (dim, cmdcheck.line(checked), rs))
elif mode == "stream":
    sys.stdout.write(json.dumps({"t": "done", "model": model, "ms": ms,
                                 "tokens_in": tok_in, "tokens_out": tok_out, "truncated": truncated}) + "\n")
elif mode == "json":
    envelope = {"ok": True, "text": text, "model": model, "ms": ms,
                "tokens_in": tok_in, "tokens_out": tok_out, "truncated": truncated,
                "intent": intent, "entry": n_entry, "cold_load": keep == "0"}
    if checked is not None:
        envelope["checked"] = checked
    if fmt:  # constrained output: hand consumers the parsed object, not a string to re-parse
        try:
            envelope["data"] = json.loads(text)
        except ValueError:
            envelope["data"] = None
    sys.stdout.write(json.dumps(envelope) + "\n")
sys.stdout.flush()
try:  # history is best-effort — never break the answer on a log failure
    ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    entry = {
        "ts": ts, "cid": cid or ts,  # chain id: continued -> inherited, fresh -> own ts
        "intent": intent, "model": model, "think": think == "true",
        "prompt": query, "response": text,
        "ms": ms,
        # keep==-1 is set iff the model was resident before this call, so the
        # cold-load rate is derivable from the history (lm doctor reads this).
        "resident": keep == "-1",
        "caller": os.getcwd(),
        # who ran it: lets -c, show -1 and lm timeline mean "mine" (null = no terminal)
        "tty": os.environ.get("LM_TTY") or None,
        "session": os.environ.get("LM_SESSION") or None,
    }
    if checked is not None:
        entry["checked"] = checked
    if diyjson:  # --diy routing rides into history so `q show N` can explain it
        try:
            entry["diy"] = json.loads(diyjson)
        except ValueError:
            pass
    with open(logf, "a", encoding="utf-8", errors="backslashreplace") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
except Exception:
    pass
# Same words twice in 5 minutes: the second answer cannot differ (temperature 0), so say
# what to do instead of letting the person retype it a third time.
hint_key = None   # at most one gray `next:` line, chosen below; the words live in lib/verbs.toml
if mode == "text" and stats == "true" and sys.stderr.isatty() and not os.environ.get("Q_AGAIN"):
    try:
        import calendar
        with open(logf, encoding="utf-8", errors="replace") as f:
            rows = f.readlines()[-50:-1]   # the line just written is last; look at the ones before it
        now, repeats = time.time(), 0
        for ln in rows:
            try:
                e = json.loads(ln)
            except ValueError:
                continue
            if e.get("prompt") == query and e.get("intent") == intent and \
               calendar.timegm(time.strptime(e["ts"], "%Y-%m-%dT%H:%M:%SZ")) >= now - 300:
                repeats += 1
        if repeats:
            hint_key = "repeat"
    except Exception:
        pass
    if hint_key is None and model == os.environ.get("Q_SMALL_MODEL") and intent in ("ask", "qa", "summarize", "explain-code") and os.environ.get("LM_HINTS", "1") != "0":
        hint_key = "small_answer"
    if hint_key and os.environ.get("LM_HINTS", "1") != "0":
        try:
            sys.path.insert(0, os.path.join(os.environ.get("LM_DIR", "."), "lib"))
            import verbs
            verbs.emit_hint(verbs.load(), hint_key, color=not os.environ.get("NO_COLOR"))
        except Exception:
            pass
# The lease nudge: 3+ cold loads of this model inside 5 minutes says the user
# is in a session with it — suggest the bounded lease. Counts the log just
# written (so this call is included); never breaks the answer.
if lease_hint and mode == "text" and stats == "true" and sys.stderr.isatty():
    try:
        import calendar
        cutoff, n = time.time() - 300, 0
        with open(logf, encoding="utf-8", errors="replace") as f:
            for ln in f.readlines()[-50:]:
                try:
                    e = json.loads(ln)
                except ValueError:
                    continue
                if e.get("model") != model:
                    continue
                if calendar.timegm(time.strptime(e["ts"], "%Y-%m-%dT%H:%M:%SZ")) >= cutoff:
                    n += 1
        if n >= 3:
            sys.stderr.write("%s· %d cold loads of %s in 5 min — lease it: %s%s\n"
                             % (dim, n, model, lease_hint, rs))
    except Exception:
        pass
PY
