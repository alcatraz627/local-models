#!/usr/bin/env bash
# lm — the front door for local models and the connected Gemini lane.
#
#   lm "question"            answer (an image path, a file or "gemini ..." routes itself)
#   lm cmd|read|diff|doc|again|find|review ...   one job each, thin aliases over the tools
#   lm fast 1h               keep answers instant for an hour (= warm on 1h)
#   lm status                what is loaded, free memory
#   lm more                  every other command (the old overview)
set -eo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$DIR/bin"
# shellcheck source=/dev/null
source "$DIR/config.sh" 2>/dev/null || true   # WARM_MODEL etc — doctor checks the configured one
# shellcheck source=/dev/null
source "$BIN/_lib.sh"
wants_all "$@" && HELP_ALL=true
lm_identify

# The default screen: jobs, not tools. Each line is a thin alias over an existing tool.
front_door() {
  printf '%s%slm%s %s— local models on this Mac (nothing leaves the machine unless marked ☁)%s\n' "$Bd" "$C" "$Rs" "$Dm" "$Rs"
  printf '\n%sJOBS%s\n' "$Y" "$Rs"
  _cmd 'lm "question"'               'answer; an image path, a file or "gemini ..." in it routes itself'
  _cmd 'lm cmd "task"'               'one shell command, checked against the tool'"'"'s own --help'
  _cmd 'lm read <img|paste|latest> ["q"]' 'text or an answer from an image (exact text is read first)'
  _cmd 'lm diff A B'                 'what changed between two images, and where'
  _cmd 'lm doc <file> ["q"]'         'ask about or summarize a file (says how much of it was read)'
  _cmd 'lm again [--big|--web]'      'redo your last question on a stronger model (--web leaves this Mac ☁)'
  _cmd 'lm find "words"'             'search your past answers'
  _cmd 'lm review'                   'review your uncommitted changes (a few minutes, on the code model)'
  printf '\n%sKEEP IT HANDY%s\n' "$Y" "$Rs"
  _cmd 'lm status'                   'what is loaded, free memory, when it unloads'
  _cmd 'lm fast 1h'                  'keep answers instant for an hour (lm fast off to free the memory)'
  _cmd 'lm help <job>'               'the steps for one job: ask, cmd, doc, read, diff, count, again, find, web, fast, failed'
  _cmd 'lm more'                     "everything else: gemini ☁, fleet, rag, index, imagine, probe, bench, ui-verify"
  printf '\n  %s☁ marks a call that leaves this Mac. Every command takes -h.%s\n' "$Dm" "$Rs"
}

overview() {
  printf '%s%slm%s %s— local-model toolkit with an optional connected Gemini lane%s\n' "$Bd" "$C" "$Rs" "$Dm" "$Rs"
  printf '\n%sCOMMANDS%s\n' "$Y" "$Rs"
  printf '  %s%-22s%s %squick local LLM — answers, macOS cmds, titles, file Q&A; size tiers%s\n' "$C" 'lm q "..."' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %slocal image generation (Flux/Qwen on the GPU)%s\n' "$C" 'lm imagine "..."' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %sread an image/screenshot into text (local VLM)%s\n' "$C" 'lm see <img>' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %sreview a PR / files / folder / diff (local coder)%s\n' "$C" 'lm review <x>' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %sjudge if a local model is trustworthy — reliability/judgment eval%s\n' "$C" 'lm probe <model>' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %sfan one intent across N files (envelope gate; optional content judge)%s\n' "$C" 'lm fleet <intent> ...' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %sopencode on the local code model — auto pin/unpin around the session%s\n' "$C" 'lm opencode [args]' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %srepo symbol map — build once, "where is X" instantly%s\n' "$C" 'lm index [find X]' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %sthe gemini lane — huge-context ingestion, ideation (wrapper-only)%s\n' "$C" 'lm gemini "..."' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %scheck enumerable UI claims against a screenshot (local verify gate)%s\n' "$C" 'lm ui-verify <img> ...' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %slocal vector retrieval: index docs, search by meaning%s\n' "$C" 'lm rag index|search' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %swarm-model toggle (snappy on / zero-idle off)%s\n' "$C" 'lm warm on|off' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %sserver + warm + models at a glance%s\n' "$C" 'lm status' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %slist usable models and tiers (● resident; --json)%s\n' "$C" 'lm models' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %ssmoke-check the toolkit (deps, tiers, vision, venv, PATH; --json)%s\n' "$C" 'lm doctor' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %smerged q/imagine/see/fleet/gemini history (--errors, --tool T, --json)%s\n' "$C" 'lm timeline [N]' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %sopen the newest history entry in full (optionally of one tool)%s\n' "$C" 'lm last [tool]' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %scolored, comprehensive showcase of the whole suite%s\n' "$C" 'lm examples' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %sshort route from a job to the right command%s\n' "$C" 'lm help <job>' "$Rs" "$Dm" "$Rs"
  printf '  %s%-22s%s %srun a fixed behavior and latency fixture set%s\n' "$C" 'lm bench <set>' "$Rs" "$Dm" "$Rs"
  printf '\n%sEXAMPLES%s\n' "$Y" "$Rs"
  printf '  %s$%s lm q cmd "free up port 3001"            %s# one macOS command%s\n' "$Dm" "$Rs" "$Dm" "$Rs"
  printf '  %s$%s lm q summarize --file report.pdf        %s# read a local file (no cloud)%s\n' "$Dm" "$Rs" "$Dm" "$Rs"
  printf '  %s$%s lm q --big "reason through this"         %s# heavier on-demand model%s\n' "$Dm" "$Rs" "$Dm" "$Rs"
  printf '  %s$%s git diff | lm q commit                   %s# commit message from the diff%s\n' "$Dm" "$Rs" "$Dm" "$Rs"
  printf '  %s$%s lm imagine --enhance "a cozy reading nook"\n' "$Dm" "$Rs"
  printf '  %s$%s lm imagine refine 12 "warmer light"      %s# iterate on generation 12%s\n' "$Dm" "$Rs" "$Dm" "$Rs"
  printf '  %s$%s lm models   ·   lm status   ·   lm doctor %s# what is installed / running / healthy%s\n' "$Dm" "$Rs" "$Dm" "$Rs"
  printf '  %s$%s lm warm on                                %s# pin the small model — q is then sub-second%s\n' "$Dm" "$Rs" "$Dm" "$Rs"
  printf '\n%sMORE%s\n' "$Y" "$Rs"
  printf '  per-command help (every flag + examples):  %slm help <verb>%s, or %s<verb> -h%s for q, see, imagine, review, warm, gemini, fleet\n' "$C" "$Rs" "$C" "$Rs"
  printf '  the full menu with examples:  %sglow ~/Code/local-models/docs/CAPABILITIES.md%s\n' "$C" "$Rs"
  printf '  %sdocs: ~/Code/local-models/docs/  (STATE · CAPABILITIES · q-spec · 03-tool-orchestration-decision · research)%s\n' "$Dm" "$Rs"
}

help_job() {
  help_title() { printf '%s%slm help %s%s %s— %s%s\n' "$Bd" "$C" "$1" "$Rs" "$Dm" "$2" "$Rs"; }
  help_section() { printf '\n%s%s%s\n' "$Y" "$1" "$Rs"; }
  help_example() { _help_row "$C" 44 "$1" "$2"; }
  help_note() { printf '\n'; _note "$1"; }
  case "${1:-}" in
    "")
      help_title '<job>' 'say what you want to do, get the commands'
      help_section 'JOBS'
      help_example 'lm help ask'     'get a quick answer'
      help_example 'lm help cmd'     'get one shell command you can trust'
      help_example 'lm help doc'     'ask about, or summarize, a file'
      help_example 'lm help read'    'get the text or an answer out of an image or screenshot'
      help_example 'lm help diff'    'see what changed between two images'
      help_example 'lm help count'   'count things in an image'
      help_example 'lm help again'   'the answer was wrong: try again, stronger'
      help_example 'lm help find'    'find an answer you got before'
      help_example 'lm help web'     'ask about something current'
      help_example 'lm help fast'    'keep answers instant for a while'
      help_example 'lm help status'  'see what is loaded and how much memory is free'
      help_example 'lm help failed'  'work out why a call failed'
      help_note 'Also: lm help json | table | gemini | review | imagine | batch | retrieval. Tool help: lm help q|see|imagine|review|warm|probe|ui-verify|index|bench. Everything with examples: lm examples' ;;
    ask)
      help_title 'ask' 'a quick answer from the small local model'
      help_section 'START'
      help_example 'lm "how do I see what is using port 5432"' 'the answer comes back in a few seconds'
      help_example 'lm fast 1h'                  'the first answer after a pause takes about 5 s; this keeps it instant'
      help_example 'lm "what text is in ~/Desktop/shot.png"' 'an image path in the question goes to the image reader'
      help_note 'Wrong or thin answer? lm help again. A question about something current? lm help web.' ;;
    cmd)
      help_title 'cmd' 'one shell command, checked before you run it'
      help_section 'START'
      help_example 'lm cmd "list the 5 largest files in ~/Downloads"' 'prints the command and nothing else'
      help_note 'It checks that the program exists and that each --flag appears in its own --help, then prints a gray line saying what it found. It never runs the command. A flag it cannot find means the model guessed: lm again --web.' ;;
    doc|document|qa)
      help_title 'doc' 'ask about, or summarize, a file'
      help_section 'START'
      help_example 'lm doc report.pdf'                    'a summary (PDF, Word, HTML, text, spreadsheets)'
      help_example 'lm doc report.pdf "what is the decision?"' 'an answer grounded in the file'
      help_example 'q --preflight --ctx report.pdf'       'how big the file is, before asking'
      help_note 'It tells you how much of the file it read. A long file is cut at 16,000 characters: raise it with --max-ctx 40000, or use cat file | lm gemini "..." (the file leaves this Mac).' ;;
    read|screenshot|ui|ocr|text)
      help_title 'read' 'text or an answer out of an image'
      help_section 'START'
      help_example 'lm read shot.png'                   'what is in the image'
      help_example 'lm read shot.png "what is the build id?"' 'asks for text, IDs and numbers are read exactly first'
      help_example 'lm read paste'                      'the screenshot on your clipboard (Cmd-Ctrl-Shift-4)'
      help_example 'lm read latest'                     'your newest screenshot file'
      help_example 'see shot.png --ocr'                 'just the exact text, about a second'
      help_example 'see shot.png --ui --json'           'a structured list of the buttons and labels'
      help_example 'lm ui-verify shot.png "Save is disabled"' 'check one claim about a screenshot'
      help_note 'Exact readers (text, counts) run first; the vision model only adds what they cannot see.' ;;
    diff|compare)
      help_title 'diff' 'what changed between two images'
      help_section 'START'
      help_example 'lm diff before.png after.png'       'a three-line summary: where, whether text changed, whether colours changed'
      help_example 'see diff a.png b.png --no-read --json' 'the measured evidence only, no model'
      help_note 'The summary is measured from the pixels. A vision model adds its own read when one is free; judging whether the change matters is yours.' ;;
    count)
      help_title 'count' 'count things in an image by measuring pixels'
      help_section 'START'
      help_example 'see count dots.png'                 'how many objects (exact, instant, no model)'
      help_example 'see count squares.png --color blue'  'only the blue ones'
      help_example 'see odd grid.png'                   'the one item that differs among repeated items'
      help_note 'Asking "how many" through lm read runs this first.' ;;
    again|retry)
      help_title 'again' 'the answer was wrong; ask the same thing on a stronger model'
      help_section 'START'
      help_example 'lm again'               'your last question, one step stronger (small, then big)'
      help_example 'lm again --big'         'the bigger reasoning model'
      help_example 'lm again --code'        'the coding model'
      help_example 'lm again --web'         'search the web first (the question leaves this Mac)'
      help_example 'q -c "and sorted by size?"' 'a follow-up that continues your last exchange'
      help_note 'Answers are deterministic: asking the same thing twice gives the same answer, so retyping never helps.' ;;
    find|history|retrieval-history)
      help_title 'find' 'search the answers you got before'
      help_section 'START'
      help_example 'lm find "port 5432"'    'matching questions and answers across q, see, gemini and imagine, yours first'
      help_example 'lm timeline 15'         'your last 15 calls, newest last'
      help_example 'lm timeline --all'      'include agents and hooks (dimmed)'
      help_example 'lm last'                'your latest call, in full'
      help_note 'Open one with the handle it prints: q show 3689, see show 1433.' ;;
    web|current)
      help_title 'web' 'something current: versions, news, docs'
      help_section 'START'
      help_example 'q --web "current node LTS version?"' 'searches the web, answers from the results with citations'
      help_example 'lm gemini research "state of X"'     'a slower, deeper lookup (Gemini)'
      help_note 'Both send your question off this Mac. The small local model cannot know what is current.' ;;
    fast)
      help_title 'fast' 'keep answers instant'
      help_section 'START'
      help_example 'lm fast 1h'     'q answers in under a second until the time it prints'
      help_example 'lm fast off'    'free the memory now'
      help_example 'lm status'      'what is loaded and when it unloads'
      help_note 'Without it the first answer after a pause takes about 5 s while the model loads. Nothing stays loaded on its own.' ;;
    status|memory)
      help_title 'status' 'what is loaded and what is free'
      help_section 'START'
      help_example 'lm status'    'server, free memory, loaded models, when they unload'
      help_example 'lm models'    'every installed model and which tier it is'
      help_example 'lm doctor'    'a health check of the whole toolkit' ;;
    failed|errors)
      help_title 'failed' 'work out why a call failed'
      help_section 'START'
      help_example 'lm timeline 10 --errors'   'your failed calls, each with its reason and what to do'
      help_example 'lm last'                   'the latest call in full, error included'
      help_example 'lm doctor'                 'checks the server, models and PATH'
      help_note 'A stopped server restarts on the next call, so retrying is usually enough.' ;;
    json|machine)
      help_title 'json' 'an answer a script can read'
      help_section 'START'
      help_example 'q --json "is 91 a prime number? answer yes or no"' 'one JSON object with text, model and timing'
      help_example 'q --json --format schema.json "classify: ..."'   'the answer follows your schema, parsed under .data' ;;
    table|describe-data)
      help_title 'table' 'exact rows, missing values, and numeric ranges'
      help_section 'START'
      help_example 'q describe-data --ctx data.csv --json' 'profile facts without model arithmetic'
      help_section 'XLSX'
      help_example 'q --preflight --ctx data.xlsx --json' 'inspect workbook sheets first'
      help_example 'q describe-data --ctx data.xlsx --sheet Summary --json' 'name a sheet when several exist' ;;
    batch|fleet)
      help_title 'batch' 'ask one question of many independent files'
      help_section 'START'
      help_example 'lm fleet qa --prompt "who owns this?" docs/*.md' 'fan out across files'
      help_example 'lm fleet sample <run-dir>' 'look at a sample of what it answered'
      help_note 'The default check only confirms each answer is non-empty; add a task-specific --judge.' ;;
    retrieval|rag)
      help_title 'retrieval' 'search exact text first, then by meaning'
      help_section 'START'
      help_example 'rg -n "term" docs/' 'find exact names and paths'
      help_example 'lm rag index docs/' 'build a local search-by-meaning index'
      help_example 'lm rag search "concept"' 'find related passages' ;;
    research|gemini)
      help_title 'gemini' 'the cloud lane: huge documents and web research'
      help_section 'START'
      help_example 'lm gemini --file big.md "summarize the risks"' 'a file too big for the local model'
      help_example 'lm gemini research "state of X"'  'web lookup, with null where it is unsure'
      help_example 'lm gemini ingest-repo .'  'load a whole repo, then lm gemini ask "..."'
      help_note 'Gemini is an external service: the text you send leaves this Mac. Sample-check what it says.' ;;
    review)
      help_title 'review' 'review code, a PR or your uncommitted changes'
      help_section 'START'
      help_example 'lm review'   'your uncommitted changes (takes a few minutes; loads the 23 GB code model)'
      help_example 'review 214'  'a GitHub PR'
      help_note 'More flags: review -h' ;;
    imagine)
      help_title 'imagine' 'draw an image locally'
      help_section 'START'
      help_example 'imagine "a cozy reading nook"' 'about 1-2 minutes with the default model, free, offline'
      help_example 'imagine refine 12 "warmer light"' 'steer a past image' ;;
    # A tool name routes to that tool's own help, so `lm help see` works like `see -h`.
    q|see|warm|probe) exec "$BIN/$1" -h ;;
    ui-verify) exec "$DIR/lib/ui-verify" -h ;;
    index)     exec "$DIR/lib/repo-index" -h ;;
    bench)     exec python3 "$DIR/scripts/bench.py" -h ;;
    opencode)  printf 'lm opencode [args]: run opencode on the local code tier; the model is leased for the session and released on exit\n' ;;
    *) local g; g="$(did_you_mean "$1" ask cmd doc read diff count again find web fast status failed json table batch retrieval research gemini review imagine q see warm probe fleet rag index ui-verify bench opencode)"
       printf "lm help: unknown job '%s'%s\n  jobs: ask cmd doc read diff count again find web fast status failed json\n  more: table batch retrieval gemini review imagine\n  tools: q see imagine review warm probe fleet gemini rag index ui-verify bench opencode\n" \
         "$1" "${g:+ (did you mean '$g'?)}" >&2; return 2 ;;
  esac
}

# lm examples — a colored, comprehensive showcase of the suite, grouped by task.
# Everything here is a real command you can paste; connected examples are labeled.
examples_table() {
  _r() { _help_row "$C" 53 "$1" "$2"; }
  _s() { printf '\n%s%s%s\n' "$Y" "$1" "$Rs"; }
  printf '%s%slm examples%s %s— local/offline tools plus connected web and Gemini lanes%s\n' "$Bd" "$C" "$Rs" "$Dm" "$Rs"

  _s 'THE DAILY JOBS — lm'
  _r 'lm "how do I see what is using port 5432"'    'quick answer; paths and typos in it route themselves'
  _r 'lm cmd "5 largest files in ~/Downloads"'      'one shell command, checked against its --help'
  _r 'lm read paste "what does the error say?"'     'the screenshot on your clipboard'
  _r 'lm doc report.pdf "what is the decision?"'    'a file, and how much of it was read'
  _r 'lm again --web'                               'the last answer was wrong: same question, stronger'
  _r 'lm find "port 5432"'                          'search your past answers'
  _r 'lm fast 1h'                                   'keep answers instant for an hour'

  _s 'ASK & FILE Q&A — q'
  _r 'q "explain this stack trace: <paste>"'        'quick answer on the warm model'
  _r 'q cmd "free up port 3001"'                    'one macOS command, no prose'
  _r 'q --big "reason through this tradeoff"'        'heavier MoE, on demand'
  _r 'q --code "write a retry wrapper" --ctx api.ts' 'code tier grounded in a file'
  _r 'git diff | q commit'                          'commit message from the diff'
  _r 'q summarize --file report.pdf'                'PDF/Word/HTML extracted locally'
  _r 'q --ctx sales.xlsx qa "which rows are outliers?"' 'spreadsheet Q&A (xlsx→csv)'
  _r 'q describe-data --ctx sales.xlsx --json'     'exact table counts and numeric ranges'
  _r 'q --preflight --ctx sales.xlsx --json'       'inspect sheets and context before a call'
  _r 'q --format SCHEMA "classify: …"'              'constrained decoding → parsed .data'

  _s 'INPUTS & PIPING — local, except labeled connected calls'
  _r 'git diff | q commit'                          'pipe stdin straight into an intent'
  _r 'pbpaste | q "tighten this copy"'              'clipboard text as input (macOS)'
  _r 'q --ctx - qa "who signs off?" < contract.md'  'a file as context via stdin'
  _r 'q summarize --file report.pdf'                'a file — PDF/Word/HTML/xlsx auto-extracted'
  _r 'cat run.log | lm gemini "what failed and why?"' 'connected Gemini: piped stdin becomes context'
  _r 'kubectl get pods -o json | q --ctx - qa "any crashloops?"' 'a tool'\''s JSON output as context'
  _r 'screencapture -i /tmp/s.png && see /tmp/s.png --ui' 'grab a screen region, then read it'
  _r 'see --menubar "which app is focused?"'        'the live macOS menu-bar strip'
  _r 'q --web "current node LTS version?"'          'connected web search, cited answer'
  _r 'lm gemini research "state of X" --json'       'connected Gemini research, null-when-unsure'
  _r 'lm fleet review "src/**/*.ts"'                'every file matching a glob'
  _r 'rg -l TODO | lm fleet qa --items-from - --prompt "what is left?"' 'files matching a filter (stdin list)'
  _r 'lm gemini ingest docs/*.md src/*.py'          'connected Gemini: many files into one session'
  _r 'lm gemini ingest-repo .'                      'connected Gemini: pack repo, gitignore-aware'

  _s 'VISION — see (read a screenshot into text)'
  _r 'see shot.png "what state is the toggle in?"'   'grounded read (Qwen3-VL on MLX; minicpm-v4.6 if memory is tight)'
  _r 'see dashboard.png --ui'                        'UI inventory (Qwen3-VL by default)'
  _r 'see modal.png --mlx "is the dropdown open?"'   'high-accuracy mlx structure read'
  _r 'see receipt.png --ocr'                         'exact text, Apple Vision, ~300ms'
  _r 'see shot.png --region top --ui'                'crop a region, then read it'
  _r 'see --menubar "which app is focused?"'         'grab + read the live top strip'
  _r 'see "~/Desktop/a shot.png" --ui'               'quoted spaced / ~ paths resolve'
  _r 'UI_DEFAULT_MLX=0 see shot.png --ui'            'revert --ui to the ollama tier'

  _s 'COMPARE — see diff (does B faithfully imitate A?)'
  _r 'see diff before.png after.png'                 '$0 evidence pack + one judged read'
  _r 'see diff a.png b.png --only E5 --grid 32'      'refine one extractor, no model call'

  _s 'BATCH FAN-OUT — lm fleet (envelope gate; --judge checks content)'
  _r 'lm fleet review src/*.sh'                      'audit every script'
  _r 'lm fleet qa --prompt "find brand names" *.xlsx -m sweep' 'sweep sheets on the grunt tier'
  _r 'lm fleet summarize docs/*.md -m sweep -j 4'    'granite4:tiny-h; verify the summaries'
  _r 'lm fleet sample outputs/fleet/<run> --count 5' 'human-check a source/answer sample'
  _r 'lm fleet audit outputs/fleet/<run>'            'separate envelope, judge, and human gates'

  _s 'CONNECTED GEMINI — external service, wrapper-only'
  _r 'lm gemini models'                              'the model pick-list (* = default)'
  _r 'lm gemini -m gemini-3.8-flash "…"'             'pick a model for one call'
  _r 'lm gemini ingest-repo . && lm gemini ask "where is retry handled?"' 'whole-repo Q&A'
  _r 'lm gemini research "current state of X" --json' 'web-shaped, null-when-unsure'

  _s 'IMAGE GEN — imagine (qwen by default, on the GPU)'
  _r 'imagine --enhance "a cozy reading nook"'       'LLM-expanded prompt'
  _r 'imagine refine 12 "warmer light"'              'seed-locked iterate on gen 12'

  _s 'UI VERIFY & REPO'
  _r 'lm ui-verify shot.png "the CTA is disabled"'   'strict pass/fail/unsure gate'
  _r 'lm ui-verify --app Finder "there is a Trash item"' 'judge the live accessibility tree'
  _r 'lm index find fleet_worker'                    'where is X, no model call'
  _r 'lm rag index docs/ && lm rag search "concept"' 'vector retrieval when exact search misses'

  _s 'STATUS, PROGRESS & OPS'
  _r 'lm status   ·   lm models   ·   lm doctor'     'running / installed / healthy'
  _r 'LM_PROGRESS=1 see --mlx shot.png'              'show load/step progress lines'
  _r '.venv/bin/python scripts/mem-guard.py --once'  'memory pressure + would-kill target'
  _r 'lm timeline 30'                                'merged history: q, see, imagine, fleet, gemini'
  _r 'lm timeline --errors --tool see'               'only the failed reads, with tool#N to open them'
  _r 'lm last gemini'                                'the newest gemini call, in full'
  _r 'lm bench quick'                                'fixed correctness, latency, disk workload'

  printf '\n%severy command has -h · full menu: glow ~/Code/local-models/docs/CAPABILITIES.md%s\n' "$Dm" "$Rs"
}

# Machine-readable status for GUI hosts (better-file-browser native host).
# Contract: pure JSON on stdout, exit 0 whenever JSON was produced, <150ms even
# with the server down — state lives in the payload, not the exit code.
lm_status_json() {
  local model="${WARM_MODEL:-gemma4-e4b-warm}" server=down warm=false latency=down
  local resident='[]' available='[]' ps_json tags_json
  if ps_json=$(curl -s -m 0.12 "$OLLAMA_HOST/api/ps" 2>/dev/null); then
    server=up
    resident=$(printf '%s' "$ps_json" | jq -c '[.models[]?.name]' 2>/dev/null) || resident='[]'
    # On-disk models — lets a GUI offer model pickers / detect a missing default
    # without a second round-trip. Same latency cap; degrades to [] on a miss.
    tags_json=$(curl -s -m 0.12 "$OLLAMA_HOST/api/tags" 2>/dev/null) \
      && { available=$(printf '%s' "$tags_json" | jq -c '[.models[]?.name]' 2>/dev/null) || available='[]'; }
    if printf '%s' "$resident" | jq -e --arg m "$model" \
         'any(.[]; . == $m or startswith($m + ":"))' >/dev/null 2>&1; then
      warm=true; latency=warm
    else
      latency=cold
    fi
  fi
  jq -cn --arg server "$server" --arg host "$OLLAMA_HOST" --arg model "$model" \
    --argjson warm "$warm" --argjson resident "$resident" --argjson avail "$available" \
    --arg lat "$latency" --arg tv "${LM_VERSION:-1.0}" \
    '{api_version: 1, server: $server, host: $host, default_model: $model,
      warm: $warm, resident_models: $resident, available_models: $avail,
      latency_class: $lat, toolkit_version: $tv}'
}

# Which tier alias (small/big/code/sweep) or role a model name fills, or nothing.
# Exact name or name:tag, like resolve_tier users everywhere else.
tier_label() { # MODEL
  local n="$1" t m
  for t in small big code sweep; do
    m="$(resolve_tier "$t")"
    if [ "$n" = "$m" ] || [[ "$n" == "$m":* ]]; then echo "$t"; return; fi
  done
  m="${VISION_MODEL:-minicpm-v4.6}"; if [ "$n" = "$m" ] || [[ "$n" == "$m":* ]]; then echo vision; return; fi
  m="${RAG_EMBED_MODEL:-nomic-embed-text}"; if [ "$n" = "$m" ] || [[ "$n" == "$m":* ]]; then echo embed; return; fi
  return 0
}

# One memory line from the guard's own reading: "20 GB available · pressure normal · swap 5.7 GB".
# Empty when the guard cannot run, so status never fails over it.
mem_line() {
  local py="$DIR/.venv/bin/python" first avail pressure swap
  [ -x "$py" ] || py=python3
  first="$("$py" "$DIR/scripts/mem-guard.py" --once 2>/dev/null | head -n 1)" || return 0
  avail="$(printf '%s' "$first" | sed -n 's/.*available~=\([0-9.]*\)G.*/\1/p')"
  pressure="$(printf '%s' "$first" | sed -n 's/.*pressure=\([a-z]*\).*/\1/p')"
  swap="$(printf '%s' "$first" | sed -n 's/.*swap_used=\([0-9]*\)M.*/\1/p')"
  [ -n "$avail" ] || return 0
  printf '%.0f GB available · pressure %s%s' "$avail" "${pressure:-?}" "${swap:+ · swap $(awk -v m="$swap" 'BEGIN{printf "%.1f", m/1000}') GB}"
}
# MLX models live outside ollama, so `ollama ps` never shows them: read the process table.
mlx_lines() {
  ps -axo rss=,command= 2>/dev/null | rg 'mlx_(vlm|lm)\.' | rg -v ' rg ' | while IFS= read -r l; do
    local rss="${l%% *}" rest="${l#* }" model
    model="$(printf '%s' "$rest" | sed -n 's/.*--model \([^ ]*\).*/\1/p')"
    printf '  %-28s %-9s %s\n' "$(printf '%s' "$rest" | sed -n 's/.*\(mlx_[a-z]*\.[a-z_]*\).*/\1/p')" "$(awk -v k="$rss" 'BEGIN{printf "%.1f GB", k/1048576}')" "${model:+model $model}"
  done
}

lm_status() {
  printf '%sserver%s   ' "$Y" "$Rs"
  if ollama_up; then
    echo "up · ${OLLAMA_HOST#http://}"
  else
    echo "down (starts on demand, stops after idle) — start now: launchctl kickstart gui/$(id -u)/$LM_LAUNCHD_LABEL"
  fi
  local mem; mem="$(mem_line)"
  [ -z "$mem" ] || printf '%smemory%s   %s\n' "$Y" "$Rs" "$mem"
  printf '%sloaded%s   ollama models: size · when they unload · which tier\n' "$Y" "$Rs"
  local ps_out col l name until size tier
  ps_out="$(ollama_cli ps 2>/dev/null || true)"
  if [ "$(printf '%s\n' "$ps_out" | sed '1d' | grep -c .)" -gt 0 ]; then
    col="$(printf '%s\n' "$ps_out" | awk 'NR==1 {print index($0, "UNTIL")}')"
    printf '%s\n' "$ps_out" | sed '1d' | while IFS= read -r l; do
      [ -n "$l" ] || continue
      name="${l%% *}"; until="${l:$((col - 1))}"; size="$(printf '%s' "$l" | awk '{print $3 " " $4}')"
      tier="$(tier_label "$name")"
      printf '  %-28s %-9s until %-22s tier %s\n' "$name" "$size" "$until" "${tier:--}"
    done
  else
    echo "  none (idle, ~0 RAM)"
  fi
  local mlx; mlx="$(mlx_lines)"
  if [ -n "$mlx" ]; then printf '%smlx%s      running now (outside ollama)\n%s\n' "$Y" "$Rs" "$mlx"
  else printf '%smlx%s      none running\n' "$Y" "$Rs"; fi
  printf '%smodels%s   on disk\n' "$Y" "$Rs"
  local list
  if list="$(ollama_cli list 2>/dev/null)"; then
    printf '%s\n' "$list" | sed '1d' | while IFS= read -r l; do
      [ -n "$l" ] || continue
      tier="$(tier_label "${l%% *}")"
      printf '  %s%s\n' "$l" "${tier:+   ${Dm}tier $tier${Rs}}"
    done
  else
    echo "  (listed once the server is up)"
  fi
}

# One pass/fail line per dependency the toolkit stands on. Exit 1 if any fail.
# --json prints {ok, failed, checks:[{label, ok, optional}]} instead of the text lines.
lm_doctor() {
  local fails=0 json=false rows=""
  [ "${1:-}" = "--json" ] && json=true
  local TAGS_JSON; TAGS_JSON="$(curl -s -m 3 "$OLLAMA_HOST/api/tags" 2>/dev/null || true)"
  model_on_disk() { printf '%s' "$TAGS_JSON" | jq -e --arg m "$1" 'any(.models[]?; .name == $m or (.name | startswith($m + ":")))' >/dev/null 2>&1; }
  # The PATH entry must reach THIS checkout: a symlink to it, or a wrapper script that execs it.
  path_hits() { local p; p="$(command -v "$1" 2>/dev/null)" || return 1; [ "$p" = "$BIN/$1" ] || { [ -f "$p" ] && grep -qF "$BIN/$1" "$p"; }; }
  gemini_key_set() { [ -n "${GEMINI_API_KEY:-}" ] || grep -qs '^GEMINI_API_KEY=' "$HOME/.gemini/.env"; }
  add_row() { # LABEL OK OPTIONAL
    rows+="$(jq -cn --arg l "$1" --argjson ok "$2" --argjson opt "$3" '{label:$l, ok:$ok, optional:$opt}')"$'\n'
  }
  check() { # LABEL CMD...
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      add_row "$label" true false
      $json || printf '  %sok%s   %s\n' "$G" "$Rs" "$label"
    else
      add_row "$label" false false
      $json || printf '  %sFAIL%s %s\n' "$Y" "$Rs" "$label"
      fails=$((fails+1))
    fi
  }
  check "jq installed"                       command -v jq
  check "yq installed (every q intent reads its TOML through it)" command -v yq
  check "ollama installed"                   command -v ollama
  check "server up ($OLLAMA_HOST)"           ollama_up
  check "LaunchAgent loaded ($LM_LAUNCHD_LABEL)" launchctl print "gui/$(id -u)/$LM_LAUNCHD_LABEL"
  local t
  if ollama_up; then
    for t in small big code sweep; do
      check "tier $t on disk ($(resolve_tier "$t"))" model_on_disk "$(resolve_tier "$t")"
    done
    check "vision model on disk (${VISION_MODEL:-minicpm-v4.6})"  model_on_disk "${VISION_MODEL:-minicpm-v4.6}"
    check "embed model on disk (${RAG_EMBED_MODEL:-nomic-embed-text})" model_on_disk "${RAG_EMBED_MODEL:-nomic-embed-text}"
  else
    # with the server down every disk check would also fail, burying the one real cause
    add_row "model checks skipped: server down" false true
    $json || printf '  %sskip%s model-on-disk checks (needs the server; fix the line above first)\n' "$Dm" "$Rs"
  fi
  local mlx_repo="${UI_VISION_MLX:-mlx-community/Qwen3-VL-8B-Instruct-4bit}"
  local mlx_dir="${HF_HOME:-$HOME/.cache/huggingface}/hub/models--${mlx_repo//\//--}"
  check "mlx vision cache (see --ui default: $mlx_repo)" \
        sh -c "ls '$mlx_dir'/snapshots/*/config.json"
  check "mflux venv ($DIR/.venv)"            test -x "$DIR/.venv/bin/mflux-generate"
  local c; for c in lm q imagine warm see review; do
    check "on PATH: $c -> $BIN/$c"           path_hits "$c"
  done
  check "logs dir writable"                  sh -c "mkdir -p '$DIR/logs' && touch '$DIR/logs/.w' && rm -f '$DIR/logs/.w'"
  # Optional extras: each unlocks one capability; missing ones inform, never fail.
  opt() { # BIN CAPABILITY INSTALL_HINT
    if command -v "$1" >/dev/null 2>&1; then
      add_row "optional: $1 ($2)" true true
      $json || printf '  %sok%s   optional: %s (%s)\n' "$G" "$Rs" "$1" "$2"
    else
      add_row "optional: $1 missing, $3 (unlocks $2)" false true
      $json || printf '  %s--%s   optional: %s missing — %s (unlocks %s)\n' "$Dm" "$Rs" "$1" "$3" "$2"
    fi
  }
  opt mac-ocr "see --ocr exact text"            "npm install -g mac-ocr"
  opt ax      "ui-verify --app AX-tree reads"   "cargo install --git https://github.com/watzon/ax-cli"
  opt repomix "lm gemini ingest-repo packing"   "npm install -g repomix"
  opt glow    "--glow pretty rendering"         "brew install glow"
  opt gemini  "the lm gemini side lane"         "brew install gemini-cli + key in ~/.gemini/.env"
  if gemini_key_set; then
    add_row "optional: gemini API key" true true
    $json || printf '  %sok%s   optional: gemini API key (GEMINI_API_KEY or ~/.gemini/.env)\n' "$G" "$Rs"
  else
    add_row "optional: gemini API key missing" false true
    $json || printf '  %s--%s   optional: gemini API key missing — put GEMINI_API_KEY=... in ~/.gemini/.env (unlocks lm gemini calls)\n' "$Dm" "$Rs"
  fi
  if $json; then
    printf '%s' "$rows" | jq -cs --argjson f "$fails" '{ok: ($f == 0), failed: $f, checks: .}'
  elif [ "$fails" -eq 0 ]; then echo "all checks passed"; else echo "$fails check(s) failed"; fi
  [ "$fails" -eq 0 ] || exit 1
}

# What models can q/imagine actually use right now: on-disk (Ollama), which is
# resident, and which is the configured default. --json for machine consumers.
lm_models() {
  local model="${WARM_MODEL:-gemma4-e4b-warm}" big="${BIG_MODEL:-gemma4:26b}" code="${CODE_MODEL:-qwen3.6:35b-a3b}" tags ps resident avail
  local sweep vision; sweep="$(resolve_tier sweep)"; vision="${VISION_MODEL:-minicpm-v4.6}"
  tags=$(curl -s -m 2 "$OLLAMA_HOST/api/tags" 2>/dev/null) \
    || { echo "server down — start: launchctl kickstart -k gui/$(id -u)/$LM_LAUNCHD_LABEL" >&2; return 10; }
  # A reachable-but-erroring server (HTTP 500 body) makes curl exit 0 with non-JSON;
  # validate before the jq pipes, which would otherwise abort under `set -e`.
  printf '%s' "$tags" | jq -e . >/dev/null 2>&1 \
    || { echo "server reachable but returned no model list" >&2; return 10; }
  ps=$(curl -s -m 2 "$OLLAMA_HOST/api/ps" 2>/dev/null)
  resident=$(printf '%s' "$ps" | jq -c '[.models[]?.name]' 2>/dev/null || echo '[]')
  # tiers (the aliases `q -m` accepts) and gemini are the contract for other
  # tools such as bfb's native host; the text output below is for people.
  if [ "${1:-}" = "--json" ]; then
    jq -n --arg default "$model" --argjson resident "${resident:-[]}" \
      --argjson tags "$(printf '%s' "$tags" | jq '[.models[]? | {name, size: (.size // 0), family: .details.family}]' 2>/dev/null || echo '[]')" \
      --arg big "$(resolve_tier big)" --arg code "$(resolve_tier code)" --arg sweep "$(resolve_tier sweep)" \
      --arg gdef "${GEMINI_MODEL:-}" --arg glist "${GEMINI_MODELS:-}" \
      '{default: $default, resident: $resident, available: $tags,
        tiers: [{alias: "small", model: $default}, {alias: "big", model: $big},
                {alias: "code", model: $code}, {alias: "sweep", model: $sweep}],
        gemini: ($glist | split(" ") | map(select(. != "")) | map({name: ., default: (. == $gdef)}))}'
    return
  fi
  printf '%smodels on disk%s  (● resident · tier = q -m <tier>)\n' "$Y" "$Rs"
  # Sizes are written the way `ollama list` and `lm status` write them (decimal units).
  printf '%s' "$tags" | jq -r --arg sm "$model" --arg bg "$big" --arg cd "$code" --arg sw "$sweep" --arg vi "$vision" --argjson r "${resident:-[]}" '
    .models[]? | .name as $n | (.size // 0) as $b
    | (if $b < 1000000000 then "\($b/1000000|floor) MB" elif $b < 10000000000 then "\(($b/100000000|round)/10) GB" else "\($b/1000000000|floor) GB" end) as $gb
    | (if ($r | any(. == $n)) then "●" else " " end) as $res
    | (def m($a): $n == $a or ($n | startswith($a + ":"));   # exact or name:tag, not bare prefix
       if   m($sm) then "small" elif m($bg) then "big" elif m($cd) then "code" elif m($sw) then "sweep" elif m($vi) then "vision" else "" end) as $tier
    | $res + " " + ($n | (. + "                            ")[0:28]) + " " + ($gb | (. + "         ")[0:9]) + " " + $tier' \
    | sed 's/^/  /'
  printf '%stiers%s   small=%s · big=%s · code=%s · sweep=%s · vision=%s  %s(q --big / q -m code / q -m <literal>)%s\n' \
    "$Y" "$Rs" "$model" "$big" "$code" "$sweep" "$vision" "$Dm" "$Rs"
}

# jq helpers shared by timeline and find.
# userwords: what the person typed, without the document inlined after it.
# remedy: what to do about an error code, in words.
JQ_HIST='
  def flat($s; $k): ((($s // "")[0:200]) | gsub("\\s+"; " "))[0:$k];
  def first_line: (. // "") | split("\n") | map(select(test("\\S"))) | (.[0] // "") | gsub("\\s+"; " ");
  def userwords: ((.prompt // "")[0:2000]) | (if startswith("<input") then "" else (split("\n\n<input")[0] // "") end);
  def docname: ((.prompt // "")[0:2000]) | (capture("<input name=\"(?<f>[^\"]*)\"") | .f) // "";
  def qtext($k): (userwords | gsub("\\s+"; " ")) as $w | docname as $d
    | (if $w == "" then ((.intent // "ask") + (if $d != "" then " " + $d else "" end))
       else $w + (if $d != "" then "  [" + $d + "]" else "" end) end)[0:$k];
  def remedy($c): {
      server_down: "the local server was stopped; it restarts on the next call, or run lm doctor",
      model_missing: "that model is not installed; lm models lists what is",
      timeout: "it took too long; try a smaller input or a longer --timeout",
      ctx_required: "that intent needs a file; add --ctx FILE",
      ctx_unreadable: "the file could not be read; check the path",
      ctx_binary: "the file is binary; extract its text first",
      ctx_too_large: "the file is too big; cut it down or use lm gemini --file",
      cancelled: "it was cancelled before it finished",
      mlx_failed: "the MLX read failed; run it again, or add -m minicpm-v4.6",
      model_error: "the vision model failed; run it again, or lm doctor",
      ocr_missing: "install the text reader: npm install -g mac-ocr",
      vlm_unavailable: "the model read was skipped; the measured evidence is still complete",
      gemini_unavailable: "gemini is not available; check the key in ~/.gemini/.env",
      gemini_error: "gemini ended without an answer; lm gemini show -1 has the steps"
    }[$c] // "";'
# One timeline row; needs --arg tool.
JQ_ROW='def row($ln; $kind; $err; $text):
    {ts, tool: $tool, n: $ln, kind: $kind, err: $err, text: $text,
     resp: ((.response // "")[0:600]), code: (.error // null), tty: (.tty // null), session: (.session // null)};'

# Merged history of q, imagine, see, fleet and gemini, newest last. Each row leads
# with tool#N so it points straight at `<tool> show N` (lm last opens it). By default
# only YOUR calls (same terminal) are listed; --all adds agents and hooks, dimmed.
#   lm timeline [N] [--errors] [--tool q|see|imagine|fleet|gemini] [--all] [--json]
lm_timeline() {
  local n=20 errors=false json=false tool="" all=false
  [ -n "${LM_ALL:-}" ] && all=true
  while [ $# -gt 0 ]; do
    case "$1" in
      --errors) errors=true; shift ;;
      --json)   json=true; shift ;;
      --all)    all=true; shift ;;
      -h|--help) verb_help timeline; return 0 ;;
      --tool)   need_arg "lm timeline" "$1" "${2:-}"; tool="$2"; shift 2 ;;
      *) if [[ "$1" =~ ^[1-9][0-9]*$ ]]; then n="$1"; shift
         else reject_unknown_flag "lm timeline" "$1"; echo "lm timeline: unexpected '$1' (lm timeline [N] [--errors] [--tool T] [--all] [--json])" >&2; exit 2; fi ;;
    esac
  done
  case "$tool" in
    gem) tool=gemini ;; img) tool=imagine ;;
    ''|q|see|imagine|fleet|gemini) : ;;
    *) local g; g="$(did_you_mean "$tool" q see imagine fleet gemini)"
       echo "lm timeline: unknown tool '$tool'${g:+ (did you mean '$g'?)}; one of q see imagine fleet gemini" >&2; exit 2 ;;
  esac
  lm_identify
  # Only the newest N lines of each log can hold the newest N rows overall, so tail
  # first: parsing a 12 MB history for 20 rows took 40 seconds. A filter can need to
  # look further back, so it scans the newest 5000 entries of each log.
  local win="$n"; { $errors || [ -n "$tool" ]; } && win=5000
  # Your own rows are found by their tty/session text first (rg is fast), then parsed.
  local -a pats=(-e "\"tty\": ?\"$LM_TTY\""); [ -n "$LM_SESSION" ] && pats+=(-e "\"session\": ?\"$LM_SESSION\"")
  local have_id=false; [ -n "$LM_TTY$LM_SESSION" ] && have_id=true
  tl_src() { # TOOL FILE JQ_BODY
    [ -f "$2" ] || return 0
    { [ -z "$tool" ] || [ "$tool" = "$1" ]; } || return 0
    if $all; then
      local total cnt; total="$(wc -l < "$2" | tr -d ' ')"
      cnt="$win"; [ "$total" -lt "$cnt" ] && cnt="$total"
      # raw lines + fromjson? so one torn line is dropped instead of hiding every newer row
      tail -n "$cnt" "$2" | jq -cR --arg tool "$1" --argjson off "$(( total - cnt ))" "$JQ_HIST $JQ_ROW (input_line_number + \$off) as \$ln | fromjson? | $3"
    else
      $have_id || return 0
      rg -n "${pats[@]}" "$2" 2>/dev/null | tail -n "$win" \
        | jq -cR --arg tool "$1" "$JQ_HIST $JQ_ROW index(\":\") as \$i | (.[0:\$i] | tonumber) as \$ln | (.[\$i+1:] | fromjson?) | $3" || true
    fi
  }
  local rows
  rows="$({
    tl_src q       "$DIR/logs/q-history.jsonl"          'row($ln; .intent; (.error != null); qtext(56))'
    tl_src imagine "$DIR/outputs/imagine-history.jsonl" 'row($ln; (.kind // "gen") + (if .star then " ★" else "" end); false; flat(.prompt // .image; 56))'
    tl_src see     "$DIR/logs/see-history.jsonl"        'row($ln; .mode // "read"; (.error != null or ((.response // "") | startswith("(visual read failed"))); ((.img // "?") | split("/") | last) + "  " + flat(.prompt // "describe"; 40))'
    tl_src fleet   "$DIR/logs/fleet-history.jsonl"      'row($ln; .intent; ((.fail // 0) > 0); "×\(.items)  \(.pass)✓/\(.fail)✗")'
    tl_src gemini  "$DIR/logs/gem-history.jsonl"        'row($ln; .kind; (.kind == "error"); flat(.prompt; 50)) | .code = ((.resp | capture("^(?<c>[a-z_]+):") | .c) // null)'
  } | jq -cs --argjson n "$n" --argjson errors "$errors" --arg t "$LM_TTY" --arg s "$LM_SESSION" --argjson all "$all" "$JQ_HIST $JQ_MINE $JQ_LOCAL_TS"'
    map(. + {mine: mine($t; $s)})
    | map(select(if $errors then .err else true end))
    | map(select($all or .mine))
    | sort_by(.ts) | .[-$n:]
    | map(. + {time: (.ts | lts),
               answer: (if .err then ((.code // "error") + (if remedy(.code // "") != "" then " · " + remedy(.code // "") else "" end))
                        else (.resp | first_line | .[0:60]) end)}
          | del(.resp))')"
  [ -n "$rows" ] || rows='[]'
  if $json; then printf '%s\n' "$rows"; return; fi
  if [ "$(printf '%s' "$rows" | jq 'length')" -eq 0 ]; then
    if $all; then echo "no history yet" >&2
    elif $have_id; then echo "none of your calls from this terminal yet. lm timeline --all shows agents and hooks too." >&2
    else echo "this call has no terminal, so none of the history is 'yours'. lm timeline --all shows everything." >&2; fi
    return 0
  fi
  printf '%s' "$rows" | jq -r --arg dim "$Dm" --arg rs "$Rs" '.[] |
    def pad($w): (. + "              ")[0:$w];
    (if .mine then "" else $dim end) as $d | (if .mine then "" else $rs end) as $r
    | $d + "\(.time)  \("\(.tool)#\(.n)" | pad(11))  \(.kind)\(if .err then " ✗" else "" end)  \(.text)" + (if .answer != "" then "  → \(.answer)" else "" end) + $r'
}

# Open the newest history entry (optionally of one tool) in full: the tool's own `show N`.
# Yours by default; --all takes the newest from anyone.
lm_last() {
  local tool="" row n args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) verb_help last; return 0 ;;
      --all) args+=(--all); shift ;;
      -*) reject_unknown_flag "lm last" "$1"; shift ;;
      *) tool="$1"; shift ;;
    esac
  done
  if [ -n "$tool" ]; then row="$(lm_timeline 1 --tool "$tool" --json ${args[@]+"${args[@]}"})"; else row="$(lm_timeline 1 --json ${args[@]+"${args[@]}"})"; fi
  tool="$(printf '%s' "$row" | jq -r '.[0].tool // empty')"; n="$(printf '%s' "$row" | jq -r '.[0].n // empty')"
  if [ -z "$tool" ]; then
    echo "lm last: none of your calls from this terminal yet (lm last --all takes the newest from anyone)" >&2; exit 12
  fi
  printf '%s%s#%s%s\n' "$eDm" "$tool" "$n" "$eRs" >&2
  case "$tool" in
    q)       exec "$BIN/q" show "$n" ;;
    see)     exec "$BIN/see" show "$n" ;;
    imagine) exec "$BIN/imagine" show "$n" ;;
    gemini)  exec "$DIR/lib/gemini" show "$n" ;;
    fleet)   sed -n "${n}p" "$DIR/logs/fleet-history.jsonl" | jq . ;;
  esac
}

# lm find "words": search what you asked and what you were told, across every history,
# your own calls first. It reads the words you typed and the answer, never the
# documents that were pasted inside a prompt, so a long file does not match everything.
lm_find() {
  local limit=15 all_terms=() a
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) verb_help find; return 0 ;;
      -n) need_arg "lm find" "$1" "${2:-}"; limit="$2"; shift 2 ;;
      --) shift; all_terms+=("$@"); break ;;
      -*) reject_unknown_flag "lm find" "$1"; all_terms+=("$1"); shift ;;
      *) all_terms+=("$1"); shift ;;
    esac
  done
  [ "${#all_terms[@]}" -gt 0 ] || { verb_help find >&2; exit 2; }
  [[ "$limit" =~ ^[1-9][0-9]*$ ]] || usage_fail "lm find" "-n needs a number, got '$limit'"
  lm_identify
  local words="${all_terms[*]}" first="${all_terms[0]}"
  find_src() { # TOOL FILE JQ_BODY  (a row object with prompt/response in scope)
    [ -f "$2" ] || return 0
    rg -n -i -F -e "$first" "$2" 2>/dev/null | tail -n 4000 \
      | jq -cR --arg tool "$1" "$JQ_HIST index(\":\") as \$i | (.[0:\$i] | tonumber) as \$ln | (.[\$i+1:] | fromjson?) | select(. != null) | $3" || true
  }
  # Each source yields {ts, tool, n, tty, session, ask, ans, hay}: ask = the question as typed.
  local found
  found="$({ find_src q       "$DIR/logs/q-history.jsonl"          'select((.intent // "") != "title" and (.intent // "") != "diy-plan") | {ts, tool:$tool, n:$ln, tty:(.tty // null), session:(.session // null), ask:qtext(70), ans:((.response // "") | first_line | .[0:70]), hay:((userwords) + " " + docname + " " + (.response // ""))}'
    find_src see     "$DIR/logs/see-history.jsonl"        '{ts, tool:$tool, n:$ln, tty:(.tty // null), session:(.session // null), ask:(((.img // "?") | split("/") | last) + "  " + flat(.prompt // "describe"; 40)), ans:((.response // "") | first_line | .[0:70]), hay:((.prompt // "") + " " + (.img // "") + " " + (.response // ""))}'
    find_src gemini  "$DIR/logs/gem-history.jsonl"        '{ts, tool:$tool, n:$ln, tty:(.tty // null), session:(.session // null), ask:flat(.prompt; 70), ans:((.response // "") | first_line | .[0:70]), hay:((.prompt // "") + " " + (.response // ""))}'
    find_src imagine "$DIR/outputs/imagine-history.jsonl" '{ts, tool:$tool, n:$ln, tty:(.tty // null), session:(.session // null), ask:flat(.prompt // .image; 70), ans:((.output // .image // "") | split("/") | last), hay:((.prompt // "") + " " + (.response // ""))}'
  } | jq -cs --arg words "$words" --arg t "$LM_TTY" --arg s "$LM_SESSION" --argjson limit "$limit" "$JQ_MINE $JQ_LOCAL_TS"'
      ($words | ascii_downcase | split(" ") | map(select(. != ""))) as $terms
      | map(select(.hay | ascii_downcase | . as $h | all($terms[]; . as $w | $h | contains($w))))
      | map(. + {mine: mine($t; $s)})
      | (map(select(.mine)) | sort_by(.ts) | reverse) + (map(select(.mine | not)) | sort_by(.ts) | reverse)
      | .[0:$limit]
      | map(. + {time: (.ts | lts)} | del(.hay))')"
  if [ "$(printf '%s' "$found" | jq 'length')" -eq 0 ]; then
    echo "lm find: nothing matches \"$words\" in q, see, gemini or imagine history" >&2
    return 0
  fi
  printf '%s' "$found" | jq -r --arg dim "$Dm" --arg rs "$Rs" '.[] |
    def pad($w): (. + "              ")[0:$w];
    (if .mine then "" else $dim end) as $d | (if .mine then "" else $rs end) as $r
    | $d + "\("\(.tool)#\(.n)" | pad(9))  \(.time)  \(.ask)" + (if .ans != "" then "  → \(.ans)" else "" end) + $r'
}

# Help for the verbs lm implements itself (the tools answer their own -h). Asking for
# help never runs the verb.
verb_help() {
  local v="$1" d=""
  case "$v" in
    timeline) d='your recent calls, newest last' ;;
    last) d='your latest call, in full' ;;
    find) d='search the answers you got before' ;;
    status) d='what is loaded, free memory, when it unloads' ;;
    models) d='installed models and which tier each is' ;;
    doctor) d='health check of the whole toolkit' ;;
    examples) d='a showcase of everything, grouped by job' ;;
    help) d='the steps for one job' ;;
    cmd) d='one shell command, checked before you run it' ;;
    read) d='text or an answer out of an image' ;;
    diff) d='what changed between two images' ;;
    doc) d='ask about, or summarize, a file' ;;
    again) d='redo your last question on a stronger model' ;;
    fast) d='keep answers instant for a while' ;;
    more) d='every command, including the rarely used ones' ;;
  esac
  printf '%s%slm %s%s %s— %s%s\n' "$Bd" "$C" "$v" "$Rs" "$Dm" "$d" "$Rs"
  _sec USAGE
  case "$v" in
    timeline)
      _cmd 'lm timeline [N]'        'your last N calls (default 20) across q, see, imagine, fleet and gemini'
      _cmd 'lm timeline --errors'   'only failed calls, each with its reason and what to do'
      _cmd 'lm timeline --all'      'also agents, hooks and other terminals (dimmed)'
      _cmd 'lm timeline --tool T'   'one of q, see, imagine, fleet, gemini'
      _cmd 'lm timeline --json'     'rows as JSON (adds mine, answer, code)'
      _note 'Each row starts with a handle like q#3689: open it with q show 3689.' ;;
    last)
      _cmd 'lm last [tool]'         'your newest call, in full (optionally of one tool)'
      _cmd 'lm last --all'          'the newest call from anyone, including agents and hooks' ;;
    find)
      _cmd 'lm find "words"'        'questions and answers containing all the words, yours first'
      _cmd 'lm find port -n 40'     'show up to 40 matches (default 15)'
      _note 'It searches what you typed and what came back, not the documents pasted inside a prompt. Rows from other terminals, agents and hooks are dimmed.' ;;
    status)
      _cmd 'lm status'              'server, free memory, loaded models and when they unload, MLX processes'
      _cmd 'lm status --json'       'the machine-readable status other tools read' ;;
    models)
      _cmd 'lm models'              'installed models, which are loaded, and which tier each fills'
      _cmd 'lm models --json'       'the same as JSON' ;;
    doctor)
      _cmd 'lm doctor'              'one pass or fail line per dependency; exits 1 if any fail'
      _cmd 'lm doctor --json'       'the same as JSON' ;;
    examples)
      _cmd 'lm examples'            'real commands you can paste, grouped by job' ;;
    help)
      _cmd 'lm help'                'the list of jobs'
      _cmd 'lm help <job>'          'the steps for one job: ask, cmd, doc, read, diff, count, again, find, web, fast, status, failed' ;;
    cmd)
      _cmd 'lm cmd "task"'          'one shell command; it checks the program and each --flag against its own --help'
      _ex 'lm cmd "list the 5 largest files in ~/Downloads"' '' ;;
    read)
      _cmd 'lm read <img> ["q"]'    'text or an answer from an image; text, IDs and counts are read exactly first'
      _cmd 'lm read paste ["q"]'    'the image on your clipboard'
      _cmd 'lm read latest ["q"]'   'your newest screenshot'
      _note 'More options (--ui, --crop, --ocr, --json): see -h' ;;
    diff)
      _cmd 'lm diff A B ["focus"]'  'a plain three-line summary, a heatmap, and a model read if memory allows'
      _note 'More options (--no-read, --only, --grid, --json): see -h' ;;
    doc)
      _cmd 'lm doc <file>'          'summarize the file (PDF, Word, HTML, text, spreadsheet)'
      _cmd 'lm doc <file> "q"'      'answer a question from the file'
      _note 'It says how much of the file it read. More options: q -h' ;;
    again)
      _cmd 'lm again'               'your last question, one step stronger (small, then big); the web only when you ask for it'
      _cmd 'lm again --big|--code|--web' 'pick the lane (--web sends the question off this Mac)' ;;
    fast)
      _cmd 'lm fast [1h]'           'keep the small model loaded so q answers instantly (default 1h)'
      _cmd 'lm fast off'            'unload it now and free the memory' ;;
    more)
      _cmd 'lm more'                'the full command list' ;;
  esac
}

# A question typed straight after lm: route it through q (paths, typos and "gemini ..." are handled there).
ask_q() { exec "$BIN/q" --route "$@"; }

verb="${1:-}"
case "$verb" in
  '')        front_door ;;
  -h|--help) front_door ;;
  more)      shift; if wants_help "$@"; then verb_help more; else overview; fi ;;
  help)      shift; if wants_help "$@"; then verb_help help; else help_job "${1:-}"; fi ;;
  ask)       shift; [ $# -gt 0 ] || { verb_help cmd >&2; exit 2; }; ask_q "$@" ;;
  cmd)       shift; if wants_help "$@" || [ $# -eq 0 ]; then verb_help cmd; [ $# -gt 0 ] || exit 2; exit 0; fi; exec "$BIN/q" cmd "$@" ;;
  read)      shift; if wants_help "$@" || [ $# -eq 0 ]; then verb_help read; [ $# -gt 0 ] || exit 2; exit 0; fi; exec "$BIN/see" "$@" ;;
  diff)      shift; if wants_help "$@" || [ $# -lt 2 ]; then verb_help diff; [ $# -gt 0 ] || exit 2; wants_help "$@" && exit 0; exit 2; fi; exec "$BIN/see" diff "$@" ;;
  doc)       shift
             if wants_help "$@" || [ $# -eq 0 ]; then verb_help doc; [ $# -gt 0 ] || exit 2; exit 0; fi
             docf="$(expand_tilde "$1")"; shift
             if [ $# -gt 0 ]; then exec "$BIN/q" qa --ctx "$docf" "$@"; else exec "$BIN/q" summarize --ctx "$docf"; fi ;;
  again)     shift; if wants_help "$@"; then verb_help again; exit 0; fi; exec "$BIN/q" again "$@" ;;
  find)      shift; lm_find "$@" ;;
  fast)      shift
             if wants_help "$@"; then verb_help fast; exit 0; fi
             case "${1:-1h}" in
               off) exec "$BIN/warm" off ;;
               *)   exec "$BIN/warm" on "${1:-1h}" ;;
             esac ;;
  q)        shift; exec "$BIN/q" "$@" ;;
  imagine)  shift; exec "$BIN/imagine" "$@" ;;
  see)      shift; exec "$BIN/see" "$@" ;;
  review)   shift; exec "$BIN/review" "$@" ;;
  probe)    shift; exec "$BIN/probe" "$@" ;;
  fleet)    shift; exec "$DIR/lib/fleet" "$@" ;;
  index)    shift; exec "$DIR/lib/repo-index" "$@" ;;
  gemini)   shift; exec "$DIR/lib/gemini" "$@" ;;
  ui-verify) shift; exec "$DIR/lib/ui-verify" "$@" ;;
  rag)      shift; exec "$DIR/lib/rag" "$@" ;;
  bench)    shift; exec python3 "$DIR/scripts/bench.py" "$@" ;;
  opencode)
    # Run opencode against the local code tier without paying the no-idle tax:
    # lease the model for the session (bounded, self-heals if we die hard),
    # release when opencode exits. NOT exec, the trap must outlive the child.
    shift
    if wants_help "$@"; then help_job opencode; exit 0; fi
    command -v opencode >/dev/null 2>&1 || { echo "lm: opencode not installed (brew install opencode)" >&2; exit 12; }
    "$BIN/warm" on code "${LM_OPENCODE_LEASE:-4h}" >&2
    trap '"$BIN/warm" off code >/dev/null 2>&1 || true' EXIT INT TERM
    # Sessions log like everything else here (histories are the API): this was
    # the one tool in the suite whose usage was invisible to the self-audit.
    _oc_t0=$(date +%s)
    set +e; opencode "$@"; _oc_rc=$?; set -e
    jq -cn --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg caller "$PWD" \
      --argjson secs "$(( $(date +%s) - _oc_t0 ))" --argjson rc "$_oc_rc" \
      '{ts:$ts, caller:$caller, secs:$secs, rc:$rc}' >> "$DIR/logs/opencode-history.jsonl" 2>/dev/null || true
    exit "$_oc_rc"
    ;;
  warm)     shift; exec "$BIN/warm" "$@" ;;
  status)   shift; if wants_help "$@"; then verb_help status; exit 0; fi
            jf="$(json_only "lm status" "$@")" || exit 2
            if [ -n "$jf" ]; then lm_status_json; else lm_status; fi ;;
  models|doctor)
            shift; if wants_help "$@"; then verb_help "$verb"; exit 0; fi
            jf="$(json_only "lm $verb" "$@")" || exit 2
            "lm_$verb" "$jf" ;;
  timeline) shift; lm_timeline "$@" ;;
  last)     shift; lm_last "$@" ;;
  examples) shift; if wants_help "$@"; then verb_help examples; exit 0; fi; examples_table ;;
  --version|-V|version) echo "lm ${LM_VERSION:-unknown}" ;;
  *) # Several words, or one with spaces, is a question typed straight after lm.
     if [ $# -gt 1 ] || [[ "$verb" == *" "* ]]; then ask_q "$@"; fi
     g="$(did_you_mean "$verb" more help ask cmd read diff doc again find fast q imagine see review probe fleet index gemini ui-verify rag bench opencode warm status models doctor timeline last examples version)"
     echo "lm: unknown verb '$verb'${g:+ (did you mean '$g'?)}; run lm for the jobs, or lm \"your question\" to ask" >&2; exit 2 ;;
esac
