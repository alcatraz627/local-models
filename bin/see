#!/usr/bin/env bash
# see — local vision: read an image/screenshot into text with a local VLM.
#
# "The VLM parses, the agent reasons": pipe a picture in, get structured text out
# that Claude (or you) can reason over. All local — the image never leaves the box.
#
#   see screenshot.png                  structured read (text verbatim, UI, layout, anomalies)
#   see chart.png "what's the trend?"   answer a question grounded in the image
#   see dash.png --ui                   UI mode: enumerated elements, layout, hierarchy, icons
#   see ui.png --json                   machine mode: {ok,text,model,ms} for agents/GUIs
set -eo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=/dev/null
source "$DIR/config.sh"
# shellcheck source=/dev/null
source "$DIR/bin/_lib.sh"

# A cold model-load via the ollama API can leave the terminal cursor hidden;
# `see` doesn't emit cursor codes itself, but it guarantees the cursor is shown
# again on exit (any path) so it never leaves the terminal in a bad state.
trap '{ [ -t 1 ] && printf "\033[?25h"; [ -t 2 ] && printf "\033[?25h" >&2; } 2>/dev/null; true' EXIT INT TERM

MODEL="${VISION_MODEL:-gemma4:26b}"
MODEL_SET=false
MODE=text
UI=false
GLOW=false
positionals=()
LOG="$DIR/logs/see-history.jsonl"

show_help() {
  printf '%s%ssee%s %s— read an image into text with a local vision model%s\n' "$Bd" "$C" "$Rs" "$Dm" "$Rs"
  _sec USAGE
  _cmd 'see <image> ["question"]' 'describe an image, or answer a question about it'
  _cmd 'see <image> --ui'         'UI mode: enumerated elements, layout, hierarchy, icons, patterns'
  _cmd 'see <image> --json'       'machine mode: one JSON object for agents/GUIs'
  _cmd 'see history [N] · show N' 'past reads, numbered (default 15) · one full read (-1 = latest)'
  _sec EXAMPLES
  _ex 'see ~/Desktop/shot.png'                 '# verbatim text + UI + layout'
  _ex 'see chart.png "is it trending up?"'     '# grounded answer'
  _ex 'see dashboard.png --ui'                 '# sectioned inventory of a website/app/widget UI'
  _ex 'see menu.png --ui "which item is on?"'  '# UI inventory + a focused answer'
  _ex 'see mockup.png --json'                  '# {ok,text,model,ms} for Claude to read'
  _sec OPTIONS
  _opt '--ui'          'UI-inventory read for screenshots/mocks (KIND/LAYOUT/HIERARCHY/ELEMENTS/ICONS/PATTERNS/PALETTE)'
  _opt '--json'        'one JSON object on stdout, no ANSI'
  _opt '--glow'        'render the read through glow (TTY-only, no-op without glow)'
  _opt '-m, --model M' "vision model (default: \$VISION_MODEL = $MODEL)"
  _opt '-h, --help'    'this help'
  _sec NOTES
  printf '  %slocal-only · the image is never uploaded · model loads on demand, unloads after%s\n' "$Dm" "$Rs"
}

emit_error() { # CODE MESSAGE EXIT
  case "$MODE" in
    json) jq -cn --arg c "$1" --arg m "$2" '{ok:false, code:$c, message:$m}' ;;
    *)    echo "see: $2" >&2 ;;
  esac
  exit "$3"
}

# History subcommands (same numbering contract as q: stable JSONL line numbers).
case "${1:-}" in
  history) jsonl_history "$LOG" "${2:-15}" \
             '"\(.ts[11:19])  \(.model)  \(.ms)ms  \(.img)  \((.prompt // "describe") | gsub("\\s+"; " ") | .[0:40])"'
           exit 0 ;;
  show)    jsonl_entry "$LOG" "${2:-}" \
             '"# see \(.img)  ·  \(.ts)  ·  \(.model)  ·  \(.ms)ms\n\n\(.response)"'
           exit $? ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --json)     MODE=json; shift ;;
    --ui)       UI=true; shift ;;
    --glow)     GLOW=true; shift ;;
    -m|--model) MODEL="$2"; MODEL_SET=true; shift 2 ;;
    -h|--help)  show_help; exit 0 ;;
    *)          positionals+=("$1"); shift ;;
  esac
done

if [ "${#positionals[@]}" -eq 0 ]; then
  [ "$MODE" = text ] && { show_help; exit 0; }
  emit_error invalid_args "no image given" 2
fi
IMG="${positionals[0]}"; QUERY="${positionals[*]:1}"

[ -f "$IMG" ] || emit_error img_unreadable "no such file: $IMG" 12
case "$(file -b --mime-type "$IMG" 2>/dev/null)" in
  image/*) : ;;
  *) emit_error not_an_image "'$IMG' is not an image ($(file -b "$IMG" 2>/dev/null))" 12 ;;
esac

ollama_up || emit_error server_down "ollama server unreachable at $OLLAMA_HOST" 10

# Don't disturb the warm pin / an active lease: keep_alive is last-writer-wins
# per request (the _lib.sh contract every API caller must honor) — resident
# stays resident (-1), cold loads just for this call (0). Matters for --ui
# batches: a `warm on big 30m` lease survives each read instead of being
# evicted by a hardcoded keep_alive:0.
if ollama_resident "$MODEL"; then KEEP=-1; else KEEP=0; fi

if $UI; then
  # The UI-inventory lens — the one specialized mode the vision-lenses review
  # (docs/08, Outcome) sanctioned once a real caller existed. Sections are fixed
  # so downstream agents can parse by heading. Deliberately NO pixel/spacing
  # estimates: the June audit showed even theme reads are unreliable, and
  # requesting measurements invites confident fabrication.
  #
  # The rubric is the USER message, not the system prompt: gemma has no true
  # system role (ollama folds system into the first user turn), and under that
  # fold gemma4:26b deterministically emitted an early stop ~200 tokens in
  # (reproduced twice, 2026-07-08). As a plain user message the same rubric
  # runs to natural completion. Routed to the big tier by default (see
  # config.sh UI_VISION_MODEL) — measured better at structure/state.
  $MODEL_SET || MODEL="${UI_VISION_MODEL:-$MODEL}"
  SYS="You are a precise UI analyst reading a computer-interface screenshot for a downstream agent. Report only what is visibly present."
  USER="Analyze this interface screenshot (website, app window, dashboard, menu-bar widget, dropdown, or mock). Scan systematically before writing: top edge, left edge, main area, right edge, bottom edge — window title bars, filter rows, and status footers all count. Output EXACTLY these seven markdown sections, in order, each heading bare (never copy instruction text into the output):
## KIND
One line: what this interface is and its apparent purpose.
## LAYOUT
Each major region (title bar, header, nav, sidebar, main, panel, footer, overlay…) with its position and rough share of the frame, then the natural reading order.
## HIERARCHY
The visual hierarchy as an indented tree: what dominates, what nests under what, and what creates each level of emphasis (size, weight, color, position).
## ELEMENTS
A numbered enumeration grouped by region, ONE element per line: element type (button, tab, link, input, toggle, chip, card, stat tile, list row, avatar, chart, badge…), its visible text VERBATIM in quotes including any counts or numbers, and visible state (selected, disabled, active, checked…). For long repeated lists, enumerate the first few rows verbatim then summarize the rest with the total count shown on screen.
## ICONS
Each distinct icon or glyph: where it sits, its shape in plain words, and its likely meaning qualified as (likely). Minimal/SVG icons: best-effort shape description; pixel accuracy is not expected.
## PATTERNS
Repeated formatting conventions: e.g. cards: icon + title + big value + delta, or rows: icon / text / badge / percent / age — alignment and grouping rules the design reuses.
## PALETTE
Coarse only: light or dark theme (as a guess), the 3-5 dominant colors in plain words, and the accent color plus what carries it. The caller must verify before citing.
Anti-fabrication (critical): enumerate ONLY what is visibly present. Never pad a section to look complete — a short honest section beats a full invented one. Write [unsure] for anything not clearly legible; never invent an element, value, or state. Before claiming an element is selected or active, check which item actually carries the highlight."
  [ -n "$QUERY" ] && USER="$USER
Additional focus: $QUERY"
elif [ -n "$QUERY" ]; then
  SYS="You are a precise visual assistant. Report only what is actually visible — never fabricate factual specifics (on-screen text, identity, counts, colors); if those aren't legible, say so. But when the user asks for an interpretation, a mood, or a description in a particular style, you MAY go beyond the literal — ground it in what's visible, and do not refuse."
  USER="$QUERY"
else
  SYS="You are a precise visual parser for a downstream agent. First note what the image IS (UI/dashboard/document/chart/photo/artwork/AI-generated). Then: (1) transcribe ALL legible text VERBATIM and exactly — labels, values, code, messages — as a list, BEFORE any description; (2) report layout/structure and the detail that matters for the kind (dense UI → values + control states; charts → data/trends; photo/art → subject, composition, palette, mood). Anti-fabrication (critical): report ONLY what is visibly present — write [unsure] for anything not clearly legible; never invent an element, value, or control; and do NOT assign meanings to colors unless a visible legend defines them (describe a color as a color). This is a structural read; exact strings should be verified, not trusted blindly."
  USER="Describe this image."
fi

# Build + send the request in Python: a real image's base64 is megabytes, which
# exceeds ARG_MAX if passed via `jq --arg`. The image stays local — it's sent only
# to 127.0.0.1 ollama, never uploaded.
# num_ctx 8192: image tiles + the sectioned UI prompt overflow the 4096 default
# of some models and the read silently truncates mid-generation (observed on
# gemma4:26b 2026-07-08); num_predict -1 lifts any Modelfile output cap.
# (Keep apostrophes out of the PY block below — bash 3.2 misparses quotes in
# heredocs inside $(...).)
t0=$(python3 -c 'import time; print(int(time.time()*1000))')
set +e
TEXT="$(python3 - "$MODEL" "$SYS" "$USER" "$IMG" "$OLLAMA_HOST" "$KEEP" 2>&1 <<'PY'
import sys, json, base64, urllib.request, urllib.error
model, sysp, user, img, host, keep = sys.argv[1:7]
try:
    with open(img, "rb") as f:
        b64 = base64.b64encode(f.read()).decode()
    body = json.dumps({"model": model, "stream": False, "keep_alive": int(keep), "think": False,
                       "options": {"temperature": 0, "num_ctx": 8192, "num_predict": -1},
                       "messages": [{"role": "system", "content": sysp},
                                    {"role": "user", "content": user, "images": [b64]}]}).encode()
    req = urllib.request.Request(host.rstrip("/") + "/api/chat", data=body,
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=180) as r:
        sys.stdout.write(json.load(r).get("message", {}).get("content", "").strip())
except urllib.error.HTTPError as e:
    try: m = json.load(e).get("error", "HTTP %s" % e.code)
    except Exception: m = "HTTP %s" % e.code
    sys.stderr.write(m)
    sys.exit(11 if ("not found" in m.lower() or "no such model" in m.lower()) else 10)
except OSError as e:
    sys.stderr.write("server unreachable / lost mid-request (%s)" % e); sys.exit(10)
PY
)"; rc=$?
set -e
if [ "$rc" -ne 0 ]; then
  [ "$rc" -eq 11 ] && emit_error model_missing "vision model '$MODEL' not installed — pull it: ollama pull $MODEL" 11
  emit_error model_error "${TEXT:-vision request failed}" 10
fi
[ -n "$TEXT" ] || emit_error model_error "no content from the model" 10
# Guard the end-timestamp: an interrupted run must not feed a blank/garbage value
# into the arithmetic (which then poisoned the old awk stats line).
end=$(python3 -c 'import time; print(int(time.time()*1000))' 2>/dev/null || echo "$t0")
[[ "$end" =~ ^[0-9]+$ ]] || end="$t0"
ms=$(( end - t0 ))

# History is best-effort — never break the answer on a log failure.
READ_MODE=general; if $UI; then READ_MODE=ui; fi
mkdir -p "$DIR/logs"
jq -cn --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg img "$IMG" --arg p "$QUERY" \
   --arg m "$MODEL" --argjson ms "$ms" --arg r "$TEXT" --arg rm "$READ_MODE" \
   '{ts:$ts, img:$img, prompt:(if $p == "" then null else $p end), mode:$rm, model:$m, ms:$ms, response:$r}' \
   >> "$LOG" 2>/dev/null || true

if [ "$MODE" = json ]; then
  jq -cn --arg t "$TEXT" --arg m "$MODEL" --argjson ms "$ms" '{ok:true, text:$t, model:$m, ms:$ms}'
else
  if $GLOW && [ -t 1 ] && command -v glow >/dev/null 2>&1; then
    printf '%s\n' "$TEXT" | glow -
  else
    printf '%s\n' "$TEXT"
  fi
  # Integer ms, no awk — robust even on an interrupted run. The TTY guard must
  # not become the exit code (non-TTY text-mode success would exit 1).
  [ -t 2 ] && printf '%s· %s · %dms%s\n' "$Dm" "$MODEL" "$ms" "$Rs" >&2
fi
exit 0
